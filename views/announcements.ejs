<%- include('partials/header') %>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-bullhorn"></i> Announcements</h1>
    </div>
</div>

<!-- Parent Announcement Composer -->
<div class="card" style="margin-bottom:1rem;">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
        <div>
            <h3 style="margin:0;"><i class="fa-solid fa-bullhorn"></i> Parent Announcements</h3>
            <p class="text-muted" style="margin:.25rem 0 0;">Send meeting notices, reminders, holidays, events, or emergency alerts to parent mobile apps.</p>
        </div>
        <span class="badge badge-active" id="announcementSentCount">Ready</span>
    </div>
    <form id="announcementForm" style="display:grid;gap:12px;margin-top:1rem;">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
            <div class="form-group">
                <label>Announcement Type</label>
                <select id="annType" name="type" class="form-control">
                    <option value="announcement_general">General Announcement</option>
                    <option value="announcement_parent_meeting">Parent Meeting</option>
                    <option value="announcement_class_meeting">Class Meeting</option>
                    <option value="announcement_holiday">Holiday / No Classes</option>
                    <option value="announcement_school_event">School Event</option>
                    <option value="announcement_emergency">Emergency Announcement</option>
                    <option value="announcement_reminder">Reminder</option>
                </select>
            </div>
            <div class="form-group">
                <label>Target Audience</label>
                <select id="annAudience" name="target_audience" class="form-control">
                    <option value="school">All parents in the school</option>
                    <option value="grade">Parents by grade level</option>
                    <option value="section">Parents by section</option>
                    <option value="student">Parents of one student</option>
                </select>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
            <div class="form-group">
                <label>School</label>
                <select id="annSchool" name="school_id" class="form-control">
                    <option value="">All / My School</option>
                </select>
            </div>
            <div class="form-group">
                <label>Grade Level</label>
                <select id="annGrade" name="grade_level_id" class="form-control">
                    <option value="">Any grade</option>
                </select>
            </div>
            <div class="form-group">
                <label>Section</label>
                <select id="annSection" name="section_id" class="form-control">
                    <option value="">Any section</option>
                </select>
            </div>
            <div class="form-group" id="annStudentWrap" style="display:none;">
                <label>Student ID</label>
                <input id="annStudent" name="student_id" class="form-control" placeholder="Student ID">
            </div>
        </div>
        <div class="form-group">
            <label>Title</label>
            <input id="annTitle" name="title" class="form-control" maxlength="255" placeholder="Example: Parent Meeting" required>
        </div>
        <div class="form-group">
            <label>Message / Content</label>
            <textarea id="annMessage" name="message" class="form-control" rows="4" placeholder="Write the full parent announcement here..." required></textarea>
        </div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> Send Announcement</button>
            <span id="announcementStatus" class="text-muted"></span>
        </div>
    </form>
</div>

<!-- Recent Parent Notices -->
<div class="card" style="margin-bottom:1rem;">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
        <h3 style="margin:0;"><i class="fa-solid fa-list-check"></i> Recent Parent Notices</h3>
        <button type="button" id="announcementsToggle" class="btn btn-sm btn-outline" style="display:none;" onclick="toggleAnnouncements()">View all</button>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Title</th>
                    <th>Target</th>
                    <th>Created By</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="announcementRows">
                <tr><td colspan="6" class="text-center text-muted">Loading announcements...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script>
var CURRENT_USER = {
    id: '<%= user && user.id ? user.id : "" %>',
    role: '<%= user ? user.role : "" %>',
    school_id: '<%= user && user.school_id ? user.school_id : "" %>'
};
function canManageAnnouncement(row) {
    if (CURRENT_USER.role === 'super_admin') return true;
    if (CURRENT_USER.role === 'principal') return CURRENT_USER.school_id && String(row.school_id) === String(CURRENT_USER.school_id);
    if (CURRENT_USER.role === 'adviser') return String(row.created_by) === String(CURRENT_USER.id);
    return false;
}
function escapeHtml(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}
function announcementTypeLabel(type) {
    var labels = {
        announcement_general: 'General',
        announcement_parent_meeting: 'Parent Meeting',
        announcement_class_meeting: 'Class Meeting',
        announcement_holiday: 'Holiday / No Classes',
        announcement_school_event: 'School Event',
        announcement_emergency: 'Emergency',
        announcement_reminder: 'Reminder'
    };
    return labels[type] || String(type || 'Announcement').replace(/_/g, ' ');
}
function targetLabel(row) {
    if (row.student_id) return 'Student #' + row.student_id;
    if (row.section_name) return (row.grade_name ? row.grade_name + ' / ' : '') + row.section_name;
    if (row.grade_name) return row.grade_name;
    if (row.school_name) return row.school_name;
    return 'All parents';
}
var annScope = null;
function applyAnnouncementScope() {
    if (!annScope) return;
    var role = annScope.role;
    var schoolEl = document.getElementById('annSchool');
    var sectionEl = document.getElementById('annSection');
    var audienceEl = document.getElementById('annAudience');
    var schoolGroup = schoolEl.closest('.form-group');
    var gradeGroup = document.getElementById('annGrade').closest('.form-group');
    if (annScope.lock_school && annScope.school) {
        schoolEl.innerHTML = '<option value="' + escapeHtml(annScope.school.id) + '">' + escapeHtml(annScope.school.name) + '</option>';
        schoolEl.value = String(annScope.school.id);
        schoolEl.disabled = true;
    }
    if (role === 'adviser') {
        audienceEl.innerHTML = '<option value="section">All parents in my section</option>'
            + '<option value="student">One student in my section</option>';
        audienceEl.value = 'section';
        if (annScope.lock_section && annScope.section) {
            sectionEl.innerHTML = '<option value="' + escapeHtml(annScope.section.id) + '">' + escapeHtml(annScope.section.name) + '</option>';
            sectionEl.value = String(annScope.section.id);
            sectionEl.disabled = true;
        }
        if (schoolGroup) schoolGroup.style.display = 'none';
        if (gradeGroup) gradeGroup.style.display = 'none';
    }
}
async function populateAnnouncementFilters() {
    try {
        annScope = await (await fetch('/api/notifications/scope')).json();
    } catch(e) { annScope = { role: '<%= user ? user.role : "" %>' }; }
    if (!(annScope && annScope.lock_school && annScope.school)) {
        try {
            var schools = await (await fetch('/api/schools')).json();
            var schoolEl = document.getElementById('annSchool');
            if (Array.isArray(schools)) {
                schoolEl.innerHTML = '<option value="">All / My School</option>' + schools.map(function(s){
                    return '<option value="' + escapeHtml(s.id) + '">' + escapeHtml(s.name) + '</option>';
                }).join('');
            }
        } catch(e) {}
    }
    applyAnnouncementScope();
    await loadGradesAndSections();
    updateAnnouncementAudience();
}
async function loadGradesAndSections() {
    var schoolId = document.getElementById('annSchool').value;
    try {
        var grades = await (await fetch('/api/grade-levels')).json();
        var filteredGrades = Array.isArray(grades) ? grades.filter(function(g){ return !schoolId || String(g.school_id) === String(schoolId); }) : [];
        document.getElementById('annGrade').innerHTML = '<option value="">Any grade</option>' + filteredGrades.map(function(g){
            return '<option value="' + escapeHtml(g.id) + '">' + escapeHtml(g.name) + '</option>';
        }).join('');
    } catch(e) {}
    await loadSections();
}
async function loadSections() {
    if (annScope && annScope.lock_section) return;
    var schoolId = document.getElementById('annSchool').value;
    var gradeId = document.getElementById('annGrade').value;
    var url = '/api/sections?' + new URLSearchParams({
        school_id: schoolId || '',
        grade_level_id: gradeId || ''
    }).toString();
    try {
        var sections = await (await fetch(url)).json();
        document.getElementById('annSection').innerHTML = '<option value="">Any section</option>' + (Array.isArray(sections) ? sections : []).map(function(sec){
            return '<option value="' + escapeHtml(sec.id) + '">' + escapeHtml((sec.grade_name ? sec.grade_name + ' - ' : '') + sec.name) + '</option>';
        }).join('');
    } catch(e) {}
}
function updateAnnouncementAudience() {
    var audience = document.getElementById('annAudience').value;
    var isAdviser = annScope && annScope.role === 'adviser';
    var gradeGroup = document.getElementById('annGrade').closest('.form-group');
    var sectionGroup = document.getElementById('annSection').closest('.form-group');
    document.getElementById('annStudentWrap').style.display = audience === 'student' ? '' : 'none';
    if (isAdviser) {
        if (gradeGroup) gradeGroup.style.display = 'none';
        if (sectionGroup) sectionGroup.style.display = '';
        return;
    }
    if (gradeGroup) gradeGroup.style.display = (audience === 'grade' || audience === 'section' || audience === 'student') ? '' : 'none';
    if (sectionGroup) sectionGroup.style.display = (audience === 'section' || audience === 'student') ? '' : 'none';
}
var MAX_TABLE_ROWS = 6;
var announcementsData = [];
var announcementsExpanded = false;
function announcementRowHtml(row) {
    var actions = canManageAnnouncement(row)
        ? '<div style="display:flex;gap:6px;flex-wrap:wrap;">'
            + '<button type="button" class="btn btn-sm btn-outline" onclick="editAnnouncement(' + Number(row.id) + ')">Edit</button>'
            + '<button type="button" class="btn btn-sm btn-danger" onclick="deleteAnnouncement(' + Number(row.id) + ')">Delete</button></div>'
        : '<span class="text-muted">—</span>';
    return '<tr>'
        + '<td><span class="badge badge-active">' + escapeHtml(announcementTypeLabel(row.type)) + '</span></td>'
        + '<td><strong>' + escapeHtml(row.title || '-') + '</strong><div class="text-muted" style="font-size:.75rem;">' + escapeHtml(row.message || '') + '</div></td>'
        + '<td>' + escapeHtml(targetLabel(row)) + '</td>'
        + '<td>' + escapeHtml(row.created_by_name || row.created_by_role || 'System') + '</td>'
        + '<td>' + escapeHtml(row.created_at ? new Date(row.created_at).toLocaleString() : '-') + '</td>'
        + '<td>' + actions + '</td>'
        + '</tr>';
}
function renderTable(body, toggle, data, expanded, rowHtml, animate) {
    if (!body) return;
    var cols = 5;
    var tbl = body.closest('table');
    if (tbl) { var th = tbl.querySelectorAll('thead th'); if (th.length) cols = th.length; }
    if (!data.length) {
        body.innerHTML = '<tr><td colspan="' + cols + '" class="text-center text-muted">No records found.</td></tr>';
        if (toggle) toggle.style.display = 'none';
        return;
    }
    var list = expanded ? data : data.slice(0, MAX_TABLE_ROWS);
    body.innerHTML = list.map(rowHtml).join('');
    if (animate && expanded) {
        var rows = body.querySelectorAll('tr');
        for (var i = MAX_TABLE_ROWS; i < rows.length; i++) {
            rows[i].style.animation = 'annRowReveal .34s ease both';
            rows[i].style.animationDelay = ((i - MAX_TABLE_ROWS) * 40) + 'ms';
        }
    }
    if (toggle) {
        if (data.length > MAX_TABLE_ROWS) {
            toggle.style.display = '';
            toggle.textContent = expanded ? 'Show less' : ('View all (' + data.length + ')');
        } else {
            toggle.style.display = 'none';
        }
    }
}
function renderAnnouncements(animate) {
    renderTable(document.getElementById('announcementRows'), document.getElementById('announcementsToggle'),
        announcementsData, announcementsExpanded, announcementRowHtml, animate);
}
function toggleAnnouncements() { announcementsExpanded = !announcementsExpanded; renderAnnouncements(announcementsExpanded); }
async function loadAnnouncementRows() {
    try {
        var rows = await (await fetch('/api/notifications')).json();
        announcementsData = Array.isArray(rows) ? rows : [];
        renderAnnouncements();
    } catch(e) {
        var el = document.getElementById('announcementRows');
        if (el) el.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Failed to load announcements.</td></tr>';
    }
}
async function sendAnnouncement(event) {
    event.preventDefault();
    var status = document.getElementById('announcementStatus');
    status.textContent = 'Sending...';
    var form = document.getElementById('announcementForm');
    var data = Object.fromEntries(new FormData(form).entries());
    if (data.target_audience === 'school') {
        data.grade_level_id = '';
        data.section_id = '';
        data.student_id = '';
    } else if (data.target_audience === 'grade') {
        data.section_id = '';
        data.student_id = '';
    } else if (data.target_audience === 'section') {
        data.student_id = '';
    }
    try {
        var res = await fetch('/api/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        var json = await res.json();
        if (!res.ok || json.error) throw new Error(json.error || 'Failed to send announcement.');
        var count = json.sent_to_parents || 0;
        status.textContent = 'Sent to ' + count + ' parent account(s).';
        var sentBadge = document.getElementById('announcementSentCount');
        if (sentBadge) sentBadge.textContent = 'Sent';
        form.reset();
        updateAnnouncementAudience();
        await loadAnnouncementRows();
        showAnnSentModal(count);
    } catch(e) {
        status.textContent = e.message || 'Failed to send announcement.';
    }
}
function showAnnSentModal(count) {
    var modal = document.getElementById('annSentModal');
    var text = document.getElementById('annSentModalText');
    if (text) text.textContent = 'Your announcement was delivered to ' + count + ' parent account' + (count === 1 ? '' : 's') + '.';
    if (modal) modal.style.display = 'flex';
}
function closeAnnSentModal() {
    var modal = document.getElementById('annSentModal');
    if (modal) modal.style.display = 'none';
}
var editingAnnId = null;
function editAnnouncement(id) {
    var row = announcementsData.filter(function(r){ return String(r.id) === String(id); })[0];
    if (!row) return;
    editingAnnId = id;
    document.getElementById('editAnnType').value = row.type || 'announcement_general';
    document.getElementById('editAnnTitle').value = row.title || '';
    document.getElementById('editAnnMessage').value = row.message || '';
    document.getElementById('editAnnError').textContent = '';
    document.getElementById('editAnnModal').style.display = 'flex';
}
function closeEditAnnModal() {
    document.getElementById('editAnnModal').style.display = 'none';
    editingAnnId = null;
}
async function submitEditAnnouncement() {
    if (!editingAnnId) return;
    var title = document.getElementById('editAnnTitle').value.trim();
    var message = document.getElementById('editAnnMessage').value.trim();
    var type = document.getElementById('editAnnType').value;
    var errEl = document.getElementById('editAnnError');
    var btn = document.getElementById('editAnnSaveBtn');
    if (!title || !message) { errEl.textContent = 'Title and message are required.'; return; }
    errEl.textContent = '';
    btn.disabled = true;
    try {
        var res = await fetch('/api/notifications/' + editingAnnId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title: title, message: message, type: type })
        });
        var json = await res.json();
        if (!res.ok || json.error) throw new Error(json.error || 'Failed to update announcement.');
        closeEditAnnModal();
        await loadAnnouncementRows();
    } catch(e) {
        errEl.textContent = e.message || 'Failed to update announcement.';
    } finally {
        btn.disabled = false;
    }
}
async function deleteAnnouncement(id) {
    if (!confirm('Delete this announcement? It will also be removed from the parents\' notifications.')) return;
    try {
        var res = await fetch('/api/notifications/' + id, { method: 'DELETE' });
        var json = await res.json();
        if (!res.ok || json.error) throw new Error(json.error || 'Failed to delete.');
        await loadAnnouncementRows();
    } catch(e) {
        alert(e.message || 'Failed to delete announcement.');
    }
}
(function(){ ['annSentModal','editAnnModal'].forEach(function(idv){ var m = document.getElementById(idv); if (m && m.parentNode !== document.body) document.body.appendChild(m); }); })();
populateAnnouncementFilters();
loadAnnouncementRows();
document.getElementById('announcementForm').addEventListener('submit', sendAnnouncement);
document.getElementById('annAudience').addEventListener('change', updateAnnouncementAudience);
document.getElementById('annSchool').addEventListener('change', loadGradesAndSections);
document.getElementById('annGrade').addEventListener('change', loadSections);
setInterval(loadAnnouncementRows, 30000);
</script>

<!-- Announcement sent confirmation modal -->
<div id="annSentModal" style="display:none;position:fixed;inset:0;z-index:100000;background:rgba(15,23,42,.55);align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)closeAnnSentModal()">
    <div style="background:#fff;border-radius:18px;max-width:420px;width:100%;padding:30px 26px;text-align:center;box-shadow:0 24px 60px rgba(0,0,0,.28);">
        <div style="width:66px;height:66px;border-radius:50%;background:var(--primary-bg,#dcfce7);color:var(--success,#16a34a);display:flex;align-items:center;justify-content:center;font-size:34px;margin:0 auto 16px;">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3 style="margin:0 0 6px;font-size:1.25rem;color:var(--gray-800,#1f2937);">Announcement Sent</h3>
        <p id="annSentModalText" style="margin:0 0 20px;color:var(--gray-500,#6b7280);font-size:.92rem;line-height:1.5;">Your announcement was delivered to parents.</p>
        <button type="button" class="btn btn-primary" style="min-width:130px;" onclick="closeAnnSentModal()">OK</button>
    </div>
</div>

<!-- Edit announcement modal -->
<div id="editAnnModal" style="display:none;position:fixed;inset:0;z-index:100000;background:rgba(15,23,42,.55);align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)closeEditAnnModal()">
    <div style="background:#fff;border-radius:18px;max-width:520px;width:100%;padding:24px;box-shadow:0 24px 60px rgba(0,0,0,.28);max-height:90vh;overflow:auto;">
        <h3 style="margin:0 0 14px;font-size:1.2rem;color:var(--gray-800,#1f2937);"><i class="fa-solid fa-pen-to-square"></i> Edit Announcement</h3>
        <div id="editAnnError" style="color:#dc2626;font-size:.85rem;margin-bottom:8px;"></div>
        <div class="form-group" style="margin-bottom:12px;">
            <label>Announcement Type</label>
            <select id="editAnnType" class="form-control">
                <option value="announcement_general">General Announcement</option>
                <option value="announcement_parent_meeting">Parent Meeting</option>
                <option value="announcement_class_meeting">Class Meeting</option>
                <option value="announcement_holiday">Holiday / No Classes</option>
                <option value="announcement_school_event">School Event</option>
                <option value="announcement_emergency">Emergency Announcement</option>
                <option value="announcement_reminder">Reminder</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom:12px;">
            <label>Title</label>
            <input id="editAnnTitle" class="form-control" maxlength="255">
        </div>
        <div class="form-group" style="margin-bottom:16px;">
            <label>Message / Content</label>
            <textarea id="editAnnMessage" class="form-control" rows="4"></textarea>
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap;">
            <button type="button" class="btn btn-secondary" onclick="closeEditAnnModal()">Cancel</button>
            <button type="button" id="editAnnSaveBtn" class="btn btn-primary" onclick="submitEditAnnouncement()">Save Changes</button>
        </div>
    </div>
</div>

<style>
@keyframes annRowReveal { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
</style>

<div class="live-indicator"><div class="live-dot"></div> Live</div>
<%- include('partials/footer') %>
