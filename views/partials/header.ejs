<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#4f46e5">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title><%= title %> — <%= (settings && settings.system_name) || 'EduTrack' %></title>
    <link rel="icon" type="image/png" href="/uploads/logos/system-logo.png" id="favicon">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/uploads/logos/system-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/style.css?v=topbar-school-20260617">
    <script src="/js/status-labels.js"></script>
</head>
<body>
    <% if (typeof user !== 'undefined' && user) { %>
    <nav class="sidebar<%= (typeof user !== 'undefined' && user && (user.role === 'adviser' || user.role === 'principal')) ? ' sidebar-blue' : '' %>" id="sidebar">
        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="brand-icon" id="sidebarLogo">
                <% if (settings && settings.system_logo) { %>
                <img src="<%= settings.system_logo %>" alt="Logo" onerror="this.parentElement.innerHTML='<i class=\'fa-solid fa-school\'></i>'">
                <% } else { %>
                <i class="fa-solid fa-qrcode"></i>
                <% } %>
            </div>
            <div class="brand-text">
                <span class="brand-title"><%= (settings && settings.system_name) || 'EduTrack' %></span>
                <span class="brand-subtitle"><%= (settings && settings.division_name) || 'School Division' %></span>
            </div>
            <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('collapsed')">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>

        <!-- Nav Links -->
        <ul class="nav-links">
            <li class="nav-section"><span class="nav-section-label">Overview</span></li>
            <li>
                <a href="<%= user.role === 'principal' ? '/admin/principal-dashboard' : user.role === 'superintendent' ? '/admin/sds-dashboard' : user.role === 'asst_superintendent' ? '/admin/asds-dashboard' : user.role === 'adviser' ? '/admin/adviser-dashboard' : '/admin/dashboard' %>"
                   class="<%= ['dashboard','principal_dashboard','sds_dashboard','asds_dashboard','adviser_dashboard'].includes(page) ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-chart-pie"></i> Dashboard
                </a>
            </li>
            <% if (user.role === 'super_admin') { %>
            <li>
                <a href="/admin/schools" class="<%= page === 'schools' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-building-columns"></i> Schools
                </a>
            </li>
            <% } %>

            <% if (user.role !== 'superintendent' && user.role !== 'asst_superintendent' && user.role !== 'adviser') { %>
            <li class="nav-section"><span class="nav-section-label">Management</span></li>
            <% if (user.role === 'super_admin') { %>
            <li>
                <a href="/admin/manage-schools" class="<%= page === 'manage_schools' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-school-circle-check"></i> Manage Schools
                </a>
            </li>
            <% } %>
            <li>
                <a href="/admin/students" class="<%= page === 'students' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-graduation-cap"></i> Students
                </a>
            </li>
            <li>
                <a href="/admin/shs-students" class="<%= page === 'shs_students' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-user-graduate"></i> SHS Students
                </a>
            </li>
            <li>
                <a href="/admin/teachers" class="<%= page === 'teachers' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-chalkboard-user"></i> Teachers
                </a>
            </li>
            <li>
                <a href="/admin/sections" class="<%= page === 'sections' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-layer-group"></i> Sections
                </a>
            </li>
            <% if (user.role === 'super_admin') { %>
            <li>
                <a href="/admin/bulk-import" class="<%= page === 'bulk_import' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-file-arrow-up"></i> Bulk Import
                </a>
            </li>
            <% } %>
            <li>
                <a href="/admin/print-qr" class="<%= page === 'print_qr' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-qrcode"></i> Print QR Codes
                </a>
            </li>
            <% } %>

            <li class="nav-section"><span class="nav-section-label">Attendance</span></li>
            <li>
                <a href="/admin/attendance" class="<%= page === 'attendance' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-clipboard-list"></i> Attendance
                </a>
            </li>
            <% if (user.role !== 'adviser') { %>
            <li>
                <a href="/admin/reports" class="<%= page === 'reports' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-chart-bar"></i> Reports
                </a>
            </li>
            <% } %>

            <% if (user.role === 'adviser') { %>
            <li>
                <a href="/admin/sf2-report" class="<%= page === 'sf2_report' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-file-lines"></i> SF2 Report
                </a>
            </li>
            <li class="nav-section"><span class="nav-section-label">Students</span></li>
            <li>
                <a href="/admin/adviser-students" class="<%= page === 'adviser_students' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-users"></i> Student List
                </a>
            </li>
            <li>
                <a href="/admin/adviser-import-students" class="<%= page === 'adviser_student_import' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-file-arrow-up"></i> Import Students
                </a>
            </li>
            <li class="nav-section"><span class="nav-section-label">Tools</span></li>
            <li>
                <a href="/admin/print-qr" class="<%= page === 'print_qr' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-qrcode"></i> Print QR Codes
                </a>
            </li>
            <% } %>

            <% if (user.role !== 'adviser') { %>
            <li class="nav-section"><span class="nav-section-label">Communication</span></li>
            <li>
                <a href="/admin/notifications" class="<%= page === 'notifications' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-bell"></i> Notifications
                </a>
            </li>
            <% if (user.role === 'super_admin') { %>
            <li>
                <a href="/admin/events" class="<%= page === 'events' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-calendar-days"></i> Events
                </a>
            </li>
            <% } %>

            <li class="nav-section"><span class="nav-section-label">System</span></li>
            <% if (user.role === 'super_admin') { %>
            <li>
                <a href="/admin/settings" class="<%= page === 'settings' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-gear"></i> Settings
                </a>
            </li>
            <li>
                <a href="/admin/backups" class="<%= page === 'backups' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-database"></i> Backups
                </a>
            </li>
            <% } %>
            <% if (user.role !== 'superintendent' && user.role !== 'asst_superintendent' && user.role !== 'principal') { %>
            <li>
                <a href="/admin/scanner" class="<%= page === 'scanner' ? 'active' : '' %>">
                    <i class="nav-icon fa-solid fa-camera"></i> QR Scanner
                </a>
            </li>
            <% } %>
            <% } %>
        </ul>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            <div class="user-info" style="cursor:pointer;" onclick="openAdviserProfileModal('profile')" title="View / edit profile">
                <div class="user-avatar" id="sidebarAvatar"><%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %></div>
                <div class="user-details">
                    <strong><%= user.fullname %></strong>
                    <small><%= user.role === 'adviser' ? 'Adviser' : user.role.replace(/_/g, ' ') %></small>
                </div>
            </div>
            <div class="sidebar-footer-links">
                <a href="#" onclick="openAdviserProfileModal('password');return false;"><i class="fa-solid fa-key"></i> Password</a>
                <a href="/logout" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
        </div>
    </nav>

    <% if (typeof user !== 'undefined' && user) { %>
    <!-- Account Profile Modal -->
    <div id="adviserProfileModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.5);align-items:center;justify-content:center;padding:1rem;">
        <div style="background:#fff;border-radius:14px;width:min(98vw,460px);max-height:92vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.3);">

            <!-- Modal header -->
            <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid #e5e7eb;background:#f9fafb;border-radius:14px 14px 0 0;">
                <span id="pmModalTitle" style="font-weight:700;font-size:1rem;color:#111;"></span>
                <button onclick="closeAdviserProfileModal()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:#9ca3af;padding:4px 6px;border-radius:6px;line-height:1;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- PROFILE PANEL -->
            <div id="pmProfilePanel" style="display:none;flex-direction:column;align-items:center;gap:.9rem;padding:1.4rem;">
                <!-- Avatar -->
                <div style="position:relative;width:90px;height:90px;cursor:pointer;flex-shrink:0;" onclick="document.getElementById('pmPhotoInput').click()" title="Click to change photo">
                    <div id="pmAvatarInner" style="width:90px;height:90px;border-radius:50%;background:var(--primary,#059669);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:700;color:#fff;border:3px solid var(--primary,#059669);overflow:hidden;">
                        <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'T' %>
                    </div>
                    <div style="position:absolute;bottom:2px;right:2px;background:var(--primary,#059669);width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid #fff;">
                        <i class="fa-solid fa-camera" style="color:#fff;font-size:.65rem;"></i>
                    </div>
                </div>
                <input type="file" id="pmPhotoInput" accept="image/*" style="display:none;" onchange="pmUploadPhoto(this)">
                <div id="pmPhotoMsg" style="font-size:.78rem;display:none;text-align:center;"></div>

                <!-- Alert -->
                <div id="pmProfileAlert" style="display:none;width:100%;padding:.6rem .85rem;border-radius:8px;font-size:.84rem;"></div>

                <!-- Editable fields -->
                <div style="width:100%;display:flex;flex-direction:column;gap:.7rem;">
                    <div>
                        <label style="font-size:.76rem;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:3px;">Name</label>
                        <input type="text" id="pmFullNameInput" class="form-control" placeholder="Full name" value="<%= user && user.fullname ? user.fullname : '' %>">
                    </div>
                    <div>
                        <label style="font-size:.76rem;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:3px;">Email</label>
                        <input type="email" id="pmEmail" class="form-control" placeholder="Email address">
                    </div>
                    <div>
                        <label style="font-size:.76rem;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:3px;">Contact Number</label>
                        <input type="text" id="pmContact" class="form-control" placeholder="Contact number">
                    </div>
                </div>

                <button class="btn btn-primary" onclick="pmSaveProfile()" id="pmProfileSaveBtn" style="width:100%;margin-top:.2rem;">
                    <i class="fa-solid fa-floppy-disk"></i> Save Profile
                </button>
            </div>

            <!-- PASSWORD PANEL -->
            <div id="pmPasswordPanel" style="display:none;padding:1.25rem;">
                <div style="margin-bottom:1.1rem;padding:.7rem 1rem;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
                    <div style="font-size:.72rem;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px;">Signed in as</div>
                    <div style="font-size:.95rem;font-weight:700;color:#111;"><%= user.fullname %></div>
                </div>
                <div id="pmPwAlert" style="display:none;padding:.6rem .85rem;border-radius:8px;margin-bottom:.85rem;font-size:.85rem;"></div>
                <div style="margin-bottom:.8rem;">
                    <label style="font-size:.82rem;font-weight:600;color:#374151;display:block;margin-bottom:4px;">Current Password</label>
                    <div style="position:relative;">
                        <input type="password" id="pmCurPw" class="form-control" placeholder="Enter current password" style="padding-right:2.5rem;">
                        <button type="button" onclick="pmToggle('pmCurPw','pmEye1')" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#9ca3af;padding:0;font-size:.9rem;">
                            <i class="fa-solid fa-eye" id="pmEye1"></i>
                        </button>
                    </div>
                </div>
                <div style="margin-bottom:.8rem;">
                    <label style="font-size:.82rem;font-weight:600;color:#374151;display:block;margin-bottom:4px;">New Password</label>
                    <div style="position:relative;">
                        <input type="password" id="pmNewPw" class="form-control" placeholder="At least 6 characters" style="padding-right:2.5rem;">
                        <button type="button" onclick="pmToggle('pmNewPw','pmEye2')" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#9ca3af;padding:0;font-size:.9rem;">
                            <i class="fa-solid fa-eye" id="pmEye2"></i>
                        </button>
                    </div>
                </div>
                <div style="margin-bottom:1.1rem;">
                    <label style="font-size:.82rem;font-weight:600;color:#374151;display:block;margin-bottom:4px;">Confirm New Password</label>
                    <div style="position:relative;">
                        <input type="password" id="pmConfPw" class="form-control" placeholder="Repeat new password" style="padding-right:2.5rem;">
                        <button type="button" onclick="pmToggle('pmConfPw','pmEye3')" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#9ca3af;padding:0;font-size:.9rem;">
                            <i class="fa-solid fa-eye" id="pmEye3"></i>
                        </button>
                    </div>
                </div>
                <button class="btn btn-primary" onclick="pmChangePassword()" id="pmSaveBtn" style="width:100%;">
                    <i class="fa-solid fa-key"></i> Update Password
                </button>
            </div>

        </div>
    </div>

    <script>
    // Advisers act on the teachers table; all other roles on the users table.
    var ACCOUNT = <%- JSON.stringify(
        user.role === 'adviser'
            ? { data: '/admin/adviser-profile-data', profile: '/admin/adviser-update-profile', password: '/admin/adviser-change-password', photo: '/admin/adviser-upload-photo' }
            : { data: '/admin/account-data', profile: '/admin/account-update-profile', password: '/admin/account-change-password', photo: '/admin/account-upload-photo' }
    ) %>;
    function openAdviserProfileModal(mode) {
        var m = document.getElementById('adviserProfileModal');
        var profilePanel = document.getElementById('pmProfilePanel');
        var passwordPanel = document.getElementById('pmPasswordPanel');
        var title = document.getElementById('pmModalTitle');
        if (mode === 'password') {
            profilePanel.style.display = 'none';
            passwordPanel.style.display = 'block';
            title.innerHTML = '<i class="fa-solid fa-lock" style="color:var(--primary,#059669);margin-right:7px;"></i>Change Password';
        } else {
            profilePanel.style.display = 'flex';
            passwordPanel.style.display = 'none';
            title.innerHTML = '<i class="fa-solid fa-user-circle" style="color:var(--primary,#059669);margin-right:7px;"></i>My Profile';
            pmLoadProfile();
        }
        m.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
    function closeAdviserProfileModal() {
        document.getElementById('adviserProfileModal').style.display = 'none';
        document.body.style.overflow = '';
        document.getElementById('pmPwAlert').style.display = 'none';
        document.getElementById('pmProfileAlert').style.display = 'none';
        document.getElementById('pmCurPw').value = '';
        document.getElementById('pmNewPw').value = '';
        document.getElementById('pmConfPw').value = '';
    }
    document.getElementById('adviserProfileModal').addEventListener('click', function(e) {
        if (e.target === this) closeAdviserProfileModal();
    });

    async function pmLoadProfile() {
        // Pre-fill name from session immediately (already set in HTML value attribute)
        // AJAX will override with DB value if available
        var sessionName = '<%= user && user.fullname ? user.fullname.replace(/'/g, "\\'") : "" %>';
        document.getElementById('pmFullNameInput').value = sessionName;
        try {
            var res = await fetch(ACCOUNT.data);
            if (!res.ok) return;
            var t = await res.json();
            if (t.error) return;
            // photo
            if (t.profile_photo) {
                document.getElementById('pmAvatarInner').innerHTML =
                    '<img src="' + t.profile_photo + '" alt="Photo" style="width:100%;height:100%;object-fit:cover;">';
                var sav = document.getElementById('sidebarAvatar');
                if (sav) sav.innerHTML = '<img src="' + t.profile_photo + '" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">';
            }
            // name: use fullname directly, or build from parts (teachers), fall back to session name
            var parts = [t.firstname, t.middlename, t.lastname].filter(function(p){ return p && p.trim(); });
            var combinedName = (t.fullname && t.fullname.trim()) ? t.fullname.trim() : parts.join(' ').trim();
            document.getElementById('pmFullNameInput').value = combinedName || t.session_fullname || sessionName;
            document.getElementById('pmEmail').value   = t.email   || '';
            document.getElementById('pmContact').value = t.contact || '';
        } catch(e) {
            // network error — name is already set from session above
        }
    }

    async function pmSaveProfile() {
        var btn = document.getElementById('pmProfileSaveBtn');
        var alertEl = document.getElementById('pmProfileAlert');
        var fullname = document.getElementById('pmFullNameInput').value.trim();
        var email    = document.getElementById('pmEmail').value.trim();
        var contact  = document.getElementById('pmContact').value.trim();
        if (!fullname) {
            alertEl.textContent = 'Name is required.';
            alertEl.style.display = 'block';
            alertEl.style.background = '#fef2f2';
            alertEl.style.color = '#dc2626';
            alertEl.style.border = '1px solid #dc2626';
            return;
        }
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';
        try {
            var res = await fetch(ACCOUNT.profile, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fullname, email, contact })
            });
            var data = await res.json();
            if (data.success) {
                alertEl.textContent = 'Profile saved successfully.';
                alertEl.style.display = 'block';
                alertEl.style.background = '#f0fdf4';
                alertEl.style.color = '#16a34a';
                alertEl.style.border = '1px solid #bbf7d0';
                // update sidebar name
                var sn = document.querySelector('.sidebar-footer .user-details strong');
                if (sn) sn.textContent = data.fullname;
                setTimeout(function(){ alertEl.style.display = 'none'; }, 3000);
            } else {
                alertEl.textContent = data.error || 'Failed to save.';
                alertEl.style.display = 'block';
                alertEl.style.background = '#fef2f2';
                alertEl.style.color = '#dc2626';
                alertEl.style.border = '1px solid #dc2626';
            }
        } catch(e) {
            alertEl.textContent = 'Network error.';
            alertEl.style.display = 'block';
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Profile';
    }

    function pmToggle(inputId, iconId) {
        var inp = document.getElementById(inputId);
        var ico = document.getElementById(iconId);
        if (inp.type === 'password') {
            inp.type = 'text';
            ico.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            inp.type = 'password';
            ico.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    function pmShowAlert(msg, isError) {
        var el = document.getElementById('pmPwAlert');
        el.textContent = msg;
        el.style.display = 'block';
        el.style.background = isError ? '#fef2f2' : '#f0fdf4';
        el.style.color = isError ? '#dc2626' : '#16a34a';
        el.style.border = '1px solid ' + (isError ? '#dc2626' : '#16a34a');
    }

    async function pmChangePassword() {
        var cur = document.getElementById('pmCurPw').value.trim();
        var nw = document.getElementById('pmNewPw').value;
        var conf = document.getElementById('pmConfPw').value;
        if (!cur || !nw || !conf) return pmShowAlert('All fields are required.', true);
        var btn = document.getElementById('pmSaveBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
        try {
            var res = await fetch(ACCOUNT.password, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ current_password: cur, new_password: nw, confirm_password: conf })
            });
            var data = await res.json();
            if (data.success) {
                pmShowAlert('Password updated successfully.', false);
                document.getElementById('pmCurPw').value = '';
                document.getElementById('pmNewPw').value = '';
                document.getElementById('pmConfPw').value = '';
            } else {
                pmShowAlert(data.error || 'Failed.', true);
            }
        } catch(e) {
            pmShowAlert('Network error.', true);
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-key"></i> Update Password';
    }

    async function pmUploadPhoto(input) {
        var file = input.files[0];
        if (!file) return;
        var msg = document.getElementById('pmPhotoMsg');
        msg.style.display = 'block';
        msg.style.color = '#6b7280';
        msg.textContent = 'Uploading...';
        var form = new FormData();
        form.append('photo', file);
        try {
            var res = await fetch(ACCOUNT.photo, { method: 'POST', body: form });
            var data = await res.json();
            if (data.success) {
                document.getElementById('pmAvatarInner').innerHTML = '<img src="' + data.photo + '" alt="Photo" style="width:100%;height:100%;object-fit:cover;">';
                // also update sidebar avatar
                var sav = document.getElementById('sidebarAvatar');
                if (sav) sav.innerHTML = '<img src="' + data.photo + '" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">';
                msg.style.color = '#16a34a';
                msg.textContent = 'Photo updated!';
                setTimeout(function(){ msg.style.display = 'none'; }, 2500);
            } else {
                msg.style.color = '#dc2626';
                msg.textContent = data.error || 'Upload failed.';
            }
        } catch(e) {
            msg.style.color = '#dc2626';
            msg.textContent = 'Network error.';
        }
        input.value = '';
    }
    </script>
    <% } %>
    <% } %>

    <% if (typeof user !== 'undefined' && user && (user.role === 'adviser' || user.role === 'principal')) { %>
    <!-- Transfer / reassignment notifications (advisers approve; requesters see outcomes) -->
    <div id="trBellWrap" style="position:fixed; right:20px; bottom:20px; z-index:1200;">
        <button id="trBell" aria-label="Notifications" style="position:relative; width:52px; height:52px; border-radius:50%; border:none; background:var(--primary,#16a34a); color:#fff; box-shadow:0 6px 20px rgba(0,0,0,.18); cursor:pointer; font-size:20px;">
            <i class="fa-solid fa-bell"></i>
            <span id="trBadge" style="display:none; position:absolute; top:-3px; right:-3px; min-width:20px; height:20px; padding:0 5px; border-radius:10px; background:#dc2626; color:#fff; font-size:11px; font-weight:700; line-height:20px; box-sizing:border-box;">0</span>
        </button>
        <div id="trPanel" style="display:none; position:absolute; right:0; bottom:64px; width:340px; max-height:60vh; overflow:auto; background:#fff; border:1px solid #e5e7eb; border-radius:14px; box-shadow:0 12px 40px rgba(0,0,0,.18);">
            <div style="padding:12px 14px; font-weight:700; font-size:0.9rem; border-bottom:1px solid #eef0f2; color:#111827;">Notifications</div>
            <div id="trList"></div>
        </div>
    </div>
    <div id="trModal" style="display:none; position:fixed; inset:0; z-index:1300; background:rgba(15,23,42,.5); align-items:center; justify-content:center; padding:18px;">
        <div id="trModalCard" style="width:100%; max-width:440px; background:#fff; border-radius:16px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,.3);"></div>
    </div>
    <div id="trToast" style="display:none; position:fixed; left:50%; bottom:24px; transform:translateX(-50%); z-index:1400; padding:12px 18px; border-radius:10px; font-size:0.85rem; font-weight:600; box-shadow:0 8px 24px rgba(0,0,0,.18);"></div>
    <script>
    (function(){
        var bell=document.getElementById('trBell'), badge=document.getElementById('trBadge'),
            panel=document.getElementById('trPanel'), list=document.getElementById('trList'),
            modal=document.getElementById('trModal'), card=document.getElementById('trModalCard'),
            toast=document.getElementById('trToast');
        if(!bell) return;
        var pending=[], autoShown=false, toastTimer=null;
        function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
        function fmtMove(r){ return esc(r.from_section_name||'—') + ' → ' + esc(r.to_section_name||'—'); }
        function row(l,v,strong){ return '<div style="display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px solid #eef0f2;font-size:0.83rem;"><span style="color:#6b7280;">'+l+'</span><span style="font-weight:'+(strong?'700':'500')+';text-align:right;color:#111827;">'+esc(v)+'</span></div>'; }

        function render(){
            badge.textContent = pending.length;
            badge.style.display = pending.length ? 'inline-block' : 'none';
            if(!pending.length){ list.innerHTML = '<div style="padding:18px 14px;color:#6b7280;font-size:0.82rem;text-align:center;">No pending requests.</div>'; return; }
            list.innerHTML = pending.map(function(r){
                var isT = r.request_type==='teacher_section';
                var title = isT ? 'Section reassignment' : 'Student transfer';
                var icon = isT ? 'fa-user-gear' : 'fa-user-group';
                return '<button class="tr-item" data-id="'+r.id+'" style="width:100%;text-align:left;border:none;border-bottom:1px solid #f1f3f5;background:#fff;padding:11px 14px;cursor:pointer;display:flex;gap:10px;align-items:flex-start;">'
                    +'<span style="width:34px;height:34px;border-radius:9px;background:#eef2ff;color:#4f46e5;display:flex;align-items:center;justify-content:center;flex:0 0 auto;"><i class="fa-solid '+icon+'"></i></span>'
                    +'<span style="min-width:0;"><span style="display:block;font-weight:700;font-size:0.82rem;color:#111827;">'+title+'</span>'
                    +'<span style="display:block;font-size:0.76rem;color:#6b7280;">'+esc(r.subject_name||'')+'</span>'
                    +'<span style="display:block;font-size:0.72rem;color:#9ca3af;margin-top:1px;">'+fmtMove(r)+'</span></span></button>';
            }).join('');
            Array.prototype.forEach.call(list.querySelectorAll('.tr-item'), function(b){
                b.addEventListener('click', function(){ openModal(parseInt(b.getAttribute('data-id'),10)); });
            });
        }

        function openModal(id){
            var r = pending.filter(function(x){return x.id===id;})[0]; if(!r) return;
            panel.style.display='none';
            var isT = r.request_type==='teacher_section';
            var head = isT ? 'Attention — section reassignment' : 'Student transfer request';
            var bg = isT ? '#fff7ed' : '#eff6ff', tx = isT ? '#9a3412' : '#1e40af', ic = isT ? 'fa-triangle-exclamation' : 'fa-user-group';
            var msg = isT ? 'Your principal is reassigning your advisory section.' : (esc(r.requester_name||'An adviser')+' wants to move this student into your section.');
            var rows = isT
                ? row('Requested by', r.requester_name||'Principal', true) + row('Current section', r.from_section_name||'—') + row('New section', r.to_section_name||'—', true)
                : row('Student', r.subject_name||'', true) + (r.subject_lrn?row('LRN', r.subject_lrn):'') + row('Requested by', r.requester_name||'Adviser') + row('From', r.from_section_name||'—') + row('Into your section', r.to_section_name||'—', true);
            card.innerHTML =
                '<div style="padding:16px 18px;background:'+bg+';display:flex;gap:11px;align-items:center;">'
                    +'<span style="width:38px;height:38px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;color:'+tx+';font-size:18px;"><i class="fa-solid '+ic+'"></i></span>'
                    +'<div><div style="font-weight:800;font-size:1rem;color:'+tx+';">'+head+'</div><div style="font-size:0.78rem;color:'+tx+';">'+msg+'</div></div></div>'
                +'<div style="padding:12px 18px 4px;">'+rows+'</div>'
                +'<div style="display:flex;gap:10px;padding:14px 18px 18px;justify-content:flex-end;">'
                    +'<button id="trDecline" style="padding:9px 16px;border-radius:9px;border:1px solid #fecaca;background:#fff;color:#dc2626;font-weight:700;cursor:pointer;"><i class="fa-solid fa-xmark"></i> Decline</button>'
                    +'<button id="trAccept" style="padding:9px 16px;border-radius:9px;border:none;background:#16a34a;color:#fff;font-weight:700;cursor:pointer;"><i class="fa-solid fa-check"></i> Accept</button>'
                +'</div>';
            modal.style.display='flex';
            document.getElementById('trAccept').addEventListener('click', function(){ respond(id,'accept'); });
            document.getElementById('trDecline').addEventListener('click', function(){ respond(id,'decline'); });
        }

        function respond(id, action){
            var a=document.getElementById('trAccept'), d=document.getElementById('trDecline');
            if(a) a.disabled=true; if(d) d.disabled=true;
            fetch('/api/transfers/'+id+'/'+action, { method:'POST' })
                .then(function(r){ return r.json(); })
                .then(function(res){
                    modal.style.display='none';
                    if(res.success){ showToast(action==='accept', action==='accept'?'Request accepted — records updated.':'Request declined.'); load(); }
                    else showToast(false, res.error||'Action failed.');
                })
                .catch(function(){ modal.style.display='none'; showToast(false,'Network error.'); });
        }

        function showToast(ok,msg){
            toast.textContent=msg;
            toast.style.background = ok ? '#dcfce7' : '#fee2e2';
            toast.style.color = ok ? '#166534' : '#991b1b';
            toast.style.display='block';
            if(toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(function(){ toast.style.display='none'; }, 4000);
        }

        function load(){
            fetch('/api/transfers/pending', { headers:{'Accept':'application/json'} })
                .then(function(r){ return r.ok ? r.json() : {pending:[],updates:[]}; })
                .then(function(d){
                    pending = (d && d.pending) || [];
                    render();
                    var ups = (d && d.updates) || [];
                    if(ups.length){
                        var u = ups[0];
                        showToast(u.status==='accepted', (u.subject_name||'Your request')+' — transfer '+u.status+'.');
                        fetch('/api/transfers/seen', { method:'POST' });
                    }
                    if(!autoShown){
                        var urgent = pending.filter(function(x){ return x.request_type==='teacher_section'; })[0];
                        if(urgent){ autoShown=true; openModal(urgent.id); }
                    }
                })
                .catch(function(){});
        }

        bell.addEventListener('click', function(){ panel.style.display = panel.style.display==='none'?'block':'none'; });
        modal.addEventListener('click', function(e){ if(e.target===modal) modal.style.display='none'; });
        load();
        setInterval(load, 15000);
    })();
    </script>
    <% } %>

    <main class="content<%= (typeof user === 'undefined' || !user) ? ' full-width' : '' %>">
        <% if (typeof user !== 'undefined' && user) { %>
        <header class="topbar">
            <button class="menu-btn" onclick="document.getElementById('sidebar').classList.toggle('collapsed')">
                <i class="fa-solid fa-bars"></i>
            </button>
            <% if (!['dashboard','principal_dashboard','sds_dashboard','asds_dashboard','adviser_dashboard'].includes(page)) { %>
            <h1><%= title %></h1>
            <% } else { %>
            <div style="flex: 1;"></div>
            <% } %>
            <% if (typeof headerSchool !== 'undefined' && headerSchool) { %>
            <div class="topbar-school" title="<%= headerSchool.name %>">
                <% if (headerSchool.logo) { %>
                <img class="topbar-school-logo" src="<%= headerSchool.logo %>" alt="" onerror="this.onerror=null;this.outerHTML='<span class=\'topbar-school-fallback\'><i class=\'fa-solid fa-school\'></i></span>';">
                <% } else { %>
                <span class="topbar-school-fallback"><i class="fa-solid fa-school"></i></span>
                <% } %>
                <span class="topbar-school-name"><%= headerSchool.name %></span>
            </div>
            <% } %>
            <div class="topbar-user">
                <div class="topbar-user-avatar"><%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %></div>
                <div class="topbar-user-details">
                    <strong><%= user.fullname %></strong>
                    <span><%= user.role.replace(/_/g, ' ') %></span>
                </div>
            </div>
        </header>
        <% } %>
        <div class="page-content">

