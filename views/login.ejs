<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In — <%= (typeof settings !== 'undefined' && settings && settings.system_name) || 'QR Attendance' %></title>
    <link rel="icon" type="image/png" href="/uploads/logos/system-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <% if (typeof settings !== 'undefined' && settings && settings.system_logo) { %>
                    <img src="<%= settings.system_logo %>" alt="Logo" onerror="this.parentElement.innerHTML='<i class=\'fa-solid fa-qrcode\'></i>'">
                    <% } else { %>
                    <i class="fa-solid fa-qrcode"></i>
                    <% } %>
                </div>
                <h1><%= (typeof settings !== 'undefined' && settings && settings.system_name) || 'QR Attendance' %></h1>
                <p><%= (typeof settings !== 'undefined' && settings && settings.division_name) || 'School Attendance Monitoring System' %></p>
            </div>

            <% if (error) { %>
            <div class="alert alert-error">
                <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
            </div>
            <% } %>

            <form method="POST" action="/login" class="login-form">
                <div class="form-group">
                    <label for="username"><i class="fa-solid fa-user"></i> Username</label>
                    <input type="text" id="username" name="username" required autofocus
                           autocomplete="username" placeholder="Enter your username">
                </div>
                <div class="form-group">
                    <label for="password"><i class="fa-solid fa-lock"></i> Password</label>
                    <div style="position:relative;">
                        <input type="password" id="password" name="password" required
                               autocomplete="current-password" placeholder="Enter your password"
                               style="padding-right:42px;">
                        <button type="button" onclick="togglePwd()"
                                style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--gray-400);font-size:0.875rem;">
                            <i class="fa-regular fa-eye" id="pwdEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:8px;">
                    <i class="fa-solid fa-right-to-bracket"></i> Sign In
                </button>
            </form>

            <p style="text-align:center;margin-top:20px;font-size:0.75rem;color:var(--gray-400);">
                <i class="fa-solid fa-shield-halved"></i> Authorized personnel only
            </p>
        </div>
    </div>
    <script>
    function togglePwd() {
        var inp = document.getElementById('password');
        var ico = document.getElementById('pwdEyeIcon');
        if (inp.type === 'password') {
            inp.type = 'text';
            ico.className = 'fa-regular fa-eye-slash';
        } else {
            inp.type = 'password';
            ico.className = 'fa-regular fa-eye';
        }
    }
    </script>
</body>
</html>
