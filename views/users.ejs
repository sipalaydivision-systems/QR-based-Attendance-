<%- include('partials/header') %>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-users-gear"></i> User Management</h1>
        <p style="color:var(--gray-500);margin:0;">Manage administrator accounts, roles, school access, and account status.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" onclick="openUserModal()"><i class="fa-solid fa-user-plus"></i> Add User</button>
    </div>
</div>

<div class="filter-bar">
    <div class="filter-item">
        <label>Search</label>
        <input type="text" id="userSearch" placeholder="Search username, name, email, or school" oninput="renderUsers()">
    </div>
    <div class="filter-item">
        <label>Role</label>
        <select id="roleFilter" onchange="renderUsers()">
            <option value="">All Roles</option>
            <option value="super_admin">Super Admin</option>
            <option value="superintendent">Superintendent</option>
            <option value="asst_superintendent">Assistant Superintendent</option>
            <option value="principal">Principal</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Status</label>
        <select id="statusFilter" onchange="renderUsers()">
            <option value="">All Statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>
</div>

<div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:1rem;">
    <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-users"></i></div><div><div class="stat-value" id="totalUsers">0</div><div class="stat-label">Total Users</div></div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#e8f5e9;color:#047857;"><i class="fa-solid fa-user-check"></i></div><div><div class="stat-value" id="activeUsers">0</div><div class="stat-label">Active</div></div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#fff7ed;color:#c2410c;"><i class="fa-solid fa-user-clock"></i></div><div><div class="stat-value" id="inactiveUsers">0</div><div class="stat-label">Inactive</div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>School Access</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="usersBody"></tbody>
        </table>
    </div>
</div>

<div class="modal-overlay" id="userModal" style="display:none">
    <div class="modal modal-lg">
        <div class="modal-header">
            <h3 id="userModalTitle">Add User</h3>
            <button class="modal-close" onclick="closeUserModal()">&times;</button>
        </div>
        <form id="userForm" onsubmit="saveUser(event)">
            <input type="hidden" id="userId">
            <div class="form-row">
                <div class="form-group"><label>Username *</label><input type="text" id="username" required autocomplete="username"></div>
                <div class="form-group"><label>Password <span id="passwordHint">*</span></label><input type="password" id="password" autocomplete="new-password" placeholder="Set or change password"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Full Name *</label><input type="text" id="fullname" required></div>
                <div class="form-group"><label>Email</label><input type="email" id="email" placeholder="name@example.com"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Role *</label>
                    <select id="role" required onchange="syncRoleHelp()">
                        <option value="principal">Principal</option>
                        <option value="superintendent">Superintendent</option>
                        <option value="asst_superintendent">Assistant Superintendent</option>
                        <option value="super_admin">Super Admin</option>
                    </select>
                </div>
                <div class="form-group"><label>School Access</label><select id="schoolId"></select></div>
                <div class="form-group"><label>Status</label><select id="userStatus"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
            </div>
            <div class="alert alert-info" id="roleHelp" style="margin-top:.5rem;"></div>
            <div id="userMsg" style="margin-top:.75rem;"></div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="closeUserModal()">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save User</button>
            </div>
        </form>
    </div>
</div>

<script>
var users = [];
var schools = [];
var roleLabels = {
    super_admin: 'Super Admin',
    superintendent: 'Superintendent',
    asst_superintendent: 'Assistant Superintendent',
    principal: 'Principal'
};
var roleHelp = {
    super_admin: 'Full division-level access to all modules, settings, imports, reports, and user management.',
    superintendent: 'Division dashboard and monitoring access across schools.',
    asst_superintendent: 'Assistant superintendent dashboard and division monitoring access.',
    principal: 'School-level dashboard, records, scanner, reports, and alerts for the assigned school.'
};

function esc(v) {
    return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function roleBadge(role) {
    var colors = {
        super_admin: 'background:#dbeafe;color:#1e40af;',
        superintendent: 'background:#ede9fe;color:#5b21b6;',
        asst_superintendent: 'background:#fce7f3;color:#9d174d;',
        principal: 'background:#dcfce7;color:#166534;'
    };
    return '<span class="badge" style="' + (colors[role] || '') + '">' + esc(roleLabels[role] || role) + '</span>';
}

async function loadUsers() {
    var res = await fetch('/api/users');
    users = await res.json();
    renderUsers();
}

async function loadSchools() {
    var res = await fetch('/api/schools');
    schools = (await res.json()).filter(function(s){ return s.status === 'active'; });
    document.getElementById('schoolId').innerHTML = '<option value="">All Schools / Division</option>' + schools.map(function(s){ return '<option value="' + s.id + '">' + esc(s.name) + '</option>'; }).join('');
}

function renderUsers() {
    var q = document.getElementById('userSearch').value.toLowerCase();
    var role = document.getElementById('roleFilter').value;
    var status = document.getElementById('statusFilter').value;
    var filtered = users.filter(function(u){
        var text = [u.username, u.fullname, u.email, u.role, u.school_name].join(' ').toLowerCase();
        return (!q || text.indexOf(q) >= 0) && (!role || u.role === role) && (!status || u.status === status);
    });
    document.getElementById('totalUsers').textContent = users.length;
    document.getElementById('activeUsers').textContent = users.filter(function(u){ return u.status === 'active'; }).length;
    document.getElementById('inactiveUsers').textContent = users.filter(function(u){ return u.status === 'inactive'; }).length;
    document.getElementById('usersBody').innerHTML = filtered.map(function(u){
        var active = u.status === 'active';
        var lastLogin = u.last_login ? new Date(u.last_login).toLocaleString() : 'Not yet logged in';
        return '<tr' + (!active ? ' class="row-inactive"' : '') + '>' +
            '<td><strong>' + esc(u.fullname) + '</strong><br><small style="color:var(--gray-500);">@' + esc(u.username) + (u.email ? ' - ' + esc(u.email) : '') + '</small></td>' +
            '<td>' + roleBadge(u.role) + '</td>' +
            '<td>' + esc(u.school_name || 'All Schools / Division') + '</td>' +
            '<td><span class="badge ' + (active ? 'badge-active' : 'badge-inactive') + '">' + (active ? 'Active' : 'Inactive') + '</span></td>' +
            '<td>' + esc(lastLogin) + '</td>' +
            '<td><div class="action-btns">' +
                '<button class="action-btn edit" onclick="editUser(' + u.id + ')" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>' +
                '<button class="action-btn ' + (active ? 'delete' : 'edit') + '" onclick="toggleUser(' + u.id + ')" title="' + (active ? 'Deactivate' : 'Reactivate') + '"><i class="fa-solid ' + (active ? 'fa-user-slash' : 'fa-user-check') + '"></i></button>' +
            '</div></td>' +
        '</tr>';
    }).join('') || '<tr><td colspan="6"><div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-users-gear" style="font-size:2.5rem;color:var(--gray-300);"></i></div><h4>No users found</h4><p>Adjust filters or add a new administrator account.</p></div></td></tr>';
}

function syncRoleHelp() {
    var role = document.getElementById('role').value;
    document.getElementById('roleHelp').innerHTML = '<i class="fa-solid fa-circle-info"></i> ' + esc(roleHelp[role] || 'Select a role.');
    document.getElementById('schoolId').required = role === 'principal';
}

function openUserModal() {
    document.getElementById('userModalTitle').textContent = 'Add User';
    document.getElementById('userForm').reset();
    document.getElementById('userId').value = '';
    document.getElementById('passwordHint').textContent = '*';
    document.getElementById('userStatus').value = 'active';
    document.getElementById('role').value = 'principal';
    document.getElementById('userMsg').innerHTML = '';
    syncRoleHelp();
    document.getElementById('userModal').style.display = 'flex';
}

function closeUserModal() { document.getElementById('userModal').style.display = 'none'; }

function editUser(id) {
    var u = users.find(function(x){ return x.id === id; });
    if (!u) return;
    openUserModal();
    document.getElementById('userModalTitle').textContent = 'Edit User';
    document.getElementById('passwordHint').textContent = '(leave blank to keep current)';
    document.getElementById('userId').value = u.id;
    document.getElementById('username').value = u.username || '';
    document.getElementById('fullname').value = u.fullname || '';
    document.getElementById('email').value = u.email || '';
    document.getElementById('role').value = u.role || 'principal';
    document.getElementById('schoolId').value = u.school_id || '';
    document.getElementById('userStatus').value = u.status || 'active';
    syncRoleHelp();
}

async function saveUser(e) {
    e.preventDefault();
    var id = document.getElementById('userId').value;
    var body = {
        username: document.getElementById('username').value.trim(),
        fullname: document.getElementById('fullname').value.trim(),
        email: document.getElementById('email').value.trim(),
        password: document.getElementById('password').value,
        role: document.getElementById('role').value,
        school_id: document.getElementById('schoolId').value || null,
        status: document.getElementById('userStatus').value
    };
    if (!id && !body.password) {
        document.getElementById('userMsg').innerHTML = '<div class="alert alert-danger">Password is required for a new user.</div>';
        return;
    }
    var url = id ? '/api/users/' + id : '/api/users';
    var method = id ? 'PUT' : 'POST';
    var res = await fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    var data = await res.json();
    if (data.success) { closeUserModal(); loadUsers(); }
    else document.getElementById('userMsg').innerHTML = '<div class="alert alert-danger">' + esc(data.error || 'Failed to save user.') + '</div>';
}

async function toggleUser(id) {
    var u = users.find(function(x){ return x.id === id; });
    if (!u) return;
    if (u.status === 'active') {
        if (!confirm('Deactivate this user account? The user will no longer be able to sign in.')) return;
        var del = await fetch('/api/users/' + id, { method: 'DELETE' });
        var delData = await del.json().catch(function(){ return {}; });
        if (!del.ok || delData.error) alert(delData.error || 'Failed to deactivate user.');
    } else {
        var body = Object.assign({}, u, { status: 'active', password: '' });
        var res = await fetch('/api/users/' + id, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
        var data = await res.json();
        if (!res.ok || data.error) alert(data.error || 'Failed to reactivate user.');
    }
    loadUsers();
}

loadSchools().then(loadUsers);
setInterval(function(){ if (document.getElementById('userModal').style.display !== 'flex') loadUsers(); }, 10000);
</script>

<%- include('partials/footer') %>
