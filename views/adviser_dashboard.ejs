<%- include('partials/header') %>

<style>
.ad-wrap { width: 100%; }

.ad-welcome {
    display: flex; align-items: center; justify-content: space-between;
    background: linear-gradient(135deg, var(--primary), #16a34a);
    border-radius: var(--radius-lg); padding: 24px 28px;
    color: #fff; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;
}
.ad-welcome-left h2 { font-size: 1.375rem; font-weight: 800; margin: 0; }
.ad-welcome-left p { font-size: 0.8125rem; opacity: 0.9; margin: 4px 0 0; }
.ad-welcome-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.ad-date-input {
    padding: 8px 12px; border: 1.5px solid rgba(255,255,255,0.45);
    border-radius: 9px; font-size: 0.8125rem;
    background: rgba(255,255,255,0.18); color: #fff; cursor: pointer;
}
.ad-date-input::-webkit-calendar-picker-indicator { filter: invert(1); }

.ad-section-info {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    background: #fff; border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200); box-shadow: var(--shadow);
    padding: 16px 20px; margin-bottom: 20px;
}
.ad-section-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 14px; border-radius: 20px;
    font-size: 0.8125rem; font-weight: 600;
}
.ad-section-logo {
    width: 20px;
    height: 20px;
    object-fit: contain;
    border-radius: 50%;
    background: #fff;
    padding: 2px;
    box-shadow: 0 0 0 1px rgba(79,70,229,0.12);
    flex: 0 0 auto;
}
.ad-section-badge.school { background: #eef2ff; color: #4f46e5; }
.ad-section-badge.grade  { background: #fef3c7; color: #92400e; }
.ad-section-badge.section { background: #dcfce7; color: #16a34a; }


.ad-table-card {
    background: #fff; border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200); box-shadow: var(--shadow); overflow: hidden;
    margin-bottom: 20px;
}
.ad-table-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; border-bottom: 1px solid var(--gray-100); flex-wrap: wrap; gap: 10px;
}
.ad-table-header h3 {
    font-size: 0.9375rem; font-weight: 700; color: var(--gray-800);
    margin: 0; display: flex; align-items: center; gap: 8px;
}
.ad-table-header h3 i { color: var(--primary); }
.ad-table-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.ad-search {
    padding: 7px 12px; border: 1px solid var(--gray-300);
    border-radius: var(--radius); font-size: 0.8125rem; width: 200px;
}
.ad-filter-btn {
    padding: 7px 12px; border: 1px solid var(--gray-300); border-radius: var(--radius);
    font-size: 0.75rem; font-weight: 600; background: #fff; cursor: pointer;
    transition: all 0.15s; color: var(--gray-600);
}
.ad-filter-btn:hover { background: var(--gray-50); }
.ad-filter-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }

.ad-student-table {
    width: 100%; border-collapse: collapse; font-size: 0.8125rem;
}
.ad-student-table th {
    text-align: left; padding: 10px 16px;
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--gray-500);
    background: var(--gray-50); border-bottom: 1px solid var(--gray-200);
}
.ad-student-table td {
    padding: 12px 16px; border-bottom: 1px solid var(--gray-100);
    color: var(--gray-700); vertical-align: middle;
}
.ad-student-table tr:hover td { background: var(--gray-50); }
.ad-student-name { font-weight: 600; color: var(--gray-900); }
.ad-student-lrn { font-size: 0.75rem; color: var(--gray-400); margin-top: 1px; }

.ad-status-pill {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 12px;
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
}
.ad-status-pill.present { background: #dcfce7; color: #16a34a; }
.ad-status-pill.late    { background: #fef3c7; color: #d97706; }
.ad-status-pill.absent  { background: #fee2e2; color: #dc2626; }
.ad-status-pill.inside  { background: #dbeafe; color: #2563eb; }
.ad-status-pill.outside { background: #fce7f3; color: #db2777; }
.ad-status-pill.inactive { background: var(--gray-100); color: var(--gray-400); }
.ad-status-pill.flagged { background: #fef2f2; color: #b91c1c; }

.ad-flag-badge {
    display: inline-flex; align-items: center; gap: 3px;
    background: #fef2f2; color: #dc2626; border: 1px solid #fecaca;
    padding: 2px 8px; border-radius: 8px; font-size: 0.625rem;
    font-weight: 700; margin-left: 6px;
}

.ad-time { font-family: 'Inter', monospace; font-size: 0.8125rem; font-weight: 500; }
.ad-time.none { color: var(--gray-300); }

.ad-empty {
    text-align: center; padding: 40px 20px; color: var(--gray-400);
    font-size: 0.875rem;
}
.ad-empty i { font-size: 2rem; display: block; margin-bottom: 8px; }

.ad-no-section {
    background: #fef3c7; border: 1px solid #fde68a; border-radius: var(--radius-lg);
    padding: 32px; text-align: center; color: #92400e;
}
.ad-no-section i { font-size: 2.5rem; display: block; margin-bottom: 12px; }
.ad-no-section h3 { margin: 0 0 8px; font-size: 1.125rem; }
.ad-no-section p { margin: 0; font-size: 0.875rem; }

@media (max-width: 640px) {
    .ad-search { width: 140px; }
    .ad-welcome { padding: 18px 20px; }
}
</style>

<div class="ad-wrap">
    <% if (!teacher.section_id) { %>
    <div class="ad-no-section">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <h3>No Assigned Grade Level and Section Yet</h3>
        <p>Please contact the administrator to assign your grade level and section.</p>
    </div>
    <% } else { %>

    <div class="ad-welcome">
        <div class="ad-welcome-left">
            <h2><i class="fa-solid fa-chalkboard-user"></i> Good morning, <%= [teacher.firstname, teacher.middlename && teacher.middlename.trim() ? teacher.middlename.trim().charAt(0).toUpperCase() + '.' : '', teacher.lastname].filter(function(p){ return p && p.trim(); }).join(' ') || teacher.firstname %></h2>
            <p><i class="fa-solid fa-calendar-day"></i> <span id="adDateLabel"></span></p>
        </div>
        <div class="ad-welcome-right">
            <input type="date" id="adDate" class="ad-date-input" value="">
        </div>
    </div>

    <div class="ad-section-info">
        <span class="ad-section-badge school">
            <img class="ad-section-logo" src="<%= teacher.school_logo || ((typeof settings !== 'undefined' && settings && settings.system_logo) ? settings.system_logo : '/uploads/logos/system-logo.png') %>" alt="" onerror="this.onerror=null;this.src='/uploads/logos/system-logo.png';">
            <%= teacher.school_name || 'N/A' %>
        </span>
        <span class="ad-section-badge grade"><i class="fa-solid fa-layer-group"></i> <%= teacher.grade_name || 'N/A' %></span>
        <span class="ad-section-badge section"><i class="fa-solid fa-users"></i> <%= teacher.section_name || 'N/A' %></span>
    </div>

    <div class="stats-grid" style="grid-template-columns: repeat(5, minmax(0, 1fr));">

        <div class="stat-card stat-students">
            <div class="stat-icon-wrap blue"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <span class="stat-number" id="adTotal">--</span>
                <span class="stat-label">Total Students</span>
            </div>
        </div>
        <div class="stat-card stat-present">
            <div class="stat-icon-wrap green"><i class="fa-solid fa-circle-check"></i></div>
            <div class="stat-info">
                <span class="stat-number" id="adPresent">--</span>
                <span class="stat-label">Present</span>
            </div>
        </div>
        <div class="stat-card stat-rate">
            <div class="stat-icon-wrap amber"><i class="fa-solid fa-clock"></i></div>
            <div class="stat-info">
                <span class="stat-number" id="adLate">--</span>
                <span class="stat-label">Late</span>
            </div>
        </div>
        <div class="stat-card stat-absent">
            <div class="stat-icon-wrap red"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="stat-info">
                <span class="stat-number" id="adAbsent">--</span>
                <span class="stat-label">Absent</span>
            </div>
        </div>
        <div class="stat-card" style="border-left:3px solid #dc2626;">
            <div class="stat-icon-wrap rose"><i class="fa-solid fa-flag"></i></div>
            <div class="stat-info">
                <span class="stat-number" id="adFlagged">--</span>
                <span class="stat-label">2-Day Absent</span>
            </div>
        </div>
    </div>

    <div class="ad-table-card">
        <div class="ad-table-header">
            <h3><i class="fa-solid fa-list-check"></i> Student Attendance</h3>
            <div class="ad-table-controls">
                <button class="ad-filter-btn active" data-filter="all" onclick="setFilter('all')">All</button>
                <button class="ad-filter-btn" data-filter="present" onclick="setFilter('present')">Present</button>
                <button class="ad-filter-btn" data-filter="late" onclick="setFilter('late')">Late</button>
                <button class="ad-filter-btn" data-filter="absent" onclick="setFilter('absent')">Absent</button>
                <button class="ad-filter-btn" data-filter="flagged" onclick="setFilter('flagged')">Flagged</button>
                <input type="text" id="adSearch" class="ad-search" placeholder="Search student...">
            </div>
        </div>
        <div style="overflow-x:auto;">
            <table class="ad-student-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student</th>
                        <th>Status</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                        <th>Guardian Contact</th>
                    </tr>
                </thead>
                <tbody id="adStudentBody">
                    <tr><td colspan="6" class="ad-empty"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <% } %>
</div>

<% if (teacher.section_id) { %>
<script>
(function() {
    var allStudents = [];
    var currentFilter = 'all';

    function localDateString() {
        var d = new Date();
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function formatDateLabel(dateStr) {
        var d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }

    function greetingFor() {
        var h = new Date().getHours();
        if (h < 12) return 'Good morning';
        if (h < 17) return 'Good afternoon';
        return 'Good evening';
    }

    var dateInput = document.getElementById('adDate');
    dateInput.value = localDateString();
    document.getElementById('adDateLabel').textContent = formatDateLabel(localDateString());

    var greetEl = document.querySelector('.ad-welcome-left h2');
    var teacherFullName = '<%= [teacher.firstname, teacher.middlename && teacher.middlename.trim() ? teacher.middlename.trim().charAt(0).toUpperCase() + "." : "", teacher.lastname].filter(function(p){ return p && p.trim(); }).join(" ") || teacher.firstname %>';
    if (greetEl) greetEl.innerHTML = '<i class="fa-solid fa-chalkboard-user"></i> ' + greetingFor() + ', ' + teacherFullName;

    dateInput.addEventListener('change', function() {
        document.getElementById('adDateLabel').textContent = formatDateLabel(this.value);
        loadDashboard(this.value);
    });

    document.getElementById('adSearch').addEventListener('input', function() {
        renderStudents();
    });

    window.setFilter = function(f) {
        currentFilter = f;
        document.querySelectorAll('.ad-filter-btn').forEach(function(btn) {
            btn.classList.toggle('active', btn.getAttribute('data-filter') === f);
        });
        renderStudents();
    };

    function statusPill(attStatus) {
        if (!attStatus) return '<span class="ad-status-pill absent"><i class="fa-solid fa-circle-xmark"></i> Absent</span>';
        if (attStatus === 'late') return '<span class="ad-status-pill late"><i class="fa-solid fa-clock"></i> Late</span>';
        return '<span class="ad-status-pill present"><i class="fa-solid fa-circle-check"></i> Present</span>';
    }

    function locationPill(s) {
        if (!s.att_status) return '<span class="ad-status-pill absent">--</span>';
        if (!s.monitoring_status) return '<span class="ad-status-pill inside"><i class="fa-solid fa-school"></i> Inside</span>';
        var ms = s.monitoring_status.toUpperCase();
        if (ms === 'OUT' || ms === 'LUNCH OUT' || ms === 'COMPLETED') {
            var label = ms === 'LUNCH OUT' ? 'Lunch' : ms === 'COMPLETED' ? 'Completed' : 'Outside';
            return '<span class="ad-status-pill outside"><i class="fa-solid fa-right-from-bracket"></i> ' + label + '</span>';
        }
        return '<span class="ad-status-pill inside"><i class="fa-solid fa-school"></i> Inside</span>';
    }

    function timeCell(val) {
        if (!val) return '<span class="ad-time none">--:--</span>';
        return '<span class="ad-time">' + val + '</span>';
    }

    function renderStudents() {
        var tbody = document.getElementById('adStudentBody');
        var search = (document.getElementById('adSearch').value || '').trim().toLowerCase();
        var filtered = allStudents;

        if (currentFilter === 'present') filtered = filtered.filter(function(s) { return s.att_status === 'present'; });
        else if (currentFilter === 'late') filtered = filtered.filter(function(s) { return s.att_status === 'late'; });
        else if (currentFilter === 'absent') filtered = filtered.filter(function(s) { return !s.att_status && s.student_status === 'active'; });
        else if (currentFilter === 'flagged') filtered = filtered.filter(function(s) { return s.flagged; });

        if (search) {
            filtered = filtered.filter(function(s) {
                return s.name.toLowerCase().indexOf(search) !== -1 ||
                       (s.lrn && s.lrn.toLowerCase().indexOf(search) !== -1);
            });
        }
        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="ad-empty"><i class="fa-solid fa-user-slash"></i> No students found</td></tr>';
            return;
        }
        var html = '';
        filtered.forEach(function(s, i) {
            var inactive = s.student_status !== 'active';
            html += '<tr' + (inactive ? ' style="opacity:0.5;"' : '') + '>';
            html += '<td>' + (i + 1) + '</td>';
            html += '<td><div class="ad-student-name">' + s.name;
            if (inactive) html += ' <span class="ad-status-pill inactive">Inactive</span>';
            if (s.flagged) html += ' <span class="ad-flag-badge"><i class="fa-solid fa-flag"></i> 2-Day</span>';
            html += '</div><div class="ad-student-lrn">LRN: ' + (s.lrn || 'N/A') + '</div></td>';
            html += '<td>' + (inactive ? '<span class="ad-status-pill inactive">--</span>' : statusPill(s.att_status)) + '</td>';
            html += '<td>' + timeCell(s.time_in) + '</td>';
            html += '<td>' + timeCell(s.time_out) + '</td>';
            html += '<td style="font-size:0.8125rem;color:var(--gray-500);">' + (s.guardian_contact || '--') + '</td>';
            html += '</tr>';
        });
        tbody.innerHTML = html;
    }

    async function loadDashboard(date) {
        try {
            var res = await fetch('/api/adviser-dashboard?date=' + encodeURIComponent(date));
            var data = await res.json();
            if (data.error) {
                document.getElementById('adStudentBody').innerHTML = '<tr><td colspan="6" class="ad-empty"><i class="fa-solid fa-triangle-exclamation"></i> ' + data.error + '</td></tr>';
                return;
            }
            document.getElementById('adTotal').textContent = data.kpi.total;
            document.getElementById('adPresent').textContent = data.kpi.present;
            document.getElementById('adLate').textContent = data.kpi.late;
            document.getElementById('adAbsent').textContent = data.kpi.absent;
            document.getElementById('adFlagged').textContent = data.kpi.flagged || 0;
            allStudents = data.students;
            renderStudents();
        } catch (err) {
            document.getElementById('adStudentBody').innerHTML = '<tr><td colspan="6" class="ad-empty"><i class="fa-solid fa-triangle-exclamation"></i> Failed to load data</td></tr>';
        }
    }

    loadDashboard(dateInput.value);
})();

window.openEditStudent = function(encoded) {
    var s = JSON.parse(decodeURIComponent(encoded));
    document.getElementById('esStudentId').value = s.id;
    document.getElementById('esLastname').value = s.lastname;
    document.getElementById('esFirstname').value = s.firstname;
    document.getElementById('esMiddlename').value = s.middlename;
    document.getElementById('esLrn').value = s.lrn;
    document.getElementById('esGender').value = s.gender || '';
    document.getElementById('esGuardian').value = s.guardian_contact;
    document.getElementById('esError').style.display = 'none';
    document.getElementById('esError').textContent = '';
    document.getElementById('editStudentModal').style.display = 'flex';
    document.getElementById('esLastname').focus();
};

window.closeEditStudent = function() {
    document.getElementById('editStudentModal').style.display = 'none';
};

window.submitEditStudent = function() {
    var fn = document.getElementById('esFirstname').value.trim();
    var ln = document.getElementById('esLastname').value.trim();
    var errEl = document.getElementById('esError');
    if (!fn || !ln) {
        errEl.textContent = 'First name and last name are required.';
        errEl.style.display = '';
        return;
    }
    var btn = document.getElementById('esSaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';

    fetch('/admin/adviser-edit-student', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            student_id: document.getElementById('esStudentId').value,
            firstname: fn,
            lastname: ln,
            middlename: document.getElementById('esMiddlename').value.trim(),
            lrn: document.getElementById('esLrn').value.trim(),
            gender: document.getElementById('esGender').value,
            guardian_contact: document.getElementById('esGuardian').value.trim()
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            closeEditStudent();
            loadDashboard(dateInput.value);
        } else {
            errEl.textContent = data.error || 'Save failed.';
            errEl.style.display = '';
        }
    })
    .catch(function() {
        errEl.textContent = 'Network error — try again.';
        errEl.style.display = '';
    })
    .finally(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
    });
};

function openSF2Modal() {
    document.getElementById('sf2Modal').style.display = 'flex';
    var now = new Date();
    document.getElementById('sf2Month').value = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
}
function closeSF2Modal() { document.getElementById('sf2Modal').style.display = 'none'; }
function generateSF2() {
    var month = document.getElementById('sf2Month').value;
    if (!month) return;
    window.open('/admin/sf2-report?month=' + month, '_blank');
    closeSF2Modal();
}
</script>

<!-- Student Edit Modal -->
<div class="modal-overlay" id="editStudentModal" style="display:none;">
    <div class="modal" style="max-width:480px;">
        <div class="modal-header">
            <h3><i class="fa-solid fa-user-pen"></i> Edit Student Information</h3>
            <button class="modal-close" onclick="closeEditStudent()">&times;</button>
        </div>
        <div style="padding:24px;">
            <input type="hidden" id="esStudentId">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div class="form-group">
                    <label style="font-size:0.75rem;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:5px;">Last Name *</label>
                    <input type="text" id="esLastname" class="form-control" placeholder="e.g. Dela Cruz" style="width:100%;box-sizing:border-box;">
                </div>
                <div class="form-group">
                    <label style="font-size:0.75rem;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:5px;">First Name *</label>
                    <input type="text" id="esFirstname" class="form-control" placeholder="e.g. Juan" style="width:100%;box-sizing:border-box;">
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div class="form-group">
                    <label style="font-size:0.75rem;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:5px;">Middle Name</label>
                    <input type="text" id="esMiddlename" class="form-control" placeholder="Optional" style="width:100%;box-sizing:border-box;">
                </div>
                <div class="form-group">
                    <label style="font-size:0.75rem;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:5px;">LRN</label>
                    <input type="text" id="esLrn" class="form-control" maxlength="12" placeholder="12-digit LRN" style="width:100%;box-sizing:border-box;">
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div class="form-group">
                    <label style="font-size:0.75rem;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:5px;">Sex</label>
                    <select id="esGender" class="form-control" style="width:100%;box-sizing:border-box;">
                        <option value="">— Select —</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="form-group">
                    <label style="font-size:0.75rem;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:5px;">Guardian Contact</label>
                    <input type="text" id="esGuardian" class="form-control" placeholder="09XXXXXXXXX" style="width:100%;box-sizing:border-box;">
                </div>
            </div>
            <div id="esError" style="color:#dc2626;font-size:0.8125rem;margin-bottom:10px;display:none;"></div>
            <div style="display:flex;gap:10px;justify-content:flex-end;">
                <button class="btn btn-secondary" onclick="closeEditStudent()">Cancel</button>
                <button class="btn btn-primary" id="esSaveBtn" onclick="submitEditStudent()"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- SF2 Month Picker Modal -->
<div class="modal-overlay" id="sf2Modal" style="display:none;">
    <div class="modal" style="max-width:380px;">
        <div class="modal-header">
            <h3><i class="fa-solid fa-file-lines"></i> Generate SF2 Report</h3>
            <button class="modal-close" onclick="closeSF2Modal()">&times;</button>
        </div>
        <div style="padding:24px;">
            <div class="form-group" style="margin-bottom:20px;">
                <label style="font-size:0.75rem;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">Select Month</label>
                <input type="month" id="sf2Month" style="width:100%;padding:10px 14px;border:1.5px solid var(--gray-300);border-radius:8px;font-size:0.875rem;box-sizing:border-box;">
            </div>
            <div style="display:flex;gap:10px;justify-content:flex-end;">
                <button class="btn btn-secondary" onclick="closeSF2Modal()">Cancel</button>
                <button class="btn btn-primary" onclick="generateSF2()"><i class="fa-solid fa-print"></i> Generate</button>
            </div>
        </div>
    </div>
</div>

<% } %>

