<%- include('partials/header') %>

<style>
.ai-wrap { width: 100%; }
.ai-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    background: linear-gradient(135deg, var(--primary), #16a34a);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    color: #fff;
    margin-bottom: 18px;
}
.ai-hero h2 { margin: 0; font-size: 1.2rem; font-weight: 800; display: flex; align-items: center; gap: 8px; }
.ai-hero p { margin: 5px 0 0; opacity: .88; font-size: .83rem; }
.ai-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.ai-hero-actions .btn { background: #fff; color: var(--primary); font-weight: 700; border: 0; }

.ai-badges { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
.ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 999px;
    font-size: .8rem;
    font-weight: 700;
}
.ai-badge.school { background: #eef2ff; color: #4f46e5; }
.ai-badge.grade { background: #fef3c7; color: #92400e; }
.ai-badge.section { background: #dcfce7; color: #15803d; }
.ai-school-logo {
    width: 21px;
    height: 21px;
    object-fit: contain;
    border-radius: 50%;
    background: #fff;
    padding: 2px;
    box-shadow: 0 0 0 1px rgba(79,70,229,.12);
}

.ai-grid { display: grid; grid-template-columns: minmax(300px, 420px) minmax(0, 1fr); gap: 18px; align-items: start; }
.ai-card {
    background: #fff;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
}
.ai-card-header {
    padding: 16px 18px;
    border-bottom: 1px solid var(--gray-100);
}
.ai-card-header h3 { margin: 0; font-size: .98rem; font-weight: 800; color: var(--gray-900); display: flex; align-items: center; gap: 8px; }
.ai-card-header h3 i { color: var(--primary); }
.ai-card-body { padding: 18px; }
.ai-upload-zone {
    border: 2px dashed #b7d9cb;
    border-radius: 16px;
    background: #f4fbf8;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    cursor: pointer;
    transition: border-color .15s ease, background .15s ease;
}
.ai-upload-zone:hover { border-color: var(--primary); background: #ecfdf5; }
.ai-upload-zone i { display: block; font-size: 2rem; color: var(--primary); margin-bottom: 10px; }
.ai-upload-zone strong { display: block; font-size: .95rem; color: var(--gray-900); }
.ai-upload-zone span { display: block; margin-top: 5px; font-size: .78rem; color: var(--gray-500); line-height: 1.4; }
.ai-file-chip {
    display: none;
    align-items: center;
    gap: 10px;
    margin-top: 13px;
    padding: 11px 12px;
    border: 1px solid #c7eadb;
    border-radius: 12px;
    background: #effcf5;
    color: #065f46;
    font-size: .8rem;
    font-weight: 700;
}
.ai-file-chip i { color: var(--primary); }
.ai-file-chip small { display: block; color: #4f6f63; font-weight: 600; margin-top: 1px; }
.ai-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; margin-top: 16px; }
.ai-note { margin-top: 12px; color: var(--gray-500); font-size: .78rem; line-height: 1.5; }
.ai-alert { display: none; margin-top: 14px; padding: 11px 12px; border-radius: 12px; font-size: .82rem; font-weight: 700; }
.ai-alert.ok { display: block; color: #047857; background: #ecfdf5; border: 1px solid #bbf7d0; }
.ai-alert.err { display: block; color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; }

.ai-preview-empty {
    min-height: 290px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--gray-400);
    padding: 30px;
}
.ai-preview-empty i { display: block; font-size: 2.4rem; margin-bottom: 11px; color: var(--gray-300); }
.ai-summary { display: none; grid-template-columns: repeat(4, minmax(100px, 1fr)); gap: 10px; margin-bottom: 14px; }
.ai-summary-card {
    border-radius: 14px;
    padding: 12px;
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
}
.ai-summary-card strong { display: block; font-size: 1.35rem; line-height: 1; color: var(--gray-900); }
.ai-summary-card span { display: block; margin-top: 5px; color: var(--gray-500); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
.ai-table-wrap { display: none; overflow-x: auto; border: 1px solid var(--gray-200); border-radius: 14px; }
.ai-table { width: 100%; border-collapse: collapse; font-size: .8rem; }
.ai-table th {
    text-align: left;
    padding: 10px 12px;
    background: var(--gray-50);
    color: var(--gray-500);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--gray-200);
}
.ai-table td { padding: 10px 12px; border-bottom: 1px solid var(--gray-100); color: var(--gray-700); vertical-align: top; }
.ai-table tr:last-child td { border-bottom: 0; }
.ai-student-name { font-weight: 800; color: var(--gray-900); }
.ai-muted { color: var(--gray-400); font-size: .74rem; margin-top: 2px; }
.ai-pill { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; font-size: .68rem; font-weight: 800; }
.ai-pill.success { background: #dcfce7; color: #15803d; }
.ai-pill.error { background: #fee2e2; color: #dc2626; }
.ai-pill.pending { background: #eff6ff; color: #1d4ed8; }

.ai-confirm-bar {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
    padding: 14px 18px;
    background: #eff6ff;
    border: 1.5px solid #bfdbfe;
    border-radius: 14px;
}
.ai-confirm-bar p { margin: 0; font-size: .85rem; color: #1e40af; font-weight: 700; }
.ai-confirm-bar p span { font-weight: 400; color: #3b82f6; }
.ai-confirm-actions { display: flex; gap: 10px; }
.btn-confirm { background: var(--primary); color: #fff; border: 0; padding: 9px 20px; border-radius: 10px; font-size: .85rem; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 7px; }
.btn-confirm:hover { background: #15803d; }
.btn-confirm:disabled { background: var(--gray-300); color: var(--gray-500); cursor: not-allowed; }
.btn-cancel-import { background: #fff; color: var(--gray-600); border: 1.5px solid var(--gray-200); padding: 9px 16px; border-radius: 10px; font-size: .85rem; font-weight: 700; cursor: pointer; }
.btn-cancel-import:hover { background: var(--gray-50); }

.ai-current-list { max-height: 420px; overflow: auto; }
.ai-current-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--gray-100);
    font-size: .8rem;
}
.ai-current-row:last-child { border-bottom: 0; }
.ai-preview-row { display: grid; grid-template-columns: 1fr 260px; gap: 14px; align-items: start; }

.ai-no-section {
    background: #fef3c7;
    border: 1px solid #fde68a;
    border-radius: var(--radius-lg);
    padding: 32px;
    text-align: center;
    color: #92400e;
}
.ai-no-section i { font-size: 2.5rem; display: block; margin-bottom: 12px; }

@media (max-width: 980px) {
    .ai-grid { grid-template-columns: 1fr; }
    .ai-preview-row { grid-template-columns: 1fr; }
    .ai-summary { grid-template-columns: repeat(2, minmax(100px, 1fr)); }
}
</style>

<div class="ai-wrap">
<% if (!teacher.section_id) { %>
    <div class="ai-no-section">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <h3>No Section Assigned</h3>
        <p>Please contact the administrator to assign your grade level and section before importing students.</p>
    </div>
<% } else { %>
    <div class="ai-hero">
        <div>
            <h2><i class="fa-solid fa-file-arrow-up"></i> Import Students</h2>
            <p>Upload your Excel or CSV file. The imported rows will preview here immediately.</p>
        </div>
        <div class="ai-hero-actions">
            <a href="/export/template/<%= isShs ? 'shs_student' : 'student' %>" class="btn"><i class="fa-solid fa-download"></i> Download Template</a>
            <a href="/admin/adviser-students" class="btn"><i class="fa-solid fa-users"></i> Student List</a>
        </div>
    </div>

    <div class="ai-badges">
        <span class="ai-badge school">
            <img class="ai-school-logo" src="<%= teacher.school_logo || ((typeof settings !== 'undefined' && settings && settings.system_logo) ? settings.system_logo : '/uploads/logos/system-logo.png') %>" alt="" onerror="this.onerror=null;this.src='/uploads/logos/system-logo.png';">
            <%= teacher.school_name || 'N/A' %>
        </span>
        <span class="ai-badge grade"><i class="fa-solid fa-layer-group"></i> <%= teacher.grade_name || 'N/A' %></span>
        <span class="ai-badge section"><i class="fa-solid fa-users"></i> <%= teacher.section_name || 'N/A' %></span>
        <span class="ai-badge" style="background:#f0f9ff;color:#0369a1;"><i class="fa-solid fa-user-graduate"></i> <%= students.length %> current student<%= students.length !== 1 ? 's' : '' %></span>
    </div>

    <div class="ai-grid">
        <div>
            <div class="ai-card">
                <div class="ai-card-header">
                    <h3><i class="fa-solid fa-cloud-arrow-up"></i> Upload File</h3>
                </div>
                <div class="ai-card-body">
                    <input type="file" id="adviserImportFile" accept=".xlsx,.xls,.csv" style="display:none;">
                    <label for="adviserImportFile" class="ai-upload-zone">
                        <span>
                            <i class="fa-solid fa-file-excel"></i>
                            <strong>Choose Excel or CSV file</strong>
                            <span>Supported: .xlsx, .xls, .csv. File name will show below after selection.</span>
                        </span>
                    </label>

                    <div class="ai-file-chip" id="fileChip">
                        <i class="fa-solid fa-file-circle-check"></i>
                        <div>
                            <div id="fileName">No file selected</div>
                            <small id="fileSize"></small>
                        </div>
                    </div>

                    <div class="ai-actions">
                        <button class="btn btn-secondary" type="button" onclick="clearImportFile()">Clear File</button>
                    </div>

                    <div class="ai-note">
                        School, grade, and section columns in the file are ignored here. Every row is assigned to your current advisory section.
                    </div>
                    <div id="importAlert" class="ai-alert"></div>
                </div>
            </div>

        </div>

        <div>
        <div class="ai-confirm-bar" id="confirmBar">
            <p><i class="fa-solid fa-circle-info"></i> Preview ready — <span id="confirmSummaryText">review the rows below</span>. Nothing has been saved yet.</p>
            <div class="ai-confirm-actions">
                <button class="btn-cancel-import" type="button" onclick="cancelImport()"><i class="fa-solid fa-xmark"></i> Cancel</button>
                <button class="btn-confirm" type="button" id="confirmBtn" onclick="confirmImport()"><i class="fa-solid fa-check"></i> Confirm &amp; Save Import</button>
            </div>
        </div>

        <div class="ai-preview-row">
        <div class="ai-card">
            <div class="ai-card-header">
                <h3><i class="fa-solid fa-list-check"></i> Uploaded Student Preview</h3>
            </div>
            <div class="ai-card-body">
                <div class="ai-preview-empty" id="previewEmpty">
                    <div>
                        <i class="fa-solid fa-file-import"></i>
                        <strong>No file uploaded yet</strong>
                        <div style="margin-top:5px;font-size:.82rem;">Select a file on the left — a preview of each row will appear here automatically.</div>
                    </div>
                </div>

                <div class="ai-summary" id="previewSummary">
                    <div class="ai-summary-card"><strong id="sumTotal">0</strong><span>Total Rows</span></div>
                    <div class="ai-summary-card"><strong id="sumImported">0</strong><span>Ready to Add</span></div>
                    <div class="ai-summary-card"><strong id="sumUpdated">0</strong><span>Will Update</span></div>
                    <div class="ai-summary-card"><strong id="sumSkipped">0</strong><span>Skipped</span></div>
                </div>

                <div class="ai-table-wrap" id="previewTableWrap">
                    <table class="ai-table">
                        <thead>
                            <tr>
                                <th>Row</th>
                                <th>Student</th>
                                <th>LRN</th>
                                <th>Sex</th>
                                <th>Guardian Contact</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody id="previewBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="ai-card">
            <div class="ai-card-header">
                <h3><i class="fa-solid fa-users"></i> Current Students</h3>
            </div>
            <div class="ai-card-body ai-current-list">
                <% if (!students.length) { %>
                    <div style="color:var(--gray-400);font-size:.83rem;text-align:center;padding:20px;">No students in this section yet.</div>
                <% } else { students.slice(0, 80).forEach(function(s) { %>
                    <div class="ai-current-row">
                        <div>
                            <div class="ai-student-name"><%= s.lastname %>, <%= s.firstname %><%= s.middlename ? ' ' + s.middlename.charAt(0).toUpperCase() + '.' : '' %></div>
                            <div class="ai-muted">LRN: <%= s.lrn || '-' %></div>
                        </div>
                        <span class="ai-pill success"><i class="fa-solid fa-circle-check"></i> <%= s.status || 'active' %></span>
                    </div>
                <% }); } %>
            </div>
        </div>
        </div><!-- end ai-preview-row -->
        </div><!-- end confirm+preview wrapper -->
    </div>
<% } %>
</div>

<script>
var fileInput = document.getElementById('adviserImportFile');
var fileChip = document.getElementById('fileChip');
var importAlert = document.getElementById('importAlert');
var confirmBar = document.getElementById('confirmBar');
var confirmBtn = document.getElementById('confirmBtn');
var working = false;
var hasPendingImport = false;

function esc(v) {
    return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function formatBytes(b) {
    b = Number(b||0);
    if (b < 1024) return b+' B';
    if (b < 1048576) return (b/1024).toFixed(1)+' KB';
    return (b/1048576).toFixed(2)+' MB';
}
function setAlert(type, msg) {
    importAlert.className = 'ai-alert '+(type||'');
    importAlert.innerHTML = msg||'';
}

function clearImportFile() {
    if (!fileInput) return;
    fileInput.value = '';
    fileChip.style.display = 'none';
    setAlert('','');
    hideConfirmBar();
    clearPreview();
    hasPendingImport = false;
}

function hideConfirmBar() {
    confirmBar.style.display = 'none';
}

function showConfirmBar(willImport, willUpdate) {
    var total = willImport + willUpdate;
    var parts = [];
    if (willImport) parts.push(willImport + ' new student' + (willImport !== 1 ? 's' : '') + ' to add');
    if (willUpdate) parts.push(willUpdate + ' existing to update');
    document.getElementById('confirmSummaryText').textContent = parts.join(', ') || 'no valid rows to import yet';
    // Always show the bar once a preview has loaded, so the Confirm button is visible.
    confirmBar.style.display = 'flex';
    confirmBtn.disabled = total === 0;
    confirmBtn.innerHTML = total > 0
        ? '<i class="fa-solid fa-check"></i> Confirm &amp; Save Import (' + total + ')'
        : '<i class="fa-solid fa-check"></i> Confirm &amp; Save Import';
}

function clearPreview() {
    document.getElementById('previewEmpty').style.display = '';
    document.getElementById('previewSummary').style.display = 'none';
    document.getElementById('previewTableWrap').style.display = 'none';
}

function cancelImport() {
    clearImportFile();
    setAlert('', '');
}

if (fileInput) {
    fileInput.addEventListener('change', function() {
        var file = fileInput.files[0];
        if (!file) { clearImportFile(); return; }
        document.getElementById('fileName').textContent = file.name;
        document.getElementById('fileSize').textContent = formatBytes(file.size);
        fileChip.style.display = 'flex';
        hasPendingImport = false;
        hideConfirmBar();
        clearPreview();
        setAlert('ok','<i class="fa-solid fa-spinner fa-spin"></i> Reading file...');
        setTimeout(submitPreview, 150);
    });
}

function submitPreview() {
    if (working) return;
    var file = fileInput && fileInput.files[0];
    if (!file) { setAlert('err','Please choose a file first.'); return; }

    var fd = new FormData();
    fd.append('file', file);
    working = true;
    setAlert('ok','Parsing <strong>'+esc(file.name)+'</strong>...');

    fetch('/admin/adviser-import-students', { method:'POST', body: fd })
        .then(function(r){ return r.json().then(function(d){ if(!r.ok) throw d; return d; }); })
        .then(function(data) {
            var willImport = data.willImport || 0;
            var willUpdate = data.willUpdate || 0;
            var skipped = (data.errors || []).length;
            renderPreview(data, true);
            showConfirmBar(willImport, willUpdate);
            hasPendingImport = (willImport + willUpdate) > 0;
            if (hasPendingImport) {
                setAlert('ok', '<i class="fa-solid fa-eye"></i> Preview ready — <strong>' + (willImport+willUpdate) + '</strong> row(s) ready to save, <strong>' + skipped + '</strong> skipped. Click <strong>Confirm & Save Import</strong> to proceed.');
            } else if (skipped) {
                setAlert('err', 'All ' + skipped + ' row(s) were skipped. Fix the errors and re-upload.');
            } else {
                setAlert('err', 'No valid rows found in this file.');
            }
        })
        .catch(function(err){ setAlert('err', esc((err&&err.error)||'Failed to read file.')); hideConfirmBar(); })
        .finally(function(){
            working = false;
        });
}

function confirmImport() {
    if (working || !hasPendingImport) return;
    working = true;
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
    setAlert('ok','<i class="fa-solid fa-spinner fa-spin"></i> Saving students...');

    fetch('/admin/adviser-confirm-import', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({}) })
        .then(function(r){ return r.json().then(function(d){ if(!r.ok) throw d; return d; }); })
        .then(function(data) {
            renderPreview(data, false);
            hideConfirmBar();
            hasPendingImport = false;
            var skipped = (data.errors || []).length;
            setAlert(
                skipped && !data.imported && !data.updated ? 'err' : 'ok',
                '<i class="fa-solid fa-circle-check"></i> Done! Imported <strong>'+(data.imported||0)+'</strong>, updated <strong>'+(data.updated||0)+'</strong>, skipped <strong>'+skipped+'</strong>.'
            );
            if (data.imported || data.updated) {
                document.getElementById('sumImported').textContent = data.imported || 0;
                document.getElementById('sumUpdated').textContent = data.updated || 0;
            }
        })
        .catch(function(err){ setAlert('err', esc((err&&err.error)||'Save failed. Please try again.')); })
        .finally(function(){
            working = false;
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<i class="fa-solid fa-check"></i> Confirm & Save Import';
        });
}

function renderPreview(data, isPending) {
    var rows = data.students || [];
    document.getElementById('previewEmpty').style.display = 'none';
    document.getElementById('previewSummary').style.display = 'grid';
    document.getElementById('previewTableWrap').style.display = 'block';
    document.getElementById('sumTotal').textContent = data.total || rows.length || 0;
    document.getElementById('sumImported').textContent = isPending ? (data.willImport || 0) : (data.imported || 0);
    document.getElementById('sumUpdated').textContent = isPending ? (data.willUpdate || 0) : (data.updated || 0);
    document.getElementById('sumSkipped').textContent = (data.errors || []).length;

    var body = document.getElementById('previewBody');
    body.innerHTML = rows.map(function(row) {
        var isPend = row.status === 'pending';
        var isErr = row.status === 'error';
        var pillClass = isPend ? 'pending' : (isErr ? 'error' : 'success');
        var icon = isPend ? 'fa-clock' : (isErr ? 'fa-triangle-exclamation' : 'fa-circle-check');
        var fullName = [row.lastname, row.firstname].filter(Boolean).join(', ');
        if (row.middlename) fullName += ' ' + String(row.middlename).charAt(0).toUpperCase() + '.';
        return '<tr>' +
            '<td>'+esc(row.row||'-')+'</td>' +
            '<td><div class="ai-student-name">'+esc(fullName||'-')+'</div>'+(row.message?'<div class="ai-muted">'+esc(row.message)+'</div>':'')+'</td>' +
            '<td>'+esc(row.lrn||'-')+'</td>' +
            '<td>'+esc(row.gender||'-')+'</td>' +
            '<td>'+esc(row.guardian_contact||'-')+'</td>' +
            '<td><span class="ai-pill '+pillClass+'"><i class="fa-solid '+icon+'"></i> '+esc(row.action||(isErr?'Skipped':'OK'))+'</span></td>' +
        '</tr>';
    }).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--gray-400);padding:28px;">No preview rows.</td></tr>';
}
</script>

<%- include('partials/footer') %>
