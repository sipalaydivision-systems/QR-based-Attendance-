<%- include('partials/header') %>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-bell"></i> Notifications</h1>
    </div>
</div>

<!-- 2-Day Consecutive Absence Alerts -->
<div class="alert-card">
    <div class="alert-card-header">
        <i class="fa-solid fa-triangle-exclamation"></i> 2-Day Consecutive Absence Alerts <span class="alert-count" id="absenceCount">0</span>
    </div>

    <div class="sub-title"><i class="fa-solid fa-user-graduate"></i> Students</div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Grade</th>
                    <th>Section</th>
                    <th>LRN</th>
                    <th>Days Absent</th>
                    <th>Adviser</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="absStudents">
                <tr><td colspan="7" class="text-center text-muted">No consecutive absences detected</td></tr>
            </tbody>
        </table>
    </div>

    <div class="sub-title" style="margin-top:1.25rem;"><i class="fa-solid fa-chalkboard-user"></i> Teachers</div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Employee ID</th>
                    <th>School</th>
                </tr>
            </thead>
            <tbody id="absTeachers">
                <tr><td colspan="3" class="text-center text-muted">No consecutive absences detected</td></tr>
            </tbody>
        </table>
    </div>
</div>

<% if (user && user.role === 'super_admin') { %>
<!-- User Activity -->
<div class="activity-card">
    <h3><i class="fa-solid fa-user-clock"></i> User Activity</h3>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>School</th>
                    <th>Last Login</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="userActivity">
                <tr><td colspan="5" class="text-center text-muted">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<script>
function escapeHtml(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}
function normalizeLogo(logo) {
    var value = String(logo || '').trim();
    if (!value) return '';
    if (/^data:image\//i.test(value) || /^https?:\/\//i.test(value)) return value;
    value = value.replace(/^public\//, '');
    return value.charAt(0) === '/' ? value : '/' + value;
}
function schoolLogo(flag, size) {
    var safeSize = size || 28;
    var school = flag.school_name || 'School';
    var initial = school.charAt(0).toUpperCase();
    var src = normalizeLogo(flag.school_logo);
    if (!src) {
        return '<span style="width:' + safeSize + 'px;height:' + safeSize + 'px;border-radius:8px;background:var(--primary-bg);color:var(--primary);display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;flex-shrink:0;">' + escapeHtml(initial) + '</span>';
    }
    return '<img src="' + escapeHtml(src) + '" alt="" style="width:' + safeSize + 'px;height:' + safeSize + 'px;border-radius:8px;object-fit:cover;border:1px solid var(--border);background:#fff;flex-shrink:0;">';
}
function buildAdviserAction(flag) {
    var adviser = flag.adviser || 'Assigned adviser';
    var adviserEmail = (flag.adviser_email || '').trim();
    var adviserContact = (flag.adviser_contact || '').trim();
    var schoolContact = (flag.school_contact || '').trim();
    var email = '';
    var phone = '';
    if (adviserEmail && /@/.test(adviserEmail)) email = adviserEmail;
    if (!email && adviserContact && /@/.test(adviserContact)) email = adviserContact;
    if (!email && schoolContact && /@/.test(schoolContact)) email = schoolContact;
    if (adviserContact && !/@/.test(adviserContact)) phone = adviserContact.replace(/[^0-9+]/g, '');
    if (!phone && schoolContact && !/@/.test(schoolContact)) phone = schoolContact.replace(/[^0-9+]/g, '');
    var student = flag.name || ((flag.lastname || '') + ', ' + (flag.firstname || '')).trim() || 'Student';
    var gradeSection = (flag.grade_name || '-') + ' / ' + (flag.section_name || '-');
    var body = 'Please check absence alert for ' + student + ' (' + gradeSection + ', LRN: ' + (flag.lrn || '-') + '). Total days absent: ' + (flag.absent_days || 2) + '.';
    var encodedBody = encodeURIComponent(body);
    var encodedTitle = encodeURIComponent('Absence Alert - ' + student);
    var actions = [];
    if (phone) {
        actions.push('<a class="btn btn-sm btn-outline" href="tel:' + encodeURIComponent(phone) + '">Call Adviser</a>');
        actions.push('<a class="btn btn-sm btn-outline" href="sms:' + encodeURIComponent(phone) + '?body=' + encodedBody + '">Send SMS</a>');
    }
    if (email) {
        actions.push('<a class="btn btn-sm btn-outline" href="mailto:' + encodeURIComponent(email) + '?subject=' + encodedTitle + '&body=' + encodedBody + '">Send Email</a>');
    }
    if (actions.length) return '<div style="display:flex;flex-wrap:wrap;gap:6px;">' + actions.join('') + '</div>';
    return '<button class="btn btn-sm btn-secondary" type="button" onclick="alert(\'No adviser contact saved for ' + escapeHtml(adviser) + '. Please update the school/adviser contact details first.\')">Please contact adviser</button>';
}
async function loadNotifications() {
    try {
        // Load absence flags
        var flagRes = await fetch('/api/absence-flags');
        var flags = await flagRes.json();
        var studentFlags = flags.filter(function(f){return f.person_type==='student';});
        var teacherFlags = flags.filter(function(f){return f.person_type==='teacher';});
        document.getElementById('absenceCount').textContent = flags.length;

        if (studentFlags.length > 0) {
            document.getElementById('absStudents').innerHTML = studentFlags.map(function(f){
                return '<tr><td><div style="display:flex;align-items:center;gap:8px;"><span>' + schoolLogo(f, 28) + '</span><div><strong>' + escapeHtml(f.name || f.person_name || '-')
                    +'</strong><div style="font-size:0.72rem;color:var(--gray-500);margin-top:2px;">'+ escapeHtml(f.school_name || '-') +'</div></div></div></td>'
                    +'<td>' + escapeHtml(f.grade_name || '-') + '</td>'
                    +'<td>' + escapeHtml(f.section_name || '-') + '</td>'
                    +'<td><span class="lrn-badge">' + escapeHtml(f.lrn || '-') + '</span></td>'
                    +'<td><span class="badge badge-absent">' + escapeHtml(f.absent_days || 2) + ' days</span></td>'
                    +'<td>' + escapeHtml(f.adviser || '-') + '</td>'
                    +'<td>' + buildAdviserAction(f) + '</td></tr>';
            }).join('');
        } else {
            document.getElementById('absStudents').innerHTML = '<tr><td colspan="7" class="text-center text-muted">No consecutive absences detected</td></tr>';
        }
        if (teacherFlags.length > 0) {
            document.getElementById('absTeachers').innerHTML = teacherFlags.map(function(f){
                return '<tr><td><div style="display:flex;align-items:center;gap:8px;"><span>' + schoolLogo(f, 24) + '</span><strong>'+(f.name || f.person_name || '-')
                    +'</strong></div></td><td>'+(f.employee_id||'-')
                    +'</td><td><span class="school-code">'+(f.school_name||'-')+'</span></td></tr>';
            }).join('');
        } else {
            document.getElementById('absTeachers').innerHTML = '<tr><td colspan="3" class="text-center text-muted">No consecutive absences detected</td></tr>';
        }
    } catch(e) { console.error('Absence flags:', e); }

    var userActivityEl = document.getElementById('userActivity');
    if (userActivityEl) {
        try {
            // Load user activity
            var userRes = await fetch('/api/users');
            var users = await userRes.json();
            if (users.length > 0) {
                userActivityEl.innerHTML = users.map(function(u){
                    var roleClass = u.role === 'super_admin' ? 'super-admin' : u.role === 'principal' ? 'principal' : u.role === 'superintendent' ? 'superintendent' : 'asst-superintendent';
                    var roleName = u.role.replace(/_/g, ' ');
                    var isOnline = u.last_login && (Date.now() - new Date(u.last_login).getTime() < 300000);
                    return '<tr><td><strong>'+u.fullname+'</strong></td>'+
                        '<td><span class="role-badge '+roleClass+'">'+ roleName +'</span></td>'+
                        '<td>'+(u.school_name||'Division Office')+'</td>'+
                        '<td>'+(u.last_login ? new Date(u.last_login).toLocaleString() : 'Never')+'</td>'+
                        '<td><span class="status-dot '+(isOnline?'online':'offline')+'"></span>'+(isOnline?'Active':'Offline')+'</td></tr>';
                }).join('');
            }
        } catch(e) { console.error('User activity:', e); }
    }
}
loadNotifications();
setInterval(loadNotifications, 5000);
</script>

<div class="live-indicator"><div class="live-dot"></div> Live</div>
<%- include('partials/footer') %>
