<%- include('partials/header') %>

<style>
/* Daily Schedule — visual timeline */
.schedule-timeline {
    display: flex;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--gray-200);
    margin-bottom: 20px;
    background: var(--gray-50);
}
.tl-seg {
    flex: 1;
    padding: 14px 12px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.7);
}
.tl-seg:last-child { border-right: none; }
.tl-seg.am    { background: rgba(10,154,106,0.10); }
.tl-seg.lunch { background: rgba(221,122,11,0.12); flex: 0.75; }
.tl-seg.pm    { background: rgba(37,99,235,0.10); }
.tl-seg.end   { background: var(--gray-100); flex: 0.85; }
.tl-phase { font-size: 0.68rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--gray-700); }
.tl-time  { font-size: 0.98rem; font-weight: 700; color: var(--gray-900); margin-top: 4px; }
.tl-note  { font-size: 0.67rem; color: var(--gray-500); margin-top: 3px; line-height: 1.35; }
.tl-seg.am .tl-phase    { color: var(--primary-dark); }
.tl-seg.lunch .tl-phase { color: var(--warning); }
.tl-seg.pm .tl-phase    { color: #2563eb; }

/* Field hints */
.lbl-hint { font-weight: 600; font-size: 0.66rem; color: var(--warning); background: rgba(221,122,11,0.12); padding: 1px 7px; border-radius: 999px; margin-left: 6px; vertical-align: middle; }
.fld-note { display: block; margin-top: 5px; font-size: 0.72rem; color: var(--gray-500); line-height: 1.4; }
.fld-note strong { color: var(--gray-700); }

/* Scenario cards */
.schedule-scenarios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(225px, 1fr));
    gap: 12px;
    margin-top: 22px;
}
.scenario-card {
    border: 1px solid var(--gray-200);
    border-left: 4px solid var(--gray-300);
    border-radius: var(--radius-lg);
    padding: 13px 15px;
    background: #fff;
}
.scenario-card.ok     { border-left-color: var(--success); }
.scenario-card.late   { border-left-color: var(--warning); }
.scenario-card.half   { border-left-color: #2563eb; }
.scenario-card.absent { border-left-color: var(--danger); }
.scenario-title { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 0.84rem; color: var(--gray-800); margin-bottom: 7px; }
.scenario-title i { color: var(--gray-400); }
.scenario-card.ok .scenario-title i     { color: var(--success); }
.scenario-card.late .scenario-title i   { color: var(--warning); }
.scenario-card.half .scenario-title i   { color: #2563eb; }
.scenario-card.absent .scenario-title i { color: var(--danger); }
.scenario-flow { font-size: 0.78rem; color: var(--gray-600); line-height: 1.6; }
.scenario-flow strong { color: var(--gray-900); }
.s-pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 0.67rem; font-weight: 700; }
.s-pill.present { background: rgba(22,163,74,0.12); color: var(--success); }
.s-pill.late    { background: rgba(221,122,11,0.14); color: var(--warning); }
.s-pill.half    { background: rgba(37,99,235,0.12); color: #2563eb; }
.s-pill.absent  { background: rgba(220,38,38,0.10); color: var(--danger); }

@media (max-width: 640px) {
    .schedule-timeline { flex-direction: column; }
    .tl-seg { border-right: none; border-bottom: 1px solid var(--gray-200); }
    .tl-seg:last-child { border-bottom: none; }
}
</style>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-gear"></i> Settings</h1>
    </div>
</div>

<!-- System Logo -->
<div class="settings-section">
    <h3><i class="fa-solid fa-image"></i> System Logo</h3>
    <p class="section-desc">Upload a logo for the system. This appears on printed QR codes, reports, and the mobile app header — the mobile app updates automatically, no reinstall needed.</p>
    <div style="display:flex; align-items:center; gap:1.25rem;">
        <div class="logo-preview" id="logoPreview">
            <i class="fa-solid fa-school" style="font-size:2rem;color:var(--gray-300);"></i>
        </div>
        <div>
            <input type="file" id="logoFile" accept="image/*" style="display:none">
            <button class="btn btn-primary btn-sm" onclick="document.getElementById('logoFile').click()"><i class="fa-solid fa-upload"></i> Upload Logo</button>
            <button class="btn btn-secondary btn-sm" onclick="removeLogo()">Remove</button>
            <p style="margin-top:0.5rem;font-size:0.75rem;color:var(--gray-400);">PNG/JPG, max 2MB</p>
        </div>
    </div>
</div>

<!-- Mobile Dashboard School Art -->
<div class="settings-section">
    <h3><i class="fa-solid fa-school-flag"></i> Mobile Dashboard School Art</h3>
    <p class="section-desc">Upload the school illustration shown inside the mobile dashboard greeting card. Mobile devices update from the server automatically after refresh.</p>
    <div style="display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap;">
        <div class="logo-preview" id="mobileSchoolArtPreview" style="width:150px;height:96px;border-radius:18px;">
            <i class="fa-solid fa-school-flag" style="font-size:2rem;color:var(--gray-300);"></i>
        </div>
        <div>
            <input type="file" id="mobileSchoolArtFile" accept="image/*" style="display:none">
            <button class="btn btn-primary btn-sm" onclick="document.getElementById('mobileSchoolArtFile').click()"><i class="fa-solid fa-upload"></i> Upload School Art</button>
            <button class="btn btn-secondary btn-sm" onclick="removeMobileSchoolArt()">Remove</button>
            <p style="margin-top:0.5rem;font-size:0.75rem;color:var(--gray-400);">PNG/JPG/WebP, max 2MB. Transparent artwork works best.</p>
        </div>
    </div>
</div>

<!-- AI Daily Report Notification Icon -->
<div class="settings-section">
    <h3><i class="fa-solid fa-robot"></i> AI Daily Report Icon</h3>
    <p class="section-desc">The icon shown on the mobile 7:00 PM "SDO Sipalay AI · Daily Report" notification. Upload a robot icon (or any image) and mobile devices update automatically after refresh. Square PNG with transparent background works best.</p>
    <div style="display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap;">
        <div class="logo-preview" id="aiReportIconPreview" style="width:96px;height:96px;border-radius:18px;">
            <i class="fa-solid fa-robot" style="font-size:2rem;color:var(--gray-300);"></i>
        </div>
        <div>
            <input type="file" id="aiReportIconFile" accept="image/*" style="display:none">
            <button class="btn btn-primary btn-sm" onclick="document.getElementById('aiReportIconFile').click()"><i class="fa-solid fa-upload"></i> Upload Icon</button>
            <button class="btn btn-secondary btn-sm" onclick="removeAiReportIcon()">Remove</button>
            <p style="margin-top:0.5rem;font-size:0.75rem;color:var(--gray-400);">PNG/JPG/WebP, max 2MB. Square transparent PNG recommended.</p>
        </div>
    </div>
</div>

<!-- Daily Schedule & Session Times -->
<div class="settings-section">
    <h3><i class="fa-solid fa-clock"></i> Daily Schedule &amp; Session Times</h3>
    <p class="section-desc">The master clock for the whole system. Every EduTrack Scanner uses these times to decide Present, Late, Half-Day, and Completed. Edit any time and the timeline and scenarios below update instantly.</p>

    <div class="schedule-timeline" id="scheduleTimeline"></div>

    <div class="settings-grid">
        <div class="form-group">
            <label>School Start Time <span class="lbl-hint">on-time line</span></label>
            <input type="time" id="am_time_in_end" class="form-control sched-input" value="07:00">
            <small class="fld-note">On-time start. Scanning before this &mdash; including early arrivals &mdash; counts <strong>PRESENT</strong>.</small>
        </div>
        <div class="form-group">
            <label>AM Late Start Time <span class="lbl-hint">late line</span></label>
            <input type="time" id="am_late_time" class="form-control sched-input" value="07:15">
            <small class="fld-note">A morning first scan at/after this is marked <strong>LATE</strong>.</small>
        </div>
        <div class="form-group">
            <label>Lunch Break Start</label>
            <input type="time" id="lunch_break_start" class="form-control sched-input" value="11:00">
            <small class="fld-note">A Time Out from here until PM start is a <strong>LUNCH OUT</strong> (expected to return).</small>
        </div>
        <div class="form-group">
            <label>PM Session Start</label>
            <input type="time" id="pm_time_in_start" class="form-control sched-input" value="13:00">
            <small class="fld-note">A <em>first</em> scan at/after this counts as <strong>HALF-DAY (PM only)</strong>.</small>
        </div>
        <div class="form-group">
            <label>PM Late Start Time <span class="lbl-hint">PM late line</span></label>
            <input type="time" id="pm_late_time" class="form-control sched-input" value="13:15">
            <small class="fld-note">An afternoon time-in at/after this shows <strong>PM LATE TIME IN</strong>.</small>
        </div>
        <div class="form-group">
            <label>Official School Day End</label>
            <input type="time" id="pm_time_out_end" class="form-control sched-input" value="16:00">
            <small class="fld-note">A Time Out at/after this is a complete <strong>full day</strong>.</small>
        </div>
        <div class="form-group">
            <label>Absence Cutoff Time</label>
            <input type="time" id="absence_cutoff_time" class="form-control sched-input" value="16:00">
            <small class="fld-note">No Time In by this time → counted <strong>ABSENT</strong> for the day.</small>
        </div>
    </div>

    <div class="schedule-scenarios" id="scheduleScenarios"></div>
</div>

<!-- Student Attendance Rules -->
<div class="settings-section">
    <h3><i class="fa-solid fa-user-graduate"></i> Student Attendance Settings</h3>
    <p class="section-desc">How student scans are counted. Students scan once when entering school; lunch, recess, transfers, library visits, and activities never create Time Out records.</p>
    <div class="settings-grid">
        <div class="form-group">
            <label>Late Cutoff Grace (minutes)</label>
            <input type="number" id="late_threshold" class="form-control sched-input" min="0" value="15">
            <small class="fld-note">Minutes of leeway added to School Start before <strong>LATE</strong> applies.</small>
        </div>
        <div class="form-group">
            <label>Student Attendance Rule</label>
            <select id="student_attendance_rule" class="form-control">
                <option value="scan_once_time_in">Single Time In scan marks Present for the school day</option>
            </select>
        </div>
    </div>
</div>

<!-- Teacher Attendance Rules -->
<div class="settings-section">
    <h3><i class="fa-solid fa-chalkboard-user"></i> Teacher Attendance Settings</h3>
    <p class="section-desc">Teacher attendance rules are synchronized to scanners for offline validation. Teachers require Time In and Time Out so reports can calculate working hours.</p>
    <div class="settings-grid">
        <div class="form-group">
            <label>Duty Start Time</label>
            <input type="time" id="teacher_duty_start_time" class="form-control" value="07:00">
        </div>
        <div class="form-group">
            <label>Duty End Time</label>
            <input type="time" id="teacher_duty_end_time" class="form-control" value="16:00">
        </div>
        <div class="form-group">
            <label>Late Arrival Grace (minutes)</label>
            <input type="number" id="teacher_late_threshold" class="form-control" min="0" value="15">
        </div>
        <div class="form-group">
            <label>Teacher Time Out Rule</label>
            <select id="teacher_time_out_rule" class="form-control">
                <option value="required">Time Out is required</option>
            </select>
        </div>
    </div>
</div>

<!-- System Configuration -->
<div class="settings-section">
    <h3><i class="fa-solid fa-sliders"></i> System Configuration</h3>
    <p class="section-desc">General system settings and defaults.</p>
    <div class="settings-grid">
        <div class="form-group">
            <label>Division Name</label>
            <input type="text" id="division_name" class="form-control" placeholder="School Division of Sipalay City">
        </div>
        <div class="form-group">
            <label>System Name</label>
            <input type="text" id="system_name" class="form-control" placeholder="School Attendance System">
        </div>
        <div class="form-group">
            <label>Auto Time-Out (minutes)</label>
            <input type="number" id="auto_timeout" class="form-control" min="0" value="480">
        </div>
        <div class="form-group">
            <label>SMS Notifications</label>
            <select id="sms_enabled" class="form-control">
                <option value="1">Enabled</option>
                <option value="0">Disabled</option>
            </select>
        </div>
        <div class="form-group">
            <label>Attendance Policy</label>
            <input type="text" id="attendance_policy" class="form-control" placeholder="Division attendance policy">
        </div>
    </div>
    <div style="margin-top:1rem;">
        <button class="btn btn-primary" onclick="saveSettings()"><i class="fa-solid fa-floppy-disk"></i> Save All Settings</button>
    </div>
    <div id="settingsMsg" style="margin-top:0.75rem;"></div>
</div>

<!-- Enrollment & Activation -->
<div class="settings-section">
    <h3><i class="fa-solid fa-users-gear"></i> Enrollment &amp; Activation</h3>
    <p class="section-desc">Control how newly imported students and teachers are activated.</p>
    <div class="settings-grid">
        <div class="form-group">
            <label>Auto-Activate on First Scan</label>
            <select id="auto_activate_on_scan" class="form-control">
                <option value="1">Enabled</option>
                <option value="0">Disabled</option>
            </select>
            <small style="color:var(--gray-400);font-size:0.75rem;">When enabled, imported students/teachers become active on their first QR scan.</small>
        </div>
    </div>
    <div style="margin-top:1rem;">
        <h4 style="margin-bottom:0.75rem;">Current Status Counts</h4>
        <div class="status-counts-grid">
            <div class="status-card">
                <span class="status-count" id="inactiveStudentCount">0</span>
                <span class="status-label">Inactive Students</span>
                <small>Imported, not yet scanned</small>
            </div>
            <div class="status-card">
                <span class="status-count" id="inactiveTeacherCount">0</span>
                <span class="status-label">Inactive Teachers</span>
                <small>Imported, not yet scanned</small>
            </div>
            <div class="status-card deleted">
                <span class="status-count" id="deletedStudentCount">0</span>
                <span class="status-label">Deleted Students</span>
                <small>Removed from system</small>
            </div>
            <div class="status-card deleted">
                <span class="status-count" id="deletedTeacherCount">0</span>
                <span class="status-label">Deleted Teachers</span>
