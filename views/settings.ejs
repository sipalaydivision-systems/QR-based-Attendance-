var roleBadgeMap = {
    'super_admin': '<span class="badge" style="background:#dbeafe;color:#1e40af;">Super Admin</span>',
    'superintendent': '<span class="badge" style="background:#ede9fe;color:#5b21b6;">Superintendent</span>',
    'asst_superintendent': '<span class="badge" style="background:#fce7f3;color:#9d174d;">Asst Superintendent</span>',
    'principal': '<span class="badge" style="background:#fee2e2;color:#991b1b;">Principal</span>'
};

async function loadAdmins() {
    try {
        var res = await fetch('/api/users');
        var data = await res.json();
        if (data.length === 0) {
            document.getElementById('adminsBody').innerHTML = '<tr><td colspan="6" class="text-center text-muted">No admin accounts</td></tr>';
            return;
        }
        document.getElementById('adminsBody').innerHTML = data.map(function(u){
            var roleBadge = roleBadgeMap[u.role] || u.role;
            var school = u.school_name || 'All Schools';
            var lastLogin = u.last_login ? new Date(u.last_login).toLocaleString() : '-';
            var actions = '<button class="action-btn edit" onclick="editAdmin('+u.id+')" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>';
            if (u.role !== 'super_admin' || data.filter(function(x){return x.role==='super_admin'}).length > 1) {
                actions += ' <button class="action-btn delete" onclick="deleteAdmin('+u.id+')" title="Deactivate"><i class="fa-solid fa-user-slash"></i></button>';
            }
            return '<tr><td>'+u.username+'</td><td>'+u.fullname+'</td><td>'+roleBadge+'</td><td>'+school+'</td><td>'+lastLogin+'</td><td>'+actions+'</td></tr>';
        }).join('');
    } catch(e) { console.error(e); }
}

function openAdminModal(id) {
    document.getElementById('adminModal').style.display = 'flex';
    document.getElementById('adminId').value = '';
    document.getElementById('adminUsername').value = '';
    document.getElementById('adminFullname').value = '';
    document.getElementById('adminEmail').value = '';
    document.getElementById('adminPassword').value = '';
    document.getElementById('adminRole').value = 'principal';
    document.getElementById('adminSchool').value = '';
    document.getElementById('adminMsg').innerHTML = '';
    document.getElementById('adminModalTitle').textContent = 'Add Admin';
    document.getElementById('pwdHint').textContent = '(required)';
}

function closeAdminModal() {
    document.getElementById('adminModal').style.display = 'none';
}

async function editAdmin(id) {
    var res = await fetch('/api/users');
    var users = await res.json();
    var u = users.find(function(x){ return x.id === id; });
    if (!u) return;
    openAdminModal();
    document.getElementById('adminModalTitle').textContent = 'Edit Admin';
    document.getElementById('pwdHint').textContent = '(leave blank to keep current)';
    document.getElementById('adminId').value = u.id;
    document.getElementById('adminUsername').value = u.username;
    document.getElementById('adminFullname').value = u.fullname;
    document.getElementById('adminEmail').value = u.email || '';
    document.getElementById('adminRole').value = u.role;
    document.getElementById('adminSchool').value = u.school_id || '';
}

async function saveAdmin() {
    var id = document.getElementById('adminId').value;
    var body = {
        username: document.getElementById('adminUsername').value.trim(),
        fullname: document.getElementById('adminFullname').value.trim(),
        email: document.getElementById('adminEmail').value.trim(),
        password: document.getElementById('adminPassword').value,
        role: document.getElementById('adminRole').value,
        school_id: document.getElementById('adminSchool').value || null
    };
    if (!body.username || !body.fullname) { alert('Username and full name are required.'); return; }
    if (!id && !body.password) { alert('Password is required for new admin.'); return; }
    try {
        var url = id ? '/api/users/' + id : '/api/users';
        var method = id ? 'PUT' : 'POST';
        var res = await fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
        var data = await res.json();
        if (data.success) {
            closeAdminModal();
            loadAdmins();
        } else {
            document.getElementById('adminMsg').innerHTML = '<div class="alert alert-danger">'+(data.error || 'Failed to save.')+'</div>';
        }
    } catch(e) { console.error(e); }
}

async function deleteAdmin(id) {
    if (!confirm('Deactivate this admin account? The user will no longer be able to sign in.')) return;
    await fetch('/api/users/' + id, { method: 'DELETE' });
    loadAdmins();
}

async function loadSchoolDropdowns() {
    try {
        var res = await fetch('/api/schools');
        var schools = await res.json();
        var active = schools.filter(function(s){ return s.status === 'active'; });
        var opts = '<option value="">All Schools (Division)</option>' + active.map(function(s){
            return '<option value="'+s.id+'">'+s.name+'</option>';
        }).join('');
        document.getElementById('holidayScope').innerHTML = opts;
        var adminOpts = '<option value="">All Schools</option>' + active.map(function(s){
            return '<option value="'+s.id+'">'+s.name+'</option>';
        }).join('');
        document.getElementById('adminSchool').innerHTML = adminOpts;
    } catch(e) {}
}

