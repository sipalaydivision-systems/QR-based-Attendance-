        <button class="btn btn-danger btn-sm" onclick="bulkPurgeDeleted()"><i class="fa-solid fa-trash-can"></i> Permanently Remove Deleted</button>
    </div>
    <div id="activationMsg" style="margin-top:0.75rem;"></div>
</div>

<!-- Holiday Management -->
<div class="settings-section">
    <h3><i class="fa-solid fa-calendar-days"></i> Holiday Management</h3>
    <p class="section-desc">Manage holidays and non-school days. Attendance will not be required on weekends (Sat/Sun) and listed holidays.</p>
    <div class="holiday-form">
        <div class="form-group" style="margin-bottom:0;">
            <label>Date</label>
            <input type="date" id="holidayDate" class="form-control">
        </div>
        <div class="form-group" style="margin-bottom:0;flex:1;">
            <label>Holiday Name</label>
            <input type="text" id="holidayName" class="form-control" placeholder="e.g. Rizal Day">
        </div>
        <div class="form-group" style="margin-bottom:0;">
            <label>Type</label>
            <select id="holidayType" class="form-control">
                <option value="1">Regular Holiday</option>
                <option value="0">Special Non-Working</option>
                <option value="2">Class Suspension</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom:0;">
            <label>Scope</label>
            <select id="holidayScope" class="form-control">
                <option value="">All Schools (Division)</option>
            </select>
        </div>
        <button class="btn btn-primary" id="holidayAddBtn" onclick="addHoliday()"><i class="fa-solid fa-calendar-plus"></i> Add Holiday</button>
    </div>
    <div id="holidayMsg" style="margin-top:12px;"></div>
    <div id="holidaysEmpty" style="text-align:center; padding:2rem; color:var(--gray-400);">
        <i class="fa-solid fa-calendar-check" style="font-size:2rem; margin-bottom:0.5rem; display:block;"></i>
        No holidays configured yet. Weekends (Saturday &amp; Sunday) are automatically treated as non-school days.
    </div>
    <div class="table-responsive" id="holidaysTableWrap" style="display:none;">
        <table class="data-table">
            <thead><tr><th>Holiday Name</th><th>Date</th><th>Type</th><th>Scope</th><th>Actions</th></tr></thead>
            <tbody id="holidaysBody"></tbody>
        </table>
    </div>
</div>

<!-- Admin Accounts -->
<div class="settings-section">
    <h3><i class="fa-solid fa-user-shield"></i> Admin Accounts</h3>
    <div style="display:flex; justify-content:flex-end; margin-bottom:1rem;">
        <button class="btn btn-primary" onclick="openAdminModal()">+ Add Admin</button>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead><tr><th>Username</th><th>Full Name</th><th>Role</th><th>School</th><th>Last Login</th><th>Actions</th></tr></thead>
            <tbody id="adminsBody">
                <tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Admin Modal -->
<div class="modal-overlay" id="adminModal" style="display:none;">
    <div class="modal-content" style="max-width:500px;">
        <div class="modal-header">
            <h3 id="adminModalTitle">Add Admin</h3>
            <button class="modal-close" onclick="closeAdminModal()">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="adminId">
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="adminUsername" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" id="adminFullname" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="adminEmail" class="form-control">
            </div>
            <div class="form-group">
                <label>Password <span id="pwdHint" style="font-weight:normal;color:var(--gray-400);font-size:0.75rem;">(required)</span></label>
                <input type="password" id="adminPassword" class="form-control">
            </div>
            <div class="form-group">
                <label>Role</label>
                <select id="adminRole" class="form-control">
                    <option value="super_admin">Super Admin</option>
                    <option value="superintendent">Superintendent</option>
                    <option value="asst_superintendent">Asst. Superintendent</option>
                    <option value="principal">Principal</option>
                </select>
            </div>
            <div class="form-group">
                <label>Assigned School</label>
                <select id="adminSchool" class="form-control">
                    <option value="">All Schools</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeAdminModal()">Cancel</button>
            <button class="btn btn-primary" onclick="saveAdmin()">Save</button>
        </div>
        <div id="adminMsg" style="padding:0 1.5rem 1rem;"></div>
    </div>
</div>

<script>
var settingKeys = [
    'system_name',
    'division_name',
    'am_time_in_end',
    'am_late_time',
    'lunch_break_start',
    'pm_time_in_start',
    'pm_late_time',
    'absence_cutoff_time',
    'late_threshold',
    'student_attendance_rule',
    'teacher_duty_start_time',
    'teacher_duty_end_time',
    'teacher_late_threshold',
    'teacher_time_out_rule',
    'pm_time_out_end',
    'auto_timeout',
    'attendance_policy',
    'sms_enabled',
    'auto_activate_on_scan'
];
async function loadSettings() {
    try {
        var res = await fetch('/api/settings');
        var data = await res.json();
        if (Array.isArray(data)) {
            data.forEach(function(s) {
                var el = document.getElementById(s.setting_key);
                if (el) el.value = s.setting_value;
            });
        } else {
            Object.keys(data).forEach(function(k) {
                var el = document.getElementById(k);
                if (el) el.value = data[k];
            });
        }
    } catch(e) { console.error(e); }
    renderSchedulePreview();
}

// ---- Live schedule preview (timeline + scenarios) ----
function schedTime(id, fallback) {
    var el = document.getElementById(id);
    var v = (el && el.value) ? el.value : fallback;
    return v.length >= 5 ? v.slice(0, 5) : fallback;
}
function to12(hhmm) {
    var p = hhmm.split(':');
    var h = parseInt(p[0], 10);
    var m = p[1] || '00';
    var ampm = h >= 12 ? 'PM' : 'AM';
    var h12 = h % 12; if (h12 === 0) h12 = 12;
    return h12 + ':' + m + ' ' + ampm;
}
function addMin(hhmm, mins) {
    var p = hhmm.split(':');
    var t = parseInt(p[0], 10) * 60 + parseInt(p[1], 10) + (parseInt(mins, 10) || 0);
    t = ((t % 1440) + 1440) % 1440;
    var h = Math.floor(t / 60), m = t % 60;
    return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
}
function tlSeg(cls, phase, time, note) {
    return '<div class="tl-seg ' + cls + '"><div class="tl-phase">' + phase + '</div>' +
        '<div class="tl-time">' + time + '</div><div class="tl-note">' + note + '</div></div>';
}
function scenCard(cls, icon, title, flow) {
    return '<div class="scenario-card ' + cls + '"><div class="scenario-title">' +
        '<i class="fa-solid ' + icon + '"></i>' + title + '</div>' +
        '<div class="scenario-flow">' + flow + '</div></div>';
}
function renderSchedulePreview() {
    var start  = schedTime('am_time_in_end', '07:00');
    var lunch  = schedTime('lunch_break_start', '11:00');
    var pmIn   = schedTime('pm_time_in_start', '13:00');
    var pmLate = schedTime('pm_late_time', '13:15');
    var end    = schedTime('pm_time_out_end', '16:00');
    var absent = schedTime('absence_cutoff_time', '16:00');
    var grace  = (document.getElementById('late_threshold') || {}).value || '0';
    // Explicit AM Late Start Time is the late line; otherwise school start + grace.
    var amLateEl = document.getElementById('am_late_time');
    var lateLine = (amLateEl && amLateEl.value) ? amLateEl.value.slice(0, 5) : addMin(start, grace);

    var tl = document.getElementById('scheduleTimeline');
    if (tl) {
        tl.innerHTML =
            tlSeg('am', 'AM Session', to12(start), 'Early OK &middot; Late after ' + to12(lateLine)) +
            tlSeg('lunch', 'Lunch', to12(lunch), 'Time Out here = Lunch Out') +
            tlSeg('pm', 'PM Session', to12(pmIn), 'Half-Day &middot; PM Late after ' + to12(pmLate)) +
            tlSeg('end', 'Dismissal', to12(end), 'Time Out here = full day');
    }

    var sc = document.getElementById('scheduleScenarios');
    if (sc) {
        sc.innerHTML =
            scenCard('ok', 'fa-mug-hot', 'Early arrival',
                'First scan <strong>' + to12(addMin(start, -25)) + '</strong> (before ' + to12(start) + ', allowed) &rarr; <span class="s-pill present">PRESENT</span>') +
            scenCard('ok', 'fa-circle-check', 'On-time student',
                'First scan <strong>' + to12(start) + '</strong> &rarr; <span class="s-pill present">PRESENT</span>') +
            scenCard('late', 'fa-clock', 'Late student',
                'First scan <strong>' + to12(addMin(lateLine, 30)) + '</strong> (after ' + to12(lateLine) + ') &rarr; <span class="s-pill late">LATE</span>') +
            scenCard('ok', 'fa-utensils', 'Lunch out &amp; back',
                'Out <strong>' + to12(addMin(lunch, 10)) + '</strong>, back <strong>' + to12(addMin(pmIn, -20)) + '</strong> &rarr; <span class="s-pill present">WELCOME BACK</span>, stays full day') +
            scenCard('half', 'fa-circle-half-stroke', 'Afternoon only',
                'First scan <strong>' + to12(addMin(pmIn, 5)) + '</strong> &rarr; <span class="s-pill half">HALF-DAY</span> (PM only)') +
            scenCard('late', 'fa-clock', 'Late PM return',
                'Back from lunch <strong>' + to12(addMin(pmLate, 20)) + '</strong> (after ' + to12(pmLate) + ') &rarr; <span class="s-pill late">PM LATE TIME IN</span>') +
            scenCard('half', 'fa-right-from-bracket', 'Early dismissal',
                'Leaves <strong>' + to12(addMin(end, -30)) + '</strong>, no return &rarr; <span class="s-pill half">HALF-DAY</span>') +
            scenCard('absent', 'fa-user-xmark', 'No-show',
                'No scan by <strong>' + to12(absent) + '</strong> &rarr; <span class="s-pill absent">ABSENT</span>');
    }
}

async function saveSettings() {
    var settings = {};
    settingKeys.forEach(function(k) {
        var el = document.getElementById(k);
        if (el) settings[k] = el.value;
    });
    var res = await fetch('/api/settings', { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(settings) });
    var result = await res.json();
    document.getElementById('settingsMsg').innerHTML = result.success
        ? '<div class="alert alert-success">Settings saved successfully!</div>'
        : '<div class="alert alert-danger">Failed to save settings.</div>';
    setTimeout(function(){ document.getElementById('settingsMsg').innerHTML = ''; }, 3000);
}

async function loadHolidays() {
    try {
        var res = await fetch('/api/holidays');
        var data = await res.json();
        if (data.length > 0) {
            document.getElementById('holidaysEmpty').style.display = 'none';
            document.getElementById('holidaysTableWrap').style.display = '';
            document.getElementById('holidaysBody').innerHTML = data.map(function(h){
                var dateStr = h.holiday_date ? h.holiday_date.substring(0,10) : '';
                var typeBadge = holidayTypeBadge(h.is_national);
                var scope = h.school_name || 'All Schools (Division)';
                return '<tr><td><strong>'+escapeHolidayHtml(h.name)+'</strong></td><td>'+escapeHolidayHtml(dateStr)+'</td><td>'+typeBadge+'</td><td>'+escapeHolidayHtml(scope)+'</td>'+
                    '<td><button class="action-btn delete" onclick="deleteHoliday('+h.id+')" title="Delete"><i class="fa-solid fa-trash-can"></i></button></td></tr>';
            }).join('');
        } else {
            document.getElementById('holidaysEmpty').style.display = '';
            document.getElementById('holidaysTableWrap').style.display = 'none';
        }
    } catch(e) { console.error(e); }
}

function escapeHolidayHtml(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function holidayTypeBadge(type) {
    var value = String(type);
    if (value === '2') {
        return '<span class="badge" style="background:#dbeafe;color:#1d4ed8;">Class Suspension</span>';
    }
    if (value === '1') {
        return '<span class="badge badge-active">Regular Holiday</span>';
    }
    return '<span class="badge" style="background:#fef3c7;color:#92400e;">Special Non-Working</span>';
}

async function addHoliday() {
    var name = document.getElementById('holidayName').value.trim();
    var date = document.getElementById('holidayDate').value;
    var isNational = document.getElementById('holidayType').value;
    var schoolId = document.getElementById('holidayScope').value;
    var button = document.getElementById('holidayAddBtn');
    var msg = document.getElementById('holidayMsg');
    if (!name || !date) { alert('Please enter holiday name and date.'); return; }
    button.disabled = true;
    button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving &amp; notifying…';
    msg.innerHTML = '';
    try {
        var res = await fetch('/api/holidays', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ name: name, holiday_date: date, is_national: isNational, school_id: schoolId || null })
        });
        var result = await res.json();
        if (!res.ok || result.error) throw new Error(result.error || 'Unable to add holiday.');
        var guardianPushes = Number(result.guardian_push_count || 0);
        var edutrackPushes = Number(result.edutrack_push_count || 0);
        var parentInboxes = Number(result.parent_inbox_count || 0);
        msg.innerHTML = '<div class="alert alert-success"><strong><i class="fa-solid fa-circle-check"></i> Holiday saved and synchronized.</strong><br>' +
            parentInboxes + ' parent inbox' + (parentInboxes === 1 ? '' : 'es') + ', ' +
            guardianPushes + ' Guardian push' + (guardianPushes === 1 ? '' : 'es') + ', and ' +
            edutrackPushes + ' EduTrack mobile push' + (edutrackPushes === 1 ? '' : 'es') + '.</div>';
        document.getElementById('holidayName').value = '';
        document.getElementById('holidayDate').value = '';
        await loadHolidays();
    } catch (error) {
        msg.innerHTML = '<div class="alert alert-danger"><strong>Holiday was not saved.</strong> ' + escapeHolidayHtml(error.message || 'Please try again.') + '</div>';
    } finally {
        button.disabled = false;
        button.innerHTML = '<i class="fa-solid fa-calendar-plus"></i> Add Holiday';
    }
}

async function deleteHoliday(id) {
    if (!confirm('Delete this holiday?')) return;
    var msg = document.getElementById('holidayMsg');
    try {
        var res = await fetch('/api/holidays/' + id, { method: 'DELETE' });
        var result = await res.json();
        if (!res.ok || result.error) throw new Error(result.error || 'Unable to delete holiday.');
        msg.innerHTML = '<div class="alert alert-success">Holiday and its parent notice were removed.</div>';
        await loadHolidays();
    } catch (error) {
        msg.innerHTML = '<div class="alert alert-danger">' + escapeHolidayHtml(error.message || 'Unable to delete holiday.') + '</div>';
    }
}

