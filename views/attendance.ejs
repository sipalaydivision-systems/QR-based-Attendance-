<%- include('partials/header') %>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-clipboard-list"></i> Attendance Records</h1>
    </div>
    <div class="page-actions">
        <a href="#" class="btn btn-success" id="exportAttBtn"><i class="fa-solid fa-file-csv"></i> Export CSV</a>
    </div>
</div>

<div class="filter-bar">
    <% if (user.role !== 'adviser') { %>
    <div class="filter-item">
        <label>Type</label>
        <select id="attType">
            <option value="student">Students</option>
            <option value="teacher">Teachers</option>
        </select>
    </div>
    <% } %>
    <div class="filter-item">
        <label>Date</label>
        <input type="date" id="attDate" value="<%= todayDate %>">
    </div>
    <% if (user.role !== 'adviser') { %>
    <div class="filter-item">
        <label>School</label>
        <select id="attSchool">
            <option value="">All Schools</option>
            <% schools.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="filter-item">
        <label>Grade</label>
        <select id="attGrade">
            <option value="">All Grades</option>
        </select>
    </div>
    <% } %>
    <div class="filter-item">
        <label>Search</label>
        <input type="text" id="attSearch" placeholder="Search by name...">
    </div>
    <button class="btn-filter" onclick="loadAttendance()"><i class="fa-solid fa-magnifying-glass"></i> Filter</button>
</div>

<div class="results-header">
    <span class="record-count" id="attCount">0 record(s)</span>
</div>

<div class="card">
    <style>
        .attendance-scan-cell {
            min-width: 104px;
        }
        .scan-stack {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .scan-entry {
            display: inline-flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
            line-height: 1.1;
            white-space: nowrap;
        }
        .scan-time {
            font-weight: 700;
            color: var(--dark);
            font-size: 0.82rem;
        }
        .scan-label {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 3px 7px;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.01em;
            background: #eef2ff;
            color: #1d4ed8;
        }
        .scan-label-in { background: #dcfce7; color: #047857; }
        .scan-label-out { background: #fee2e2; color: #b91c1c; }
        .scan-label-lunch { background: #ffedd5; color: #c2410c; }
        .scan-label-return { background: #dbeafe; color: #1d4ed8; }
        .scan-label-complete { background: #d1fae5; color: #065f46; }
        .scan-empty {
            color: var(--gray-400);
            font-weight: 700;
        }
    </style>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>LRN / ID</th>
                    <th>School</th>
                    <th>Grade / Section</th>
                    <th>AM Time In</th>
                    <th>AM Time Out</th>
                    <th>PM Time In</th>
                    <th>PM Time Out</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="attendanceBody"></tbody>
        </table>
    </div>
</div>

<script>
var isAdviser = <%= user.role === 'adviser' ? 'true' : 'false' %>;

function esc(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function scanLabelClass(label) {
    var raw = String(label || '').toUpperCase();
    if (raw.indexOf('COMPLETED') >= 0) return 'scan-label-complete';
    if (raw.indexOf('LUNCH') >= 0) return 'scan-label-lunch';
    if (raw.indexOf('RETURN') >= 0 || raw.indexOf('WELCOME') >= 0) return 'scan-label-return';
    if (raw.indexOf('OUT') >= 0) return 'scan-label-out';
    if (raw.indexOf('IN') >= 0 || raw.indexOf('LATE') >= 0) return 'scan-label-in';
    return '';
}

function renderScanCell(items) {
    if (!items || !items.length) return '<span class="scan-empty">-</span>';
    return '<div class="scan-stack">' + items.map(function(item) {
        var time = item.time_display || (item.time ? new Date(item.time).toLocaleTimeString() : '-');
        var label = item.status || item.label || '';
        return '<span class="scan-entry">' +
            '<span class="scan-time">' + esc(time) + '</span>' +
            '<span class="scan-label ' + scanLabelClass(label) + '">' + esc(label || 'SCAN') + '</span>' +
            '</span>';
    }).join('') + '</div>';
}

async function loadAttendance() {
    var date = document.getElementById('attDate').value;
    var typeEl = document.getElementById('attType');
    var schoolEl = document.getElementById('attSchool');
    var type = typeEl ? typeEl.value : 'student';
    var school = schoolEl ? schoolEl.value : '';
    var search = document.getElementById('attSearch').value;
    var params = new URLSearchParams({ date: date });
    if (!isAdviser) {
        params.append('type', type);
        if (school) params.append('school', school);
    }

    var res = await fetch('/api/attendance?' + params);
    var data = await res.json();

    if (search) {
        var q = search.toLowerCase();
        data = data.filter(function(r){ return (r.person_name||'').toLowerCase().indexOf(q) >= 0; });
    }
    document.getElementById('attCount').textContent = data.length + ' record(s)';

    document.getElementById('attendanceBody').innerHTML = data.map(function(r) {
        var rawStatus = String(r.status || '').toLowerCase();
        var statusClass = rawStatus === 'present' ? 'badge-active'
            : rawStatus === 'late' ? 'badge-late'
            : rawStatus === 'half_day' ? 'badge-half-day'
            : 'badge-inactive';
        var statusText = r.attendance_status || formatStatusLabel(r.status, r.late_half_day);
        var scans = r.scan_summary || {};
        return '<tr>' +
            '<td><strong>' + esc(r.person_name || 'N/A') + '</strong></td>' +
            '<td>' + esc(r.lrn || r.employee_id || '-') + '</td>' +
            '<td><span class="school-code">' + esc(r.school_name || '-') + '</span></td>' +
            '<td>' + esc(r.grade_name || '-') + (r.section_name ? ' / ' + esc(r.section_name) : '') + '</td>' +
            '<td class="attendance-scan-cell">' + renderScanCell(scans.am_time_in) + '</td>' +
            '<td class="attendance-scan-cell">' + renderScanCell(scans.am_time_out) + '</td>' +
            '<td class="attendance-scan-cell">' + renderScanCell(scans.pm_time_in) + '</td>' +
            '<td class="attendance-scan-cell">' + renderScanCell(scans.pm_time_out) + '</td>' +
            '<td><span class="badge ' + statusClass + '">' + esc(statusText) + '</span></td>' +
            '</tr>';
    }).join('') || '<tr><td colspan="9"><div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-clipboard-list" style="font-size:2.5rem;color:var(--gray-300);"></i></div><h4>No attendance records found</h4><p>No records for the selected date and filters.</p></div></td></tr>';

    var exportParams = new URLSearchParams({ date: date, end_date: date, type: type });
    if (!isAdviser && school) exportParams.append('school', school);
    document.getElementById('exportAttBtn').href = '/export/report?' + exportParams;
}

loadAttendance();
setInterval(loadAttendance, 3000);

document.getElementById('attDate').addEventListener('change', loadAttendance);
var attTypeEl = document.getElementById('attType');
if (attTypeEl) attTypeEl.addEventListener('change', loadAttendance);
var attSchoolEl = document.getElementById('attSchool');
if (attSchoolEl) attSchoolEl.addEventListener('change', loadAttendance);
</script>

<div class="live-indicator"><div class="live-dot"></div> Live</div>
<%- include('partials/footer') %>
