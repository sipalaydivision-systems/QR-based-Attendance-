<%- include('partials/header') %>

<style>
:root { --dash-gap: 18px; }

/* The white "floating" app-shell look (soft background, floating sidebar,
   transparent topbar, neat cards) is provided globally by the body.theme-clean
   theme in public/css/style.css — applied to every super_admin page. This
   block only carries dashboard-specific layout/rhythm on top of that. */

/* ---- Dashboard v2 rhythm ---- */
.dashboard-v2 { display: grid; gap: var(--dash-gap); }
.dashboard-v2 > * { margin-bottom: 0 !important; }
#schoolMapCard { margin-top: 0; margin-bottom: 0; overflow: hidden; }
.welcome-banner { margin-bottom: 0; }
.dashboard-toolbar { margin-bottom: 0 !important; }
.dashboard-toolbar h2 { font-weight: 700; }
#nonSchoolDayBanner.non-school-banner { margin-bottom: 0; }
.stats-grid { margin-bottom: 0; }
.dash-analytics-grid, .card + .card { margin-top: 0; margin-bottom: 0; }

.dashboard-kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(155px, 1fr));
    gap: 14px;
}
.dashboard-kpi-grid .stat-card {
    min-height: 108px;
    padding: 18px;
    border-left: none !important;
}
.dashboard-kpi-grid .stat-subline {
    color: var(--gray-400);
    font-size: 0.72rem;
    font-weight: 700;
    margin-top: 1px;
}
@media (max-width: 1280px) { .dashboard-kpi-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }
@media (max-width: 760px) { .dashboard-kpi-grid { grid-template-columns: 1fr; } }

/* ---- Card header icon: filled circular badge, matches stat-card language ---- */
.dash-card-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
    background: var(--primary-bg); color: var(--primary) !important;
    font-size: 0.8125rem;
}
.dash-card-icon.danger { background: #fee2e2; color: var(--danger) !important; }

/* ---- Stat card border-left modifiers (scoped here; matches existing style.css naming) ---- */
.stat-card.stat-scanners  { border-left: 3px solid #059669; }
.stat-card.stat-halfday   { border-left: 3px solid #ea580c; }
.stat-card.stat-flagged   { border-left: 3px solid #dc2626; }
.stat-card.stat-inactive  { border-left: 3px solid var(--gray-400); }
.stat-icon-wrap { width: 52px; height: 52px; }

/* ---- Alert-style accent for the flagged-students card ---- */
#flaggedCard.card { border-left: 3px solid var(--danger); }

.dash-primary-grid {
    display: grid; gap: 16px;
    grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.72fr);
    align-items: stretch;
}
.dash-side-stack { display: grid; gap: 16px; align-content: start; }
.dash-analytics-grid {
    display: grid; gap: 16px;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.75fr);
}
@media (max-width: 1100px) {
    .dash-primary-grid, .dash-analytics-grid { grid-template-columns: 1fr; }
}
.dash-chart-wrap { position: relative; height: 250px; }
.dash-chart-wrap.compact { height: 218px; }
.dash-donut-center {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    text-align: center; pointer-events: none;
}
.dash-donut-center .dc-val { font-size: 1.75rem; font-weight: 800; color: var(--gray-900); line-height: 1; }
.dash-donut-center .dc-lbl { font-size: 0.6875rem; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 3px; }
.dash-chart-legend { display: flex; justify-content: center; gap: 18px; margin-top: 14px; flex-wrap: wrap; }
.dash-legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--gray-600); font-weight: 500; }
.dash-legend-dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; flex-shrink: 0; }
.scanner-status-wrap { display: flex; flex-direction: column; gap: 4px; min-width: 132px; }
.scanner-status-pill {
    display: inline-flex; align-items: center; gap: 6px; width: fit-content;
    padding: 5px 9px; border-radius: 999px; font-size: 0.72rem; font-weight: 800;
    border: 1px solid transparent; white-space: nowrap;
}
.scanner-status-pill.active { color: #047857; background: #dcfce7; border-color: #bbf7d0; }
.scanner-status-pill.active::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%; background: #16a34a;
    animation: dashScannerPulse 1.6s ease-in-out infinite;
}
@keyframes dashScannerPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(22,163,74,0.45); }
    50% { box-shadow: 0 0 0 4px rgba(22,163,74,0); }
}
.scanner-status-pill.idle { color: #b45309; background: #fef3c7; border-color: #fde68a; }
.scanner-status-pill.offline { color: #b91c1c; background: #fee2e2; border-color: #fecaca; }
.scanner-status-meta { color: var(--gray-500); font-size: 0.68rem; line-height: 1.25; }

/* ---- Sipalay City school map ---- */
#dashSchoolMap {
    height: clamp(500px, 56vh, 640px);
    min-height: 460px;
    border: 1px solid #dbe7f3;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.35);
}
.dash-map-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(248px, 18vw, 294px);
    gap: 16px;
    align-items: stretch;
}
.dash-map-school-list {
    border: 1px solid #e6edf6;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    max-height: clamp(500px, 56vh, 640px);
    overflow-y: auto;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.9);
}
.dash-map-school-item {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 66px;
    padding: 12px 13px;
    border: 0;
    border-bottom: 1px solid #eef3f8;
    background: rgba(255,255,255,0.84);
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.dash-map-school-item:last-child { border-bottom: 0; }
.dash-map-school-item:hover,
.dash-map-school-item:focus-visible {
    background: #f0fdf4;
    box-shadow: inset 3px 0 0 #10b981;
    outline: none;
}
.dash-map-school-item strong {
    display: block;
    color: var(--gray-800);
    font-size: 0.78rem;
    line-height: 1.25;
}
.dash-map-school-item span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--gray-500);
    font-size: 0.68rem;
    font-weight: 700;
}
.dash-map-school-item span::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gray-300);
}
.dash-map-school-item.online span { color: #047857; }
.dash-map-school-item.online span::before { background: #16a34a; }
.dash-map-school-item.offline span { color: #b91c1c; }
.dash-map-school-item.offline span::before { background: #dc2626; }
@media (max-width: 900px) {
    .dash-map-layout { grid-template-columns: 1fr; }
    #dashSchoolMap { height: 420px; min-height: 360px; }
    .dash-map-school-list { max-height: 280px; }
}
.dash-map-pin {
    display: block; width: 16px; height: 16px; border-radius: 50%;
    border: 3px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,0.35);
}
.dash-map-popup { font-family: inherit; min-width: 180px; }
.dash-map-status-popup .leaflet-popup-content-wrapper {
    border-radius: 14px;
    box-shadow: 0 14px 34px rgba(15,23,42,0.24);
}
.dash-map-status-popup .leaflet-popup-content {
    margin: 14px 16px;
}
.dmp-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.dmp-head strong { font-size: 0.85rem; color: var(--gray-900); }
.dmp-row { display: flex; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--gray-600); margin-top: 3px; }
.dmp-row .status-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.dmp-row.online { color: #047857; font-weight: 800; }
.dmp-row.offline { color: #b91c1c; font-weight: 800; }

.dash-alert-list { display: grid; gap: 10px; }
.dash-alert-item {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 10px;
    border: 1px solid #fee2e2;
    border-radius: 14px;
    background: #fffafa;
}
.dash-alert-avatar {
    width: 38px; height: 38px; border-radius: 999px;
    display: grid; place-items: center;
    background: #fee2e2; color: #b91c1c; font-weight: 900;
}
.dash-alert-main strong {
    display: block; color: var(--gray-900); font-size: 0.82rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.dash-alert-main span { display: block; color: var(--gray-500); font-size: 0.72rem; line-height: 1.25; }
.dash-alert-days { color: #dc2626; font-size: 0.68rem; font-weight: 900; text-align: right; }
.dash-empty-mini {
    display: grid; place-items: center; min-height: 126px;
    color: var(--gray-400); text-align: center; font-weight: 700; font-size: 0.82rem;
}
.dash-system-list { display: grid; gap: 11px; }
.dash-system-row {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 11px 0; border-bottom: 1px solid #edf2f7;
}
.dash-system-row:last-child { border-bottom: 0; }
.dash-system-row span {
    display: inline-flex; align-items: center; gap: 9px;
    color: var(--gray-600); font-size: 0.82rem; font-weight: 700;
}
.dash-system-row span i {
    width: 30px; height: 30px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    background: #f1f5f9; color: var(--primary);
}
.dash-system-row strong { color: var(--gray-900); }
</style>

<div class="dashboard-v2">

<!-- Welcome Banner -->
<div class="welcome-banner">
    <div class="wb-left">
        <h2 id="saGreeting">Good morning, <%= user.fullname %></h2>
        <p><i class="fa-solid fa-gauge-high"></i> Division Overview &nbsp;&middot;&nbsp; <span id="saDateLabel"></span></p>
    </div>
    <div class="wb-right">
        <div class="wb-stat">
            <span class="wb-stat-val" id="saWbRate">&mdash;</span>
            <span class="wb-stat-lbl">Today's Rate</span>
        </div>
    </div>
</div>

<!-- Sipalay City School Map -->
<div class="card" id="schoolMapCard">
    <div class="card-header">
        <div>
            <h3 style="margin:0;"><i class="fa-solid fa-map-location-dot dash-card-icon"></i> School Locations &mdash; Sipalay City</h3>
            <p style="margin:4px 0 0;color:var(--gray-500);font-size:0.78rem;">Live scanner status of all mapped schools</p>
        </div>
        <span style="font-size:0.75rem;color:var(--gray-400);" id="mapUnmappedHint"></span>
    </div>
    <div class="dash-map-layout">
        <div id="dashSchoolMap"></div>
        <div class="dash-map-school-list" id="dashMapSchoolList">
            <div class="dash-empty-mini">Loading school locations...</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="dashboard-toolbar">
    <div>
        <h2>Attendance Overview</h2>
        <p>Real-time attendance monitoring dashboard</p>
    </div>
    <div class="dashboard-filters">
        <% if (schools && schools.length > 0) { %>
        <div class="dashboard-filter">
            <i class="fa-solid fa-building-columns"></i>
            <select id="dashSchool">
                <option value="">All Schools</option>
                <% schools.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
            </select>
        </div>
        <% } %>
        <div class="dashboard-filter dashboard-filter-date">
            <i class="fa-solid fa-calendar"></i>
            <input type="date" id="dashDate" value="<%= todayDate %>">
        </div>
    </div>
</div>

<!-- Non-school day banner -->
<div id="nonSchoolDayBanner" class="non-school-banner" style="display:none;">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span id="nonSchoolDayText"></span>
</div>

<!-- KPI Stats -->
<div class="stats-grid dashboard-kpi-grid" id="statsGrid">
    <div class="stat-card stat-schools">
        <div class="stat-icon-wrap indigo"><i class="fa-solid fa-building-columns"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statSchools">—</span>
            <span class="stat-label">Schools</span>
        </div>
    </div>
    <div class="stat-card stat-students">
        <div class="stat-icon-wrap blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statStudents">—</span>
            <span class="stat-label">Active Students</span>
        </div>
    </div>
    <div class="stat-card stat-scanners">
        <div class="stat-icon-wrap green"><i class="fa-solid fa-desktop"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statScanners">—</span>
            <span class="stat-label">Active Scanners</span>
        </div>
    </div>
    <div class="stat-card stat-present">
        <div class="stat-icon-wrap green"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statPresent">—</span>
            <span class="stat-label">Present Today</span>
        </div>
    </div>
    <div class="stat-card stat-halfday">
        <div class="stat-icon-wrap orange"><i class="fa-solid fa-circle-half-stroke"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statHalfDay">&mdash;</span>
            <span class="stat-label">Half-Day</span>
        </div>
    </div>
    <div class="stat-card stat-absent">
        <div class="stat-icon-wrap red"><i class="fa-solid fa-circle-xmark"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statAbsent">—</span>
            <span class="stat-label">Absent Today</span>
        </div>
    </div>
    <div class="stat-card stat-rate">
        <div class="stat-icon-wrap amber"><i class="fa-solid fa-chart-line"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statRate">—</span>
            <span class="stat-label">Attendance Rate</span>
        </div>
    </div>
    <div class="stat-card stat-teachers">
        <div class="stat-icon-wrap blue"><i class="fa-solid fa-chalkboard-user"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statTeachers">—</span>
            <span class="stat-label">Teachers Present</span>
        </div>
    </div>
    <div class="stat-card stat-halfday">
        <div class="stat-icon-wrap orange"><i class="fa-solid fa-right-from-bracket"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statTimedOut">—</span>
            <span class="stat-label">Teacher Time Outs</span>
        </div>
    </div>
    <div class="stat-card stat-flagged">
        <div class="stat-icon-wrap rose"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statFlagged">—</span>
            <span class="stat-label">2-Day Absent</span>
        </div>
    </div>
    <% if (typeof user !== 'undefined' && user && user.role === 'super_admin') { %>
    <div class="stat-card stat-inactive">
        <div class="stat-icon-wrap slate"><i class="fa-solid fa-user-slash"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statInactive">—</span>
            <span class="stat-label">Inactive Students</span>
        </div>
    </div>
    <% } %>
</div>

<!-- Analytics: donut + 7-day trend -->
<div class="dash-analytics-grid">
    <div class="card">
        <div class="card-header"><h3 style="margin:0;"><i class="fa-solid fa-chart-pie dash-card-icon"></i> Today's Attendance Breakdown</h3></div>
        <div style="padding:18px;">
            <div class="dash-chart-wrap">
                <canvas id="donutChart"></canvas>
                <div class="dash-donut-center">
                    <div class="dc-val" id="donutMain">0</div>
                    <div class="dc-lbl" id="donutSub">Present</div>
                </div>
            </div>
            <div class="dash-chart-legend">
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#16a34a;"></span> Present</span>
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#f59e0b;"></span> Late</span>
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#ea580c;"></span> Half-Day</span>
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#dc2626;"></span> Absent</span>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3 style="margin:0;"><i class="fa-solid fa-chart-column dash-card-icon"></i> 7-Day Attendance Trend</h3></div>
        <div style="padding:18px;">
            <div class="dash-chart-wrap"><canvas id="trendChart"></canvas></div>
            <div class="dash-chart-legend">
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#4f46e5;"></span> Students Present</span>
            </div>
        </div>
    </div>
</div>

<div class="dash-analytics-grid">
    <div class="card" id="flaggedPreviewCard">
        <div class="card-header">
            <h3 style="margin:0;color:var(--danger);"><i class="fa-solid fa-bell dash-card-icon danger"></i> Alerts (2-Day Absence)</h3>
            <a href="#flaggedCard" style="font-size:0.75rem;font-weight:800;">View All</a>
        </div>
        <div class="dash-alert-list" id="flaggedPreviewBody">
            <div class="dash-empty-mini">No 2-day absence alerts.</div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3 style="margin:0;"><i class="fa-solid fa-server dash-card-icon"></i> System Overview</h3></div>
        <div class="dash-system-list">
            <div class="dash-system-row"><span><i class="fa-solid fa-desktop"></i> Active Scanners</span><strong id="sysActiveScanners">â€”</strong></div>
            <div class="dash-system-row"><span><i class="fa-solid fa-plug-circle-xmark"></i> Offline Scanners</span><strong id="sysOfflineScanners">â€”</strong></div>
            <div class="dash-system-row"><span><i class="fa-solid fa-circle-half-stroke"></i> Half-Day Records</span><strong id="sysHalfDay">â€”</strong></div>
            <div class="dash-system-row"><span><i class="fa-solid fa-heart-pulse"></i> System Status</span><strong style="color:var(--success);">Healthy</strong></div>
        </div>
    </div>
</div>

<!-- School Breakdown Table -->
<div class="card">
    <div class="card-header">
        <h3 style="margin:0;"><i class="fa-solid fa-table-list dash-card-icon"></i> School Breakdown</h3>
        <span style="font-size:0.75rem;color:var(--gray-400);" id="breakdownDate"></span>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>School</th>
                    <th>Enrollment</th>
                    <th>Present</th>
                    <th>Late</th>
                    <th>Half-Day</th>
                    <th>Absent</th>
                    <th>Student Rate</th>
                    <th>Scanner</th>
                    <th>Teachers</th>
                    <th>Teacher Rate</th>
                </tr>
            </thead>
            <tbody id="schoolBreakdownBody">
                <tr><td colspan="10" class="text-center text-muted" style="padding:32px;">
                    <i class="fa-solid fa-spinner fa-spin" style="margin-right:6px;"></i> Loading...
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- 2-Day Absence Flagged Students -->
<div class="card" id="flaggedCard" style="display:none;">
    <div class="card-header">
        <h3 style="margin:0;color:var(--danger);">
            <i class="fa-solid fa-triangle-exclamation dash-card-icon danger"></i> Students Absent 2+ Consecutive Days
        </h3>
        <span class="badge badge-inactive" id="flaggedCount"></span>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Student Name</th>
                    <th>Grade</th>
                    <th>Section</th>
                    <th>LRN</th>
                    <th>Days Absent</th>
                    <th>Adviser</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="flaggedBody"></tbody>
        </table>
    </div>
</div>

</div>

<div class="live-indicator"><div class="live-dot"></div> Live</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function() {
    var refreshTimer = null;
    var donutChart = null, trendChart = null;
    var trendSig = '', donutSig = '';
    var dashMap = null, schoolMarkers = {}, mapPollTimer = null, mapRotationTimer = null;
    var mappedSchoolFeed = [], mapRotationIndex = -1, mapHovering = false, mapRotationStarted = false;
    var SIPALAY_CENTER = [9.735, 122.405];
    var SIPALAY_BOUNDS = [[9.58, 122.25], [9.94, 122.58]];

    function pad(n) { return String(n).padStart(2, '0'); }

    function ensureDonut() {
        if (donutChart || typeof Chart === 'undefined') return;
        donutChart = new Chart(document.getElementById('donutChart').getContext('2d'), {
            type: 'doughnut',
            data: { labels: ['Present','Late','Half-Day','Absent'],
                datasets: [{ data: [0,0,0,0], backgroundColor: ['#16a34a','#f59e0b','#ea580c','#dc2626'], borderWidth: 0, hoverOffset: 6 }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '68%',
                plugins: { legend: { display: false },
                    tooltip: { callbacks: { label: function(c) {
                        var t = c.dataset.data.reduce(function(a,b){return a+b;},0);
                        var pct = t > 0 ? Math.round((c.parsed/t)*100) : 0;
                        return ' ' + c.label + ': ' + c.parsed + ' (' + pct + '%)';
                    } } } } }
        });
    }

    function ensureTrend() {
        if (trendChart || typeof Chart === 'undefined') return;
        trendChart = new Chart(document.getElementById('trendChart').getContext('2d'), {
            type: 'bar',
            data: { labels: [], datasets: [{ label: 'Present', data: [], backgroundColor: '#4f46e5', borderRadius: 5, barPercentage: 0.6 }] },
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                          y: { beginAtZero: true, ticks: { precision: 0, font: { size: 11 } }, grid: { color: '#f1f5f9' } } } }
        });
    }

    function updateDonut(present, late, halfDay, absent) {
        var s = [present, late, halfDay, absent].join(',');
        if (s === donutSig) return;
        donutSig = s;
        ensureDonut();
        if (!donutChart) return;
        donutChart.data.datasets[0].data = [present, late, halfDay, absent];
        donutChart.update();
        document.getElementById('donutMain').textContent = present;
        document.getElementById('donutSub').textContent = 'of ' + (present + late + halfDay + absent) + ' present';
    }

    async function loadTrend() {
        var date = document.getElementById('dashDate').value;
        var school = document.getElementById('dashSchool') ? document.getElementById('dashSchool').value : '';
        var end = new Date(date + 'T00:00:00');
        var start = new Date(end); start.setDate(start.getDate() - 6);
        var startStr = start.toISOString().slice(0, 10);
        var params = new URLSearchParams({ start_date: startStr, end_date: date, type: 'student' });
        if (school) params.append('school', school);
        try {
            var res = await fetch('/api/reports?' + params, { headers: { 'Accept': 'application/json' } });
            var data = await res.json();
            buildTrend(data.records || [], startStr, date);
        } catch (e) { /* ignore */ }
    }

    function buildTrend(records, start, end) {
        var days = {};
        var d = new Date(start + 'T00:00:00'), endD = new Date(end + 'T00:00:00');
        while (d <= endD) { days[d.toISOString().slice(0,10)] = 0; d.setDate(d.getDate() + 1); }
        records.forEach(function(r) { if (r.time_in && days[r.date] !== undefined) days[r.date]++; });
        var keys = Object.keys(days);
        var labels = keys.map(function(dt) { return new Date(dt + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric' }); });
        var pData = keys.map(function(dt) { return days[dt]; });
        var s = pData.join(',');
        if (s === trendSig) return;
        trendSig = s;
        ensureTrend();
        if (!trendChart) return;
        trendChart.data.labels = labels;
        trendChart.data.datasets[0].data = pData;
        trendChart.update();
    }

    function rateColor(r) {
        return r >= 80 ? 'var(--success)' : r >= 50 ? 'var(--warning)' : 'var(--danger)';
    }

    // Banner greeting
    (function() {
        var h = new Date().getHours();
        var g = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
        document.getElementById('saGreeting').textContent = g + ', <%= user.fullname %>';
        var d = new Date();
        document.getElementById('saDateLabel').textContent = d.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
    })();

    function progressBar(pct) {
        var color = pct >= 80 ? 'green' : pct >= 50 ? 'amber' : 'red';
        return '<div class="progress-bar-wrap" style="min-width:80px;">' +
               '<div class="progress-bar-fill ' + color + '" style="width:' + Math.min(100, pct) + '%"></div></div>';
    }
    function esc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g,'&amp;')
            .replace(/</g,'&lt;')
            .replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;')
            .replace(/'/g,'&#39;');
    }
    function normalizeLogo(logo) {
        var value = String(logo || '').trim();
        if (!value) return '';
        if (/^data:image\//i.test(value) || /^https?:\/\//i.test(value)) return value;
        value = value.replace(/^public\//, '');
        return value.charAt(0) === '/' ? value : '/' + value;
    }
    function logoBadge(logo, name, size) {
        var safeSize = size || 32;
        var initial = (name || 'S').charAt(0).toUpperCase();
        var src = normalizeLogo(logo);
        if (!src) {
            return '<div style="width:' + safeSize + 'px;height:' + safeSize + 'px;border-radius:9px;background:var(--primary-bg);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;flex-shrink:0;">' + initial + '</div>';
        }
        return '<img src="' + src + '" alt="" style="width:' + safeSize + 'px;height:' + safeSize + 'px;border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--border);background:#fff;">';
    }
    function scannerLastSeenText(seconds, value) {
        if (seconds == null && !value) return 'No scanner check-in yet';
        var sec = Math.max(0, Number(seconds || 0));
        if (sec < 60) return sec <= 5 ? 'just now' : sec + 's ago';
        var min = Math.floor(sec / 60);
        if (min < 60) return min + 'm ago';
        var hr = Math.floor(min / 60);
        if (hr < 24) return hr + 'h ago';
        try {
            return new Date(String(value).replace(' ', 'T')).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        } catch (_err) {
            return String(value || 'unknown');
        }
    }
    function scannerStatusCell(s) {
        var total = Number(s.scanner_total || 0);
        var active = Number(s.scanner_active || 0);
        var idle = Number(s.scanner_idle || 0);
        var status = active > 0 ? 'active' : idle > 0 ? 'idle' : 'offline';
        var icon = status === 'active' ? 'fa-circle-check' : status === 'idle' ? 'fa-clock' : 'fa-circle-xmark';
        var label = active > 0
            ? (active + ' / ' + total + ' Active')
            : total > 0
                ? 'Offline'
                : 'No Scanner';
        var meta = total > 0
            ? 'Last seen ' + scannerLastSeenText(s.scanner_last_seen_seconds, s.scanner_last_seen_at)
            : 'Install or assign a desktop scanner';
        if (Number(s.scanner_queued_count || 0) > 0) meta += ' · ' + Number(s.scanner_queued_count || 0) + ' queued';
        if (s.scanner_sync_in_progress) meta += ' · syncing';
        if (s.scanner_app_version) meta += ' · v' + esc(s.scanner_app_version);
        if (s.scanner_device_name) meta += '<br>' + esc(s.scanner_device_name);
        return '<div class="scanner-status-wrap">' +
            '<span class="scanner-status-pill ' + status + '"><i class="fa-solid ' + icon + '"></i>' + esc(label) + '</span>' +
            '<span class="scanner-status-meta">' + meta + '</span>' +
            '</div>';
    }

    function nonSchoolDayMessage(data) {
        var type = data.non_school_day_type || 'Non-school Day';
        var reason = data.non_school_day_reason;
        return 'No classes due to ' + type.toLowerCase() + (reason ? ' - ' + reason : '') + '.';
    }

    async function load() {
        var date   = document.getElementById('dashDate').value;
        var school = document.getElementById('dashSchool') ? document.getElementById('dashSchool').value : '';
        var params = new URLSearchParams({ date: date });
        if (school) params.append('school_id', school);

        try {
            var res  = await fetch('/api/dashboard-data?' + params);
            var data = await res.json();
            if (data.error) return;

            // Non-school day banner
            var banner = document.getElementById('nonSchoolDayBanner');
            if (!data.is_school_day) {
                document.getElementById('nonSchoolDayText').textContent = nonSchoolDayMessage(data);
                banner.style.display = 'flex';
            } else {
                banner.style.display = 'none';
            }

            // KPI cards
            document.getElementById('statSchools').textContent  = data.total_schools;
            document.getElementById('statStudents').textContent = data.active_students;
            var scannerSummary = data.scanner_status_summary || {};
            var scannerEl = document.getElementById('statScanners');
            if (scannerEl) scannerEl.textContent = (scannerSummary.active_scanners || 0) + ' / ' + (scannerSummary.total_scanners || 0);
            var sysActive = document.getElementById('sysActiveScanners');
            var sysOffline = document.getElementById('sysOfflineScanners');
            if (sysActive) sysActive.textContent = scannerSummary.active_scanners || 0;
            if (sysOffline) sysOffline.textContent = Math.max(0, Number(scannerSummary.total_scanners || 0) - Number(scannerSummary.active_scanners || 0));
            document.getElementById('statPresent').textContent  = data.students_present;
            var halfDayEl = document.getElementById('statHalfDay');
            if (halfDayEl) halfDayEl.textContent = data.students_half_day || 0;
            var sysHalfDay = document.getElementById('sysHalfDay');
            if (sysHalfDay) sysHalfDay.textContent = data.students_half_day || 0;
            document.getElementById('statAbsent').textContent   = data.students_absent;
            document.getElementById('statRate').textContent     = data.attendance_rate + '%';
            document.getElementById('saWbRate').textContent     = data.attendance_rate + '%';
            document.getElementById('statTeachers').textContent = data.teachers_present;
            document.getElementById('statTimedOut').textContent = data.teachers_timed_out || data.students_timed_out || 0;
            document.getElementById('statFlagged').textContent  = data.flagged_absent_2day;
            var inactiveEl = document.getElementById('statInactive');
            if (inactiveEl) inactiveEl.textContent = data.inactive_students;

            // Donut: today's attendance breakdown
            updateDonut(data.students_present || 0, data.students_late || 0, data.students_half_day || 0, data.students_absent || 0);

            // Date label
            var dl = document.getElementById('breakdownDate');
            if (dl) {
                var d = new Date(date + 'T00:00:00');
                dl.textContent = d.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            }

            // School breakdown table
            var tbody = document.getElementById('schoolBreakdownBody');
            if (!data.schools || !data.schools.length) {
                tbody.innerHTML = '<tr><td colspan="10"><div class="empty-state"><i class="fa-solid fa-building-columns"></i><h4>No schools found</h4><p>No attendance data available.</p></div></td></tr>';
            } else {
                tbody.innerHTML = data.schools.map(function(s) {
                    var sRate = s.rate;
                    var tRate = s.teacher_rate;
                    return '<tr>' +
                        '<td style="font-weight:600;color:var(--gray-800);">' +
                            '<div style="display:flex;align-items:center;gap:8px;">' +
                            logoBadge(s.logo, s.name, 32) +
                            '<span>' + s.name + '</span></div></td>' +
                        '<td>' + s.enrollment + '</td>' +
                        '<td style="color:var(--success);font-weight:600;">' + s.present + '</td>' +
                        '<td style="color:#d97706;font-weight:600;">' + (s.late || 0) + '</td>' +
                        '<td style="color:#ea580c;font-weight:600;">' + (s.half_day || 0) + '</td>' +
                        '<td style="color:var(--danger);font-weight:600;">' + s.absent + '</td>' +
                        '<td>' +
                            '<div style="display:flex;align-items:center;gap:8px;">' +
                            progressBar(sRate) +
                            '<span style="font-weight:700;font-size:0.8125rem;color:' + rateColor(sRate) + ';min-width:38px;">' + sRate + '%</span>' +
                            '</div>' +
                        '</td>' +
                        '<td>' + scannerStatusCell(s) + '</td>' +
                        '<td>' + s.teachers_present + '<span style="color:var(--gray-400);font-size:0.75rem;"> / ' + s.teachers_total + '</span></td>' +
                        '<td>' +
                            '<div style="display:flex;align-items:center;gap:8px;">' +
                            progressBar(tRate) +
                            '<span style="font-weight:700;font-size:0.8125rem;color:' + rateColor(tRate) + ';min-width:38px;">' + tRate + '%</span>' +
                            '</div>' +
                        '</td>' +
                    '</tr>';
                }).join('');
            }

            // Flagged students
            var flaggedCard = document.getElementById('flaggedCard');
            if (data.flagged_absent_2day > 0) {
                var fc = document.getElementById('flaggedCount');
                if (fc) fc.textContent = data.flagged_absent_2day + ' student(s)';
                flaggedCard.style.display = 'block';
                loadFlagged(date, school);
            } else {
                flaggedCard.style.display = 'none';
            }

        } catch (e) {
            console.error('Dashboard error:', e);
        }
    }

    async function loadFlagged(date, school) {
        var params = new URLSearchParams({ days: 2 });
        if (date) params.append('date', date);
        if (school) params.append('school_id', school);
        try {
            var res  = await fetch('/api/absence-flags?' + params);
            var data = await res.json();
            var tbody = document.getElementById('flaggedBody');
            var previewBody = document.getElementById('flaggedPreviewBody');
            if (!data.length) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">No flagged students.</td></tr>';
                if (previewBody) previewBody.innerHTML = '<div class="dash-empty-mini">No 2-day absence alerts.</div>';
                return;
            }
            function esc(v){ return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
            function contactBtn(s) {
                var email = '';
                var phone = '';
                var adviserEmail = (s.adviser_email || '').trim();
                var adviserContact = (s.adviser_contact || '').trim();
                var schoolContact = (s.school_contact || '').trim();
                if (adviserEmail && /@/.test(adviserEmail)) email = adviserEmail;
                if (!email && adviserContact && /@/.test(adviserContact)) email = adviserContact;
                if (!email && schoolContact && /@/.test(schoolContact)) email = schoolContact;
                if (adviserContact && !/@/.test(adviserContact)) phone = adviserContact.replace(/[^0-9+]/g, '');
                if (!phone && schoolContact && !/@/.test(schoolContact)) phone = schoolContact.replace(/[^0-9+]/g, '');
                var msg = encodeURIComponent('Please check absence alert for ' + (s.lastname + ', ' + s.firstname) + ' (' + (s.grade_name || '-') + ' / ' + (s.section_name || '-') + ', LRN: ' + (s.lrn || '-') + '). Total days absent: ' + (s.absent_days || 2) + '.');
                var actions = [];
                if (phone) {
                    actions.push('<a class="btn btn-sm btn-outline" href="tel:' + encodeURIComponent(phone) + '">Call Adviser</a>');
                    actions.push('<a class="btn btn-sm btn-outline" href="sms:' + encodeURIComponent(phone) + '?body=' + msg + '">Send SMS</a>');
                }
                if (email) {
                    actions.push('<a class="btn btn-sm btn-outline" href="mailto:' + encodeURIComponent(email) + '?subject=' + encodeURIComponent('Absence Alert') + '&body=' + msg + '">Send Email</a>');
                }
                if (actions.length) {
                    return '<div style="display:flex;flex-wrap:wrap;gap:6px;">' + actions.join('') + '</div>';
                }
                return '<button class="btn btn-sm btn-secondary" type="button" onclick="alert(\'No adviser contact details are saved. Please update adviser or school contact information first.\')">Please contact adviser</button>';
            }
            tbody.innerHTML = data.map(function(s, i) {
                return '<tr>' +
                    '<td style="color:var(--gray-400);font-size:0.8125rem;">' + (i+1) + '</td>' +
                    '<td>' +
                        '<div class="student-name-cell">' +
                        '<div class="student-avatar" style="background:#fee2e2;color:#dc2626;">' + s.firstname.charAt(0).toUpperCase() + '</div>' +
                        '<span style="font-weight:600;">' + esc(s.lastname + ', ' + s.firstname) + '</span>' +
                        '</div>' +
                        '<div style="margin-top:4px;font-size:0.75rem;color:var(--gray-500);display:flex;align-items:center;gap:6px;">' + logoBadge(s.school_logo, s.school_name || 'School', 18) + '<span>' + esc(s.school_name || '-') + '</span></div>' +
                    '</td>' +
                    '<td>' + (s.grade_name || '—') + '</td>' +
                    '<td>' + (s.section_name || '—') + '</td>' +
                    '<td><span class="lrn-badge">' + (s.lrn || '—') + '</span></td>' +
                    '<td><span class="badge badge-absent">' + (s.absent_days || 2) + ' days</span></td>' +
                    '<td>' + (s.adviser || '—') + '</td>' +
                    '<td>' + contactBtn(s) + '</td>' +
                '</tr>';
            }).join('');
            if (previewBody) {
                previewBody.innerHTML = data.slice(0, 5).map(function(s) {
                    var fullName = (s.firstname || '') + ' ' + (s.lastname || '');
                    var initial = (s.firstname || s.lastname || 'S').charAt(0).toUpperCase();
                    return '<div class="dash-alert-item">' +
                        '<div class="dash-alert-avatar">' + esc(initial) + '</div>' +
                        '<div class="dash-alert-main">' +
                            '<strong>' + esc(fullName.trim() || 'Student') + '</strong>' +
                            '<span>' + esc((s.grade_name || '-') + ' - ' + (s.section_name || '-') + ' | ' + (s.school_name || '-')) + '</span>' +
                        '</div>' +
                        '<div class="dash-alert-days">' + esc(s.absent_days || 2) + ' Days<br>Absent</div>' +
                    '</div>';
                }).join('');
            }
        } catch (e) { console.error('Flagged error:', e); }
    }

    // Watch changes
    document.getElementById('dashDate').addEventListener('change', function() {
        clearInterval(refreshTimer);
        trendSig = ''; donutSig = '';
        load(); loadTrend();
        refreshTimer = setInterval(load, 5000);
    });
    var schoolEl = document.getElementById('dashSchool');
    if (schoolEl) schoolEl.addEventListener('change', function() {
        clearInterval(refreshTimer);
        trendSig = ''; donutSig = '';
        load(); loadTrend();
        refreshTimer = setInterval(load, 5000);
    });

    // ---- Sipalay City school map ----
    // Independent of the dashDate/dashSchool filters above — the map is a
    // division-wide overview widget showing every school regardless of the
    // selected date (scanner connectivity isn't date-scoped).
    function scannerDotColor(online) { return online ? '#16a34a' : '#dc2626'; }

    function schoolMarkerIcon(online) {
        return L.divIcon({
            className: 'dash-map-marker',
            html: '<span class="dash-map-pin" style="background:' + scannerDotColor(online) + ';"></span>',
            iconSize: [18, 18], iconAnchor: [9, 9]
        });
    }

    function schoolPopupHtml(s) {
        var lastSeen = s.scanner_last_seen_at
            ? scannerLastSeenText(s.scanner_last_seen_seconds, s.scanner_last_seen_at)
            : 'No scanner check-in yet';
        var statusClass = s.online ? 'online' : 'offline';
        var statusText = s.online ? 'Online' : 'Offline';
        return '<div class="dash-map-popup">' +
            '<div class="dmp-head">' + logoBadge(s.logo, s.name, 36) + '<strong>' + esc(s.name) + '</strong></div>' +
            '<div class="dmp-row ' + statusClass + '"><span class="status-dot" style="background:' + scannerDotColor(s.online) + ';"></span> ' + statusText + '</div>' +
            '<div class="dmp-row">Last activity: ' + esc(lastSeen) + '</div>' +
            (s.scanner_device_name ? '<div class="dmp-row">Device: ' + esc(s.scanner_device_name) + '</div>' : '') +
            '</div>';
    }

    function ensureDashMap() {
        if (dashMap || typeof L === 'undefined') return;
        var el = document.getElementById('dashSchoolMap');
        if (!el) return;
        dashMap = L.map('dashSchoolMap', {
            center: SIPALAY_CENTER, zoom: 11, minZoom: 10, maxZoom: 18,
            maxBounds: SIPALAY_BOUNDS, maxBoundsViscosity: 1.0
        });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(dashMap);
    }

    function openSchoolPopupById(id, options) {
        options = options || {};
        var marker = schoolMarkers[id];
        if (!marker || !dashMap) return;
        if (options.pan !== false) dashMap.panTo(marker.getLatLng(), { animate: true, duration: 0.45 });
        marker.openPopup();
    }

    function rotateMapPopup() {
        if (!mappedSchoolFeed.length || mapHovering) return;
        mapRotationIndex = (mapRotationIndex + 1) % mappedSchoolFeed.length;
        openSchoolPopupById(mappedSchoolFeed[mapRotationIndex].id, { pan: true });
    }

    function startMapPopupRotation() {
        if (mapRotationTimer || !mappedSchoolFeed.length) return;
        mapRotationTimer = setInterval(rotateMapPopup, 2000);
        if (!mapRotationStarted) {
            mapRotationStarted = true;
            setTimeout(rotateMapPopup, 450);
        }
    }

    async function loadSchoolMap() {
        ensureDashMap();
        if (!dashMap) return;
        try {
            var res = await fetch('/api/school-map-data');
            if (!res.ok) return;
            var data = await res.json();
            var schools = data.schools || [];
            var unmapped = 0;
            var seenIds = {};
            schools.forEach(function(s) {
                if (s.latitude == null || s.longitude == null) { unmapped++; return; }
                seenIds[s.id] = true;
                if (schoolMarkers[s.id]) {
                    schoolMarkers[s.id].setIcon(schoolMarkerIcon(s.online));
                    schoolMarkers[s.id].setPopupContent(schoolPopupHtml(s));
                } else {
                    var marker = L.marker([s.latitude, s.longitude], { icon: schoolMarkerIcon(s.online) }).addTo(dashMap);
                    marker.bindPopup(schoolPopupHtml(s), {
                        className: 'dash-map-status-popup',
                        closeButton: true,
                        autoPan: true
                    });
                    marker.on('mouseover', function() {
                        mapHovering = true;
                        openSchoolPopupById(s.id, { pan: false });
                    });
                    marker.on('mouseout', function() {
                        setTimeout(function() { mapHovering = false; }, 1200);
                    });
                    schoolMarkers[s.id] = marker;
                }
            });
            Object.keys(schoolMarkers).forEach(function(id) {
                if (!seenIds[id]) { dashMap.removeLayer(schoolMarkers[id]); delete schoolMarkers[id]; }
            });
            var list = document.getElementById('dashMapSchoolList');
            if (list) {
                var mappedSchools = schools.filter(function(s) { return s.latitude != null && s.longitude != null; });
                mappedSchoolFeed = mappedSchools;
                startMapPopupRotation();
                if (!mappedSchools.length) {
                    list.innerHTML = '<div class="dash-empty-mini">No mapped schools yet.</div>';
                } else {
                    list.innerHTML = mappedSchools.map(function(s) {
                        var status = s.online ? 'online' : 'offline';
                        var lastSeen = s.scanner_last_seen_at
                            ? scannerLastSeenText(s.scanner_last_seen_seconds, s.scanner_last_seen_at)
                            : 'No check-in';
                        return '<button type="button" class="dash-map-school-item ' + status + '" data-school-id="' + esc(s.id) + '">' +
                            logoBadge(s.logo, s.name, 32) +
                            '<div style="display:block;min-width:0;">' +
                                '<strong>' + esc(s.name) + '</strong>' +
                                '<span>' + (s.online ? 'Active' : 'Offline') + ' · ' + esc(lastSeen) + '</span>' +
                            '</div>' +
                        '</button>';
                    }).join('');
                    Array.prototype.forEach.call(list.querySelectorAll('.dash-map-school-item'), function(btn) {
                        btn.addEventListener('mouseenter', function() {
                            mapHovering = true;
                            var id = btn.getAttribute('data-school-id');
                            openSchoolPopupById(id, { pan: true });
                        });
                        btn.addEventListener('mouseleave', function() {
                            setTimeout(function() { mapHovering = false; }, 1200);
                        });
                    });
                }
            }
            var hint = document.getElementById('mapUnmappedHint');
            if (hint) hint.textContent = unmapped > 0 ? (unmapped + ' school(s) not yet mapped') : '';
        } catch (e) { console.error('School map error:', e); }
    }

    // Initial load + polling
    load();
    loadTrend();
    refreshTimer = setInterval(load, 5000);
    loadSchoolMap();
    mapPollTimer = setInterval(loadSchoolMap, 5000);
})();
</script>

<%- include('partials/footer') %>

