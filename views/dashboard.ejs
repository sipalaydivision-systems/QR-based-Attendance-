<%- include('partials/header') %>

<style>
.dash-analytics-grid {
    display: grid; gap: 16px; margin: 16px 0;
    grid-template-columns: minmax(300px, 1fr) minmax(0, 1.45fr);
}
@media (max-width: 900px) { .dash-analytics-grid { grid-template-columns: 1fr; } }
.dash-chart-wrap { position: relative; height: 250px; }
.dash-donut-center {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    text-align: center; pointer-events: none;
}
.dash-donut-center .dc-val { font-size: 1.75rem; font-weight: 800; color: var(--gray-900); line-height: 1; }
.dash-donut-center .dc-lbl { font-size: 0.6875rem; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 3px; }
.dash-chart-legend { display: flex; justify-content: center; gap: 18px; margin-top: 14px; flex-wrap: wrap; }
.dash-legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--gray-600); font-weight: 500; }
.dash-legend-dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; flex-shrink: 0; }
</style>

<!-- Welcome Banner -->
<div class="welcome-banner">
    <div class="wb-left">
        <h2 id="saGreeting">Good morning, <%= user.fullname %></h2>
        <p><i class="fa-solid fa-gauge-high"></i> Division Overview &nbsp;&middot;&nbsp; <span id="saDateLabel"></span></p>
    </div>
    <div class="wb-right">
        <div class="wb-stat">
            <span class="wb-stat-val" id="saWbRate">—</span>
            <span class="wb-stat-lbl">Today's Rate</span>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="dashboard-toolbar">
    <div>
        <h2>Attendance Overview</h2>
        <p>Real-time attendance monitoring dashboard</p>
    </div>
    <div class="dashboard-filters">
        <% if (schools && schools.length > 0) { %>
        <div class="dashboard-filter">
            <i class="fa-solid fa-building-columns"></i>
            <select id="dashSchool">
                <option value="">All Schools</option>
                <% schools.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
            </select>
        </div>
        <% } %>
        <div class="dashboard-filter dashboard-filter-date">
            <i class="fa-solid fa-calendar"></i>
            <input type="date" id="dashDate" value="<%= todayDate %>">
        </div>
    </div>
</div>

<!-- Non-school day banner -->
<div id="nonSchoolDayBanner" class="non-school-banner" style="display:none;">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span id="nonSchoolDayText"></span>
</div>

<!-- KPI Stats -->
<div class="stats-grid" id="statsGrid">
    <div class="stat-card stat-schools">
        <div class="stat-icon-wrap indigo"><i class="fa-solid fa-building-columns"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statSchools">—</span>
            <span class="stat-label">Schools</span>
        </div>
    </div>
    <div class="stat-card stat-students">
        <div class="stat-icon-wrap blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statStudents">—</span>
            <span class="stat-label">Active Students</span>
        </div>
    </div>
    <div class="stat-card stat-present">
        <div class="stat-icon-wrap green"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statPresent">—</span>
            <span class="stat-label">Present Today</span>
        </div>
    </div>
    <div class="stat-card" style="border-left:3px solid #ea580c;">
        <div class="stat-icon-wrap orange"><i class="fa-solid fa-circle-half-stroke"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statHalfDay">&mdash;</span>
            <span class="stat-label">Half-Day</span>
        </div>
    </div>
    <div class="stat-card stat-absent">
        <div class="stat-icon-wrap red"><i class="fa-solid fa-circle-xmark"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statAbsent">—</span>
            <span class="stat-label">Absent Today</span>
        </div>
    </div>
    <div class="stat-card stat-rate">
        <div class="stat-icon-wrap amber"><i class="fa-solid fa-chart-line"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statRate">—</span>
            <span class="stat-label">Attendance Rate</span>
        </div>
    </div>
    <div class="stat-card stat-teachers">
        <div class="stat-icon-wrap blue"><i class="fa-solid fa-chalkboard-user"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statTeachers">—</span>
            <span class="stat-label">Teachers Present</span>
        </div>
    </div>
    <div class="stat-card" style="border-left:3px solid #ea580c;">
        <div class="stat-icon-wrap orange"><i class="fa-solid fa-right-from-bracket"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statTimedOut">—</span>
            <span class="stat-label">Teacher Time Outs</span>
        </div>
    </div>
    <div class="stat-card" style="border-left:3px solid #dc2626;">
        <div class="stat-icon-wrap rose"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statFlagged">—</span>
            <span class="stat-label">2-Day Absent</span>
        </div>
    </div>
    <% if (typeof user !== 'undefined' && user && user.role === 'super_admin') { %>
    <div class="stat-card" style="border-left:3px solid var(--gray-400);">
        <div class="stat-icon-wrap slate"><i class="fa-solid fa-user-slash"></i></div>
        <div class="stat-info">
            <span class="stat-number" id="statInactive">—</span>
            <span class="stat-label">Inactive Students</span>
        </div>
    </div>
    <% } %>
</div>

<!-- Analytics: donut + 7-day trend -->
<div class="dash-analytics-grid">
    <div class="card">
        <div class="card-header"><h3 style="margin:0;"><i class="fa-solid fa-chart-pie"></i> Today's Attendance Breakdown</h3></div>
        <div style="padding:18px;">
            <div class="dash-chart-wrap">
                <canvas id="donutChart"></canvas>
                <div class="dash-donut-center">
                    <div class="dc-val" id="donutMain">0</div>
                    <div class="dc-lbl" id="donutSub">Present</div>
                </div>
            </div>
            <div class="dash-chart-legend">
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#16a34a;"></span> Present</span>
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#f59e0b;"></span> Late</span>
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#ea580c;"></span> Half-Day</span>
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#dc2626;"></span> Absent</span>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3 style="margin:0;"><i class="fa-solid fa-chart-column"></i> 7-Day Attendance Trend</h3></div>
        <div style="padding:18px;">
            <div class="dash-chart-wrap"><canvas id="trendChart"></canvas></div>
            <div class="dash-chart-legend">
                <span class="dash-legend-item"><span class="dash-legend-dot" style="background:#4f46e5;"></span> Students Present</span>
            </div>
        </div>
    </div>
</div>

<!-- School Breakdown Table -->
<div class="card">
    <div class="card-header">
        <h3 style="margin:0;"><i class="fa-solid fa-table-list"></i> School Breakdown</h3>
        <span style="font-size:0.75rem;color:var(--gray-400);" id="breakdownDate"></span>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>School</th>
                    <th>Enrollment</th>
                    <th>Present</th>
                    <th>Late</th>
                    <th>Half-Day</th>
                    <th>Absent</th>
                    <th>Student Rate</th>
                    <th>Teachers</th>
                    <th>Teacher Rate</th>
                </tr>
            </thead>
            <tbody id="schoolBreakdownBody">
                <tr><td colspan="9" class="text-center text-muted" style="padding:32px;">
                    <i class="fa-solid fa-spinner fa-spin" style="margin-right:6px;"></i> Loading...
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- 2-Day Absence Flagged Students -->
<div class="card" id="flaggedCard" style="display:none;">
    <div class="card-header">
        <h3 style="margin:0;color:var(--danger);">
            <i class="fa-solid fa-triangle-exclamation"></i> Students Absent 2+ Consecutive Days
        </h3>
        <span class="badge badge-inactive" id="flaggedCount"></span>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Student Name</th>
                    <th>Grade</th>
                    <th>Section</th>
                    <th>LRN</th>
                    <th>Days Absent</th>
                    <th>Adviser</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="flaggedBody"></tbody>
        </table>
    </div>
</div>

<div class="live-indicator"><div class="live-dot"></div> Live</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function() {
    var refreshTimer = null;
    var donutChart = null, trendChart = null;
    var trendSig = '', donutSig = '';

    function pad(n) { return String(n).padStart(2, '0'); }

    function ensureDonut() {
        if (donutChart || typeof Chart === 'undefined') return;
        donutChart = new Chart(document.getElementById('donutChart').getContext('2d'), {
            type: 'doughnut',
            data: { labels: ['Present','Late','Half-Day','Absent'],
                datasets: [{ data: [0,0,0,0], backgroundColor: ['#16a34a','#f59e0b','#ea580c','#dc2626'], borderWidth: 0, hoverOffset: 6 }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '68%',
                plugins: { legend: { display: false },
                    tooltip: { callbacks: { label: function(c) {
                        var t = c.dataset.data.reduce(function(a,b){return a+b;},0);
                        var pct = t > 0 ? Math.round((c.parsed/t)*100) : 0;
                        return ' ' + c.label + ': ' + c.parsed + ' (' + pct + '%)';
                    } } } } }
        });
    }

    function ensureTrend() {
        if (trendChart || typeof Chart === 'undefined') return;
        trendChart = new Chart(document.getElementById('trendChart').getContext('2d'), {
            type: 'bar',
            data: { labels: [], datasets: [{ label: 'Present', data: [], backgroundColor: '#4f46e5', borderRadius: 5, barPercentage: 0.6 }] },
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                          y: { beginAtZero: true, ticks: { precision: 0, font: { size: 11 } }, grid: { color: '#f1f5f9' } } } }
        });
    }

    function updateDonut(present, late, halfDay, absent) {
        var s = [present, late, halfDay, absent].join(',');
        if (s === donutSig) return;
        donutSig = s;
        ensureDonut();
        if (!donutChart) return;
        donutChart.data.datasets[0].data = [present, late, halfDay, absent];
        donutChart.update();
        document.getElementById('donutMain').textContent = present;
        document.getElementById('donutSub').textContent = 'of ' + (present + late + halfDay + absent) + ' present';
    }

    async function loadTrend() {
        var date = document.getElementById('dashDate').value;
        var school = document.getElementById('dashSchool') ? document.getElementById('dashSchool').value : '';
        var end = new Date(date + 'T00:00:00');
        var start = new Date(end); start.setDate(start.getDate() - 6);
        var startStr = start.toISOString().slice(0, 10);
        var params = new URLSearchParams({ start_date: startStr, end_date: date, type: 'student' });
        if (school) params.append('school', school);
        try {
            var res = await fetch('/api/reports?' + params, { headers: { 'Accept': 'application/json' } });
            var data = await res.json();
            buildTrend(data.records || [], startStr, date);
        } catch (e) { /* ignore */ }
    }

    function buildTrend(records, start, end) {
        var days = {};
        var d = new Date(start + 'T00:00:00'), endD = new Date(end + 'T00:00:00');
        while (d <= endD) { days[d.toISOString().slice(0,10)] = 0; d.setDate(d.getDate() + 1); }
        records.forEach(function(r) { if (r.time_in && days[r.date] !== undefined) days[r.date]++; });
        var keys = Object.keys(days);
        var labels = keys.map(function(dt) { return new Date(dt + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric' }); });
        var pData = keys.map(function(dt) { return days[dt]; });
        var s = pData.join(',');
        if (s === trendSig) return;
        trendSig = s;
        ensureTrend();
        if (!trendChart) return;
        trendChart.data.labels = labels;
        trendChart.data.datasets[0].data = pData;
        trendChart.update();
    }

    function rateColor(r) {
        return r >= 80 ? 'var(--success)' : r >= 50 ? 'var(--warning)' : 'var(--danger)';
    }

    // Banner greeting
    (function() {
        var h = new Date().getHours();
        var g = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
        document.getElementById('saGreeting').textContent = g + ', <%= user.fullname %>';
        var d = new Date();
        document.getElementById('saDateLabel').textContent = d.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
    })();

    function progressBar(pct) {
        var color = pct >= 80 ? 'green' : pct >= 50 ? 'amber' : 'red';
        return '<div class="progress-bar-wrap" style="min-width:80px;">' +
               '<div class="progress-bar-fill ' + color + '" style="width:' + Math.min(100, pct) + '%"></div></div>';
    }
    function normalizeLogo(logo) {
        var value = String(logo || '').trim();
        if (!value) return '';
        if (/^data:image\//i.test(value) || /^https?:\/\//i.test(value)) return value;
        value = value.replace(/^public\//, '');
        return value.charAt(0) === '/' ? value : '/' + value;
    }
    function logoBadge(logo, name, size) {
        var safeSize = size || 32;
        var initial = (name || 'S').charAt(0).toUpperCase();
        var src = normalizeLogo(logo);
        if (!src) {
            return '<div style="width:' + safeSize + 'px;height:' + safeSize + 'px;border-radius:9px;background:var(--primary-bg);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;flex-shrink:0;">' + initial + '</div>';
        }
        return '<img src="' + src + '" alt="" style="width:' + safeSize + 'px;height:' + safeSize + 'px;border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--border);background:#fff;">';
    }

    function nonSchoolDayMessage(data) {
        var type = data.non_school_day_type || 'Non-school Day';
        var reason = data.non_school_day_reason;
        return 'No classes due to ' + type.toLowerCase() + (reason ? ' - ' + reason : '') + '.';
    }

    async function load() {
        var date   = document.getElementById('dashDate').value;
        var school = document.getElementById('dashSchool') ? document.getElementById('dashSchool').value : '';
        var params = new URLSearchParams({ date: date });
        if (school) params.append('school_id', school);

        try {
            var res  = await fetch('/api/dashboard-data?' + params);
            var data = await res.json();
            if (data.error) return;

            // Non-school day banner
            var banner = document.getElementById('nonSchoolDayBanner');
            if (!data.is_school_day) {
                document.getElementById('nonSchoolDayText').textContent = nonSchoolDayMessage(data);
                banner.style.display = 'flex';
            } else {
                banner.style.display = 'none';
            }

            // KPI cards
            document.getElementById('statSchools').textContent  = data.total_schools;
            document.getElementById('statStudents').textContent = data.active_students;
            document.getElementById('statPresent').textContent  = data.students_present;
            var halfDayEl = document.getElementById('statHalfDay');
            if (halfDayEl) halfDayEl.textContent = data.students_half_day || 0;
            document.getElementById('statAbsent').textContent   = data.students_absent;
            document.getElementById('statRate').textContent     = data.attendance_rate + '%';
            document.getElementById('saWbRate').textContent     = data.attendance_rate + '%';
            document.getElementById('statTeachers').textContent = data.teachers_present;
            document.getElementById('statTimedOut').textContent = data.teachers_timed_out || data.students_timed_out || 0;
            document.getElementById('statFlagged').textContent  = data.flagged_absent_2day;
            var inactiveEl = document.getElementById('statInactive');
            if (inactiveEl) inactiveEl.textContent = data.inactive_students;

            // Donut: today's attendance breakdown
            updateDonut(data.students_present || 0, data.students_late || 0, data.students_half_day || 0, data.students_absent || 0);

            // Date label
            var dl = document.getElementById('breakdownDate');
            if (dl) {
                var d = new Date(date + 'T00:00:00');
                dl.textContent = d.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            }

            // School breakdown table
            var tbody = document.getElementById('schoolBreakdownBody');
            if (!data.schools || !data.schools.length) {
                tbody.innerHTML = '<tr><td colspan="9"><div class="empty-state"><i class="fa-solid fa-building-columns"></i><h4>No schools found</h4><p>No attendance data available.</p></div></td></tr>';
            } else {
                tbody.innerHTML = data.schools.map(function(s) {
                    var sRate = s.rate;
                    var tRate = s.teacher_rate;
                    return '<tr>' +
                        '<td style="font-weight:600;color:var(--gray-800);">' +
                            '<div style="display:flex;align-items:center;gap:8px;">' +
                            logoBadge(s.logo, s.name, 32) +
                            '<span>' + s.name + '</span></div></td>' +
                        '<td>' + s.enrollment + '</td>' +
                        '<td style="color:var(--success);font-weight:600;">' + s.present + '</td>' +
                        '<td style="color:#d97706;font-weight:600;">' + (s.late || 0) + '</td>' +
                        '<td style="color:#ea580c;font-weight:600;">' + (s.half_day || 0) + '</td>' +
                        '<td style="color:var(--danger);font-weight:600;">' + s.absent + '</td>' +
                        '<td>' +
                            '<div style="display:flex;align-items:center;gap:8px;">' +
                            progressBar(sRate) +
                            '<span style="font-weight:700;font-size:0.8125rem;color:' + rateColor(sRate) + ';min-width:38px;">' + sRate + '%</span>' +
                            '</div>' +
                        '</td>' +
                        '<td>' + s.teachers_present + '<span style="color:var(--gray-400);font-size:0.75rem;"> / ' + s.teachers_total + '</span></td>' +
                        '<td>' +
                            '<div style="display:flex;align-items:center;gap:8px;">' +
                            progressBar(tRate) +
                            '<span style="font-weight:700;font-size:0.8125rem;color:' + rateColor(tRate) + ';min-width:38px;">' + tRate + '%</span>' +
                            '</div>' +
                        '</td>' +
                    '</tr>';
                }).join('');
            }

            // Flagged students
            var flaggedCard = document.getElementById('flaggedCard');
            if (data.flagged_absent_2day > 0) {
                var fc = document.getElementById('flaggedCount');
                if (fc) fc.textContent = data.flagged_absent_2day + ' student(s)';
                flaggedCard.style.display = 'block';
                loadFlagged(date, school);
            } else {
                flaggedCard.style.display = 'none';
            }

        } catch (e) {
            console.error('Dashboard error:', e);
        }
    }

    async function loadFlagged(date, school) {
        var params = new URLSearchParams({ days: 2 });
        if (date) params.append('date', date);
        if (school) params.append('school_id', school);
        try {
            var res  = await fetch('/api/absence-flags?' + params);
            var data = await res.json();
            var tbody = document.getElementById('flaggedBody');
            if (!data.length) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">No flagged students.</td></tr>';
                return;
            }
            function esc(v){ return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
            function contactBtn(s) {
                var email = '';
                var phone = '';
                var adviserEmail = (s.adviser_email || '').trim();
                var adviserContact = (s.adviser_contact || '').trim();
                var schoolContact = (s.school_contact || '').trim();
                if (adviserEmail && /@/.test(adviserEmail)) email = adviserEmail;
                if (!email && adviserContact && /@/.test(adviserContact)) email = adviserContact;
                if (!email && schoolContact && /@/.test(schoolContact)) email = schoolContact;
                if (adviserContact && !/@/.test(adviserContact)) phone = adviserContact.replace(/[^0-9+]/g, '');
                if (!phone && schoolContact && !/@/.test(schoolContact)) phone = schoolContact.replace(/[^0-9+]/g, '');
                var msg = encodeURIComponent('Please check absence alert for ' + (s.lastname + ', ' + s.firstname) + ' (' + (s.grade_name || '-') + ' / ' + (s.section_name || '-') + ', LRN: ' + (s.lrn || '-') + '). Total days absent: ' + (s.absent_days || 2) + '.');
                var actions = [];
                if (phone) {
                    actions.push('<a class="btn btn-sm btn-outline" href="tel:' + encodeURIComponent(phone) + '">Call Adviser</a>');
                    actions.push('<a class="btn btn-sm btn-outline" href="sms:' + encodeURIComponent(phone) + '?body=' + msg + '">Send SMS</a>');
                }
                if (email) {
                    actions.push('<a class="btn btn-sm btn-outline" href="mailto:' + encodeURIComponent(email) + '?subject=' + encodeURIComponent('Absence Alert') + '&body=' + msg + '">Send Email</a>');
                }
                if (actions.length) {
                    return '<div style="display:flex;flex-wrap:wrap;gap:6px;">' + actions.join('') + '</div>';
                }
                return '<button class="btn btn-sm btn-secondary" type="button" onclick="alert(\'No adviser contact details are saved. Please update adviser or school contact information first.\')">Please contact adviser</button>';
            }
            tbody.innerHTML = data.map(function(s, i) {
                return '<tr>' +
                    '<td style="color:var(--gray-400);font-size:0.8125rem;">' + (i+1) + '</td>' +
                    '<td>' +
                        '<div class="student-name-cell">' +
                        '<div class="student-avatar" style="background:#fee2e2;color:#dc2626;">' + s.firstname.charAt(0).toUpperCase() + '</div>' +
                        '<span style="font-weight:600;">' + esc(s.lastname + ', ' + s.firstname) + '</span>' +
                        '</div>' +
                        '<div style="margin-top:4px;font-size:0.75rem;color:var(--gray-500);display:flex;align-items:center;gap:6px;">' + logoBadge(s.school_logo, s.school_name || 'School', 18) + '<span>' + esc(s.school_name || '-') + '</span></div>' +
                    '</td>' +
                    '<td>' + (s.grade_name || '—') + '</td>' +
                    '<td>' + (s.section_name || '—') + '</td>' +
                    '<td><span class="lrn-badge">' + (s.lrn || '—') + '</span></td>' +
                    '<td><span class="badge badge-absent">' + (s.absent_days || 2) + ' days</span></td>' +
                    '<td>' + (s.adviser || '—') + '</td>' +
                    '<td>' + contactBtn(s) + '</td>' +
                '</tr>';
            }).join('');
        } catch (e) { console.error('Flagged error:', e); }
    }

    // Watch changes
    document.getElementById('dashDate').addEventListener('change', function() {
        clearInterval(refreshTimer);
        trendSig = ''; donutSig = '';
        load(); loadTrend();
        refreshTimer = setInterval(load, 5000);
    });
    var schoolEl = document.getElementById('dashSchool');
    if (schoolEl) schoolEl.addEventListener('change', function() {
        clearInterval(refreshTimer);
        trendSig = ''; donutSig = '';
        load(); loadTrend();
        refreshTimer = setInterval(load, 5000);
    });

    // Initial load + polling
    load();
    loadTrend();
    refreshTimer = setInterval(load, 5000);
})();
</script>

