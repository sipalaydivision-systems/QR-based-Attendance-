<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#16a34a">
    <title>Set Your Password - <%= (typeof settings !== 'undefined' && settings && settings.system_name) || 'EduTrack' %></title>
    <link rel="icon" type="image/png" href="/uploads/logos/system-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/style.css">
    <style>
    .asp-page {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #f0f9ff 100%);
        padding: 20px;
    }
    .asp-card {
        background: #fff; border-radius: 20px; box-shadow: 0 8px 40px rgba(0,0,0,0.08);
        width: 100%; max-width: 420px; padding: 40px 32px; text-align: center;
    }
    .asp-icon {
        width: 72px; height: 72px; border-radius: 18px;
        background: linear-gradient(135deg, #16a34a, #15803d);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 16px; color: #fff; font-size: 1.75rem;
    }
    .asp-card h1 { font-size: 1.375rem; font-weight: 800; color: var(--gray-900); margin: 0 0 4px; }
    .asp-card .subtitle { font-size: 0.8125rem; color: var(--gray-500); margin: 0 0 24px; }

    .asp-alert {
        background: #fef2f2; border: 1px solid #fecaca; color: #dc2626;
        border-radius: 10px; padding: 10px 14px; font-size: 0.8125rem;
        margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
    }
    .asp-welcome {
        background: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a;
        border-radius: 10px; padding: 12px 14px; font-size: 0.8125rem;
        margin-bottom: 20px; text-align: left;
    }
    .asp-welcome strong { display: block; margin-bottom: 2px; }

    .asp-form-group { margin-bottom: 16px; text-align: left; }
    .asp-form-group label {
        display: block; font-size: 0.75rem; font-weight: 700;
        color: var(--gray-600); margin-bottom: 6px; text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .asp-form-group label i { margin-right: 4px; }
    .asp-form-group input {
        width: 100%; padding: 11px 14px; border: 1.5px solid var(--gray-300);
        border-radius: 10px; font-size: 0.875rem; font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }
    .asp-form-group input:focus {
        outline: none; border-color: #16a34a;
        box-shadow: 0 0 0 3px rgba(22,163,74,0.12);
    }
    .asp-pwd-wrap { position: relative; }
    .asp-pwd-wrap input { padding-right: 42px; }
    .asp-pwd-toggle {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        background: none; border: none; cursor: pointer; color: var(--gray-400); font-size: 0.875rem;
    }

    .asp-btn {
        width: 100%; padding: 12px; border: none; border-radius: 10px;
        font-size: 0.9375rem; font-weight: 700; cursor: pointer;
        font-family: inherit; display: flex; align-items: center;
        justify-content: center; gap: 8px; transition: all 0.2s;
        margin-top: 4px;
    }
    .asp-btn-primary {
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff; box-shadow: 0 2px 8px rgba(22,163,74,0.25);
    }
    .asp-btn-primary:hover { box-shadow: 0 4px 16px rgba(22,163,74,0.35); transform: translateY(-1px); }

    .asp-req { font-size: 0.75rem; color: var(--gray-400); margin-top: 4px; }

    .asp-strength { height: 4px; background: var(--gray-200); border-radius: 2px; margin-top: 6px; overflow: hidden; }
    .asp-strength-bar { height: 100%; border-radius: 2px; width: 0; transition: width 0.3s, background 0.3s; }
    </style>
</head>
<body class="asp-page">
    <div class="asp-card">
        <div class="asp-icon"><i class="fa-solid fa-lock"></i></div>
        <h1>Set Your Password</h1>
        <p class="subtitle">First-time login — create your password</p>

        <div class="asp-welcome">
            <strong><i class="fa-solid fa-circle-check"></i> Email verified!</strong>
            Create a password for <strong><%= email %></strong> to complete your account setup.
        </div>

        <% if (error) { %>
        <div class="asp-alert"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
        <% } %>

        <form method="POST" action="/adviser-setup-password">
            <div class="asp-form-group">
                <label for="aspPwd"><i class="fa-solid fa-lock"></i> New Password</label>
                <div class="asp-pwd-wrap">
                    <input type="password" id="aspPwd" name="password" required autofocus
                           autocomplete="new-password" placeholder="Create a strong password"
                           oninput="checkStrength(this.value)">
                    <button type="button" class="asp-pwd-toggle" onclick="togglePwd('aspPwd','aspPwdIcon')">
                        <i class="fa-regular fa-eye" id="aspPwdIcon"></i>
                    </button>
                </div>
                <div class="asp-strength"><div class="asp-strength-bar" id="aspStrength"></div></div>
                <p class="asp-req">Minimum 6 characters</p>
            </div>
            <div class="asp-form-group">
                <label for="aspConfirm"><i class="fa-solid fa-lock"></i> Confirm Password</label>
                <div class="asp-pwd-wrap">
                    <input type="password" id="aspConfirm" name="confirm_password" required
                           autocomplete="new-password" placeholder="Re-enter your password">
                    <button type="button" class="asp-pwd-toggle" onclick="togglePwd('aspConfirm','aspConfirmIcon')">
                        <i class="fa-regular fa-eye" id="aspConfirmIcon"></i>
                    </button>
                </div>
            </div>
            <button type="submit" class="asp-btn asp-btn-primary">
                <i class="fa-solid fa-check"></i> Set Password & Sign In
            </button>
        </form>
    </div>
    <script>
    function togglePwd(inputId, iconId) {
        var inp = document.getElementById(inputId);
        var ico = document.getElementById(iconId);
        if (inp.type === 'password') { inp.type = 'text'; ico.className = 'fa-regular fa-eye-slash'; }
        else { inp.type = 'password'; ico.className = 'fa-regular fa-eye'; }
    }
    function checkStrength(val) {
        var bar = document.getElementById('aspStrength');
        var w = 0, c = '#ef4444';
        if (val.length >= 6) { w = 33; c = '#f59e0b'; }
        if (val.length >= 8 && /[A-Z]/.test(val) && /[0-9]/.test(val)) { w = 66; c = '#3b82f6'; }
        if (val.length >= 10 && /[A-Z]/.test(val) && /[0-9]/.test(val) && /[^A-Za-z0-9]/.test(val)) { w = 100; c = '#16a34a'; }
        bar.style.width = w + '%';
        bar.style.background = c;
    }
    </script>
</body>
</html>
