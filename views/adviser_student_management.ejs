<%- include('partials/header') %>

<style>
.as-wrap { width: 100%; }
.as-header-bar { display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, var(--primary), #16a34a); border-radius: var(--radius-lg); padding: 20px 24px; color: #fff; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
.as-header-bar h2 { font-size: 1.125rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 10px; }
.as-header-bar p  { font-size: 0.8125rem; opacity: 0.88; margin: 4px 0 0; }
.as-header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; margin-left: auto; }
.as-header-actions .btn { background: #fff; color: var(--primary); font-weight: 700; padding: 9px 18px; border: 0; }

.as-section-badges { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
.as-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 20px; font-size: 0.8125rem; font-weight: 600; }
.as-school-logo { width: 20px; height: 20px; object-fit: contain; border-radius: 50%; background: #fff; padding: 2px; box-shadow: 0 0 0 1px rgba(79,70,229,0.12); flex: 0 0 auto; }
.as-badge.school  { background: #eef2ff; color: #4f46e5; }
.as-badge.grade   { background: #fef3c7; color: #92400e; }
.as-badge.section { background: #dcfce7; color: #16a34a; }

.as-card { background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--gray-200); box-shadow: var(--shadow); }
.as-card-pad { padding: 22px 24px; }
.as-card-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--gray-100); flex-wrap: wrap; gap: 10px; }
.as-card-header h3 { font-size: 0.9375rem; font-weight: 700; color: var(--gray-800); margin: 0; display: flex; align-items: center; gap: 8px; }
.as-name { font-weight: 600; color: var(--gray-900); }

/* Prominent enroll search */
.enroll-hint { font-size: 0.82rem; color: var(--gray-500); margin: 0 0 16px; line-height: 1.5; }
.enroll-search-wrap { position: relative; }
.enroll-search-wrap i.search-ico { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--gray-400); }
.enroll-input { width: 100%; box-sizing: border-box; padding: 13px 16px 13px 42px; font-size: 0.95rem; border: 1.5px solid var(--gray-300); border-radius: 12px; transition: border-color 0.15s; }
.enroll-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(22,163,74,0.12); }
#enrollResults { margin-top: 14px; }

.as-list-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; border-bottom: 1px solid var(--gray-100); }
.as-list-row:last-child { border-bottom: 0; }
.as-list-row:hover { background: var(--gray-50); }
.as-meta { font-size: 0.72rem; color: var(--gray-400); margin-top: 2px; }
.as-btn-xs { font-size: 0.75rem; padding: 6px 12px; }
.as-status-pill { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 12px; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; }
.as-status-pill.active   { background: #dcfce7; color: #16a34a; }
.as-status-pill.inactive { background: var(--gray-100); color: var(--gray-400); }

.as-empty { text-align: center; padding: 52px 24px; color: var(--gray-400); font-size: 0.9rem; }
.as-empty i { font-size: 2.75rem; display: block; margin-bottom: 12px; color: var(--gray-300); }
.as-no-section { background: #fef3c7; border: 1px solid #fde68a; border-radius: var(--radius-lg); padding: 32px; text-align: center; color: #92400e; }
.as-no-section i { font-size: 2.5rem; display: block; margin-bottom: 12px; }
</style>

<div class="as-wrap">

<% if (!teacher.section_id) { %>
<div class="as-no-section">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <h3>No Section Assigned</h3>
    <p>Please contact the administrator to assign your grade level and section before managing students.</p>
</div>
<% } else {
    var viewMeta = {
        enroll:      { icon: 'fa-user-plus',         title: 'Enroll a Student',      sub: 'Search and enroll students into your section' },
        notEnrolled: { icon: 'fa-user-clock',        title: 'Not Enrolled Students', sub: 'Students from your section awaiting re-enrollment' },
        transferred: { icon: 'fa-right-from-bracket', title: 'Transferred Students',  sub: 'Students who transferred to another school' },
        archived:    { icon: 'fa-box-archive',       title: 'Archived Students',     sub: 'Students from previous, closed school years' }
    };
    var vm = viewMeta[studentView] || viewMeta.enroll;
%>

<div class="as-header-bar">
    <div>
        <h2><i class="fa-solid <%= vm.icon %>"></i> <%= vm.title %></h2>
        <p><%= vm.sub %><%= activeYearLabel ? ' · ' + activeYearLabel : '' %></p>
    </div>
    <% if (studentView === 'enroll') { %>
    <div class="as-header-actions">
        <button class="btn" onclick="openAddModal()"><i class="fa-solid fa-user-plus"></i> Add New Student</button>
        <a class="btn" href="/admin/adviser-import-students"><i class="fa-solid fa-file-arrow-up"></i> Import Students</a>
    </div>
    <% } %>
</div>

<div class="as-section-badges">
    <span class="as-badge school">
        <img class="as-school-logo" src="<%= teacher.school_logo || ((typeof settings !== 'undefined' && settings && settings.system_logo) ? settings.system_logo : '/uploads/logos/system-logo.png') %>" alt="" onerror="this.onerror=null;this.src='/uploads/logos/system-logo.png';">
        <%= teacher.school_name || 'N/A' %>
    </span>
    <span class="as-badge grade"><i class="fa-solid fa-layer-group"></i> <%= teacher.grade_name || 'N/A' %></span>
    <span class="as-badge section"><i class="fa-solid fa-users"></i> <%= teacher.section_name || 'N/A' %></span>
</div>

<% if (studentView === 'enroll') { %>
<div class="as-card">
    <div class="as-card-pad">
        <p class="enroll-hint">Search across <strong>all schools</strong> — last year's class or an incoming learner from another school — and enroll them into <strong><%= teacher.grade_name || 'your grade' %> — <%= teacher.section_name || 'your section' %></strong>. A learner from another school is <strong>transferred in</strong> (their previous records are kept). To create a brand-new learner, use <strong>Add New Student</strong>.</p>
        <div class="enroll-search-wrap">
            <i class="fa-solid fa-magnifying-glass search-ico"></i>
            <input type="text" id="enrollSearch" class="enroll-input" placeholder="Search by LRN or name…" oninput="enrollSearchDebounced()" autocomplete="off">
        </div>
        <div id="enrollResults"><div style="color:var(--gray-400);font-size:0.82rem;padding:14px 2px;">Type at least 2 characters to search.</div></div>
    </div>
</div>
<% } %>

<% if (studentView === 'notEnrolled') { %>
<div class="as-card">
    <% if (groups.notEnrolled.length === 0) { %>
        <div class="as-empty"><i class="fa-solid fa-user-clock"></i> No students waiting to be enrolled.<br>After a school year is closed, last year's students appear here to re-enroll.</div>
    <% } else { groups.notEnrolled.forEach(function(s) { %>
        <div class="as-list-row">
            <div>
                <div class="as-name"><%= s.lastname.toUpperCase() %>, <%= s.firstname %><%= s.middlename ? ' ' + s.middlename.charAt(0).toUpperCase() + '.' : '' %></div>
                <div class="as-meta">LRN: <%= s.lrn || '—' %></div>
            </div>
            <button class="btn btn-primary as-btn-xs" onclick="enrollStudent(<%= s.id %>, this)"><i class="fa-solid fa-user-plus"></i> Enroll</button>
        </div>
    <% }); } %>
</div>
<% } %>

<% if (studentView === 'transferred') { %>
<div class="as-card">
    <% if (groups.transferred.length === 0) { %>
        <div class="as-empty"><i class="fa-solid fa-right-from-bracket"></i> No transferred students.</div>
    <% } else { groups.transferred.forEach(function(s) { %>
        <div class="as-list-row">
            <div>
                <div class="as-name"><%= s.lastname.toUpperCase() %>, <%= s.firstname %><%= s.middlename ? ' ' + s.middlename.charAt(0).toUpperCase() + '.' : '' %></div>
                <div class="as-meta">To: <%= s.transfer_to_school || '—' %><%= s.transfer_date ? ' · ' + s.transfer_date : '' %><%= s.remarks ? ' · ' + s.remarks : '' %></div>
            </div>
            <button class="btn btn-secondary as-btn-xs" onclick="enrollStudent(<%= s.id %>, this)"><i class="fa-solid fa-rotate-left"></i> Re-enroll</button>
        </div>
    <% }); } %>
</div>
<% } %>

<% if (studentView === 'archived') { %>
<div class="as-card">
    <% if (groups.archived.length === 0) { %>
        <div class="as-empty"><i class="fa-solid fa-box-archive"></i> No archived records.<br>Students from previous, closed school years appear here.</div>
    <% } else { groups.archived.forEach(function(s) { %>
        <div class="as-list-row">
            <div>
                <div class="as-name"><%= s.lastname.toUpperCase() %>, <%= s.firstname %><%= s.middlename ? ' ' + s.middlename.charAt(0).toUpperCase() + '.' : '' %></div>
                <div class="as-meta">LRN: <%= s.lrn || '—' %> · <%= s.year_label %> · <%= s.grade_name || '—' %><%= s.section_name ? ' ' + s.section_name : '' %></div>
            </div>
            <span class="as-status-pill inactive">Archived</span>
        </div>
    <% }); } %>
</div>
<% } %>

<% } %>
</div>

<% if (typeof studentView !== 'undefined' && studentView === 'enroll' && teacher.section_id) { %>
<!-- ── Add Student Modal ── -->
<div class="modal-overlay" id="addModal" style="display:none;">
    <div class="modal" style="max-width:500px;">
        <div class="modal-header">
            <h3><i class="fa-solid fa-user-plus"></i> Add New Student</h3>
            <button class="modal-close" onclick="closeAddModal()">&times;</button>
        </div>
        <div style="padding:24px;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div class="form-group"><label class="form-label">Last Name *</label><input type="text" id="addLastname" class="form-control" placeholder="e.g. Dela Cruz" style="width:100%;box-sizing:border-box;"></div>
                <div class="form-group"><label class="form-label">First Name *</label><input type="text" id="addFirstname" class="form-control" placeholder="e.g. Juan" style="width:100%;box-sizing:border-box;"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div class="form-group"><label class="form-label">Middle Name</label><input type="text" id="addMiddlename" class="form-control" placeholder="Optional" style="width:100%;box-sizing:border-box;"></div>
                <div class="form-group"><label class="form-label">LRN <span style="font-weight:400;color:var(--gray-400);">(12 digits)</span></label><input type="text" id="addLrn" class="form-control" maxlength="12" placeholder="Optional" style="width:100%;box-sizing:border-box;"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px;">
                <div class="form-group">
                    <label class="form-label">Sex</label>
                    <select id="addGender" class="form-control" style="width:100%;box-sizing:border-box;">
                        <option value="">— Select —</option><option value="Male">Male</option><option value="Female">Female</option>
                    </select>
                </div>
                <div class="form-group"><label class="form-label">Guardian Contact</label><input type="text" id="addGuardian" class="form-control" placeholder="09XXXXXXXXX" style="width:100%;box-sizing:border-box;"></div>
            </div>
            <div id="addError" style="color:#dc2626;font-size:0.8125rem;margin-bottom:12px;display:none;"></div>
            <div style="display:flex;gap:10px;justify-content:flex-end;">
                <button class="btn btn-secondary" onclick="closeAddModal()">Cancel</button>
                <button class="btn btn-primary" id="addSaveBtn" onclick="submitAdd()"><i class="fa-solid fa-user-plus"></i> Add Student</button>
            </div>
        </div>
    </div>
</div>
<% } %>

<script>
function escapeHtml(str) {
    return String(str == null ? '' : str).replace(/[&<>"']/g, function(c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

// ── Enroll a Student (division-wide search → enroll / transfer in) ──
var enrollTimer = null;
function enrollSearchDebounced() { clearTimeout(enrollTimer); enrollTimer = setTimeout(runEnrollSearch, 300); }
function runEnrollSearch() {
    var inp = document.getElementById('enrollSearch');
    if (!inp) return;
    var q = inp.value.trim();
    var box = document.getElementById('enrollResults');
    if (q.length < 2) { box.innerHTML = '<div style="color:var(--gray-400);font-size:0.82rem;padding:14px 2px;">Type at least 2 characters to search.</div>'; return; }
    box.innerHTML = '<div style="color:var(--gray-400);font-size:0.82rem;padding:14px 2px;"><i class="fa-solid fa-spinner fa-spin"></i> Searching…</div>';
    fetch('/admin/adviser-search-students?q=' + encodeURIComponent(q))
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (!data.success || !data.students || !data.students.length) {
            box.innerHTML = '<div style="color:var(--gray-400);font-size:0.82rem;padding:14px 2px;">No matching students found.</div>';
            return;
        }
        box.innerHTML = data.students.map(function(s) {
            var prior = s.prior ? (s.prior.year_label + ' · ' + (s.prior.grade_name || '—') + (s.prior.section_name ? ' ' + s.prior.section_name : '')) : 'No previous enrollment';
            var meta = 'LRN: ' + escapeHtml(s.lrn || '—') + ' · ' + escapeHtml(prior);
            if (s.from_other_school && s.current_school_name) {
                meta += ' · <span style="color:#c2410c;font-weight:700;"><i class="fa-solid fa-school"></i> from ' + escapeHtml(s.current_school_name) + '</span>';
            }
            var action;
            if (s.already_mine) {
                action = '<span class="as-status-pill active"><i class="fa-solid fa-check" style="font-size:0.6rem;"></i> In your section</span>';
            } else if (s.from_other_school) {
                action = '<button class="btn as-btn-xs" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;" data-transfer="1" data-name="' + escapeHtml(s.name) + '" data-school="' + escapeHtml(s.current_school_name || 'another school') + '" onclick="enrollStudent(' + s.id + ', this)"><i class="fa-solid fa-right-to-bracket"></i> Transfer In</button>';
            } else {
                action = '<button class="btn btn-primary as-btn-xs" onclick="enrollStudent(' + s.id + ', this)"><i class="fa-solid fa-user-plus"></i> Enroll</button>';
            }
            return '<div class="as-list-row" style="padding-left:2px;padding-right:2px;">' +
                '<div><div class="as-name">' + escapeHtml(s.name) + '</div><div class="as-meta">' + meta + '</div></div>' +
                '<div>' + action + '</div></div>';
        }).join('');
    })
    .catch(function() { box.innerHTML = '<div style="color:#dc2626;font-size:0.82rem;padding:14px 2px;">Search failed — try again.</div>'; });
}
function enrollStudent(id, btn) {
    var isTransfer = btn && btn.dataset && btn.dataset.transfer === '1';
    if (isTransfer) {
        if (!confirm('Transfer ' + (btn.dataset.name || 'this student') + ' into your section?\n\nThey will move from ' + (btn.dataset.school || 'their current school') + ' into your school for this school year. Their previous records are kept.')) return;
    }
    var restoreLabel = isTransfer ? '<i class="fa-solid fa-right-to-bracket"></i> Transfer In' : '<i class="fa-solid fa-user-plus"></i> Enroll';
    btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ' + (isTransfer ? 'Transferring…' : 'Enrolling…');
    fetch('/admin/adviser-enroll-student', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ student_id: id })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) { window.location.href = '/admin/adviser-students'; }
        else { btn.disabled = false; btn.innerHTML = restoreLabel; alert(data.error || 'Enroll failed.'); }
    })
    .catch(function() { btn.disabled = false; btn.innerHTML = restoreLabel; alert('Network error — try again.'); });
}

// ── Add New Student ──
function openAddModal() {
    ['addLastname','addFirstname','addMiddlename','addLrn','addGuardian'].forEach(function(id) { var el = document.getElementById(id); if (el) el.value = ''; });
    var g = document.getElementById('addGender'); if (g) g.value = '';
    document.getElementById('addError').style.display = 'none';
    document.getElementById('addModal').style.display = 'flex';
    document.getElementById('addLastname').focus();
}
function closeAddModal() { var m = document.getElementById('addModal'); if (m) m.style.display = 'none'; }
function submitAdd() {
    var fn = document.getElementById('addFirstname').value.trim();
    var ln = document.getElementById('addLastname').value.trim();
    var errEl = document.getElementById('addError');
    if (!fn || !ln) { errEl.textContent = 'First name and last name are required.'; errEl.style.display = ''; return; }
    var btn = document.getElementById('addSaveBtn');
    btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Adding…';
    fetch('/admin/adviser-add-student', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            firstname: fn, lastname: ln,
            middlename: document.getElementById('addMiddlename').value.trim(),
            lrn: document.getElementById('addLrn').value.trim(),
            gender: document.getElementById('addGender').value,
            guardian_contact: document.getElementById('addGuardian').value.trim()
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) { window.location.href = '/admin/adviser-students'; }
        else { errEl.textContent = data.error || 'Add failed.'; errEl.style.display = ''; }
    })
    .catch(function() { errEl.textContent = 'Network error — try again.'; errEl.style.display = ''; })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Add Student'; });
}
</script>

<%- include('partials/footer') %>
