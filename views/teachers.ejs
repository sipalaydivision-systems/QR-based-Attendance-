<%- include('partials/header') %>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-chalkboard-user"></i> Teachers & Advisers</h1>
        <p style="color:var(--gray-500);margin:0;">Manage teacher records, adviser assignments, and school-section links.</p>
    </div>
    <div class="page-actions">
        <a href="/admin/bulk-import" class="btn btn-secondary"><i class="fa-solid fa-file-import"></i> Import Teachers</a>
        <button class="btn btn-primary" onclick="openTeacherModal()"><i class="fa-solid fa-plus"></i> Add Teacher</button>
    </div>
</div>

<style>
.tch-analytics-grid {
    display: grid; gap: 16px; margin-bottom: 18px;
    grid-template-columns: minmax(300px, 1fr) minmax(0, 1.45fr);
}
@media (max-width: 900px) { .tch-analytics-grid { grid-template-columns: 1fr; } }
.tch-chart-wrap { position: relative; height: 240px; }
.tch-donut-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none; }
.tch-donut-center .dc-val { font-size: 1.75rem; font-weight: 800; color: var(--gray-900); line-height: 1; }
.tch-donut-center .dc-lbl { font-size: 0.6875rem; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 3px; }
.tch-chart-legend { display: flex; justify-content: center; gap: 18px; margin-top: 14px; flex-wrap: wrap; }
.tch-legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--gray-600); font-weight: 500; }
.tch-legend-dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; flex-shrink: 0; }
</style>

<div class="tch-analytics-grid">
    <div class="card">
        <div class="card-header"><h3 style="margin:0;"><i class="fa-solid fa-chart-pie"></i> Today's Attendance Breakdown</h3></div>
        <div style="padding:18px;">
            <div class="tch-chart-wrap">
                <canvas id="tchDonutChart"></canvas>
                <div class="tch-donut-center">
                    <div class="dc-val" id="tchDonutMain">0</div>
                    <div class="dc-lbl" id="tchDonutSub">Present</div>
                </div>
            </div>
            <div class="tch-chart-legend">
                <span class="tch-legend-item"><span class="tch-legend-dot" style="background:#16a34a;"></span> Present</span>
                <span class="tch-legend-item"><span class="tch-legend-dot" style="background:#f59e0b;"></span> Late</span>
                <span class="tch-legend-item"><span class="tch-legend-dot" style="background:#ea580c;"></span> Half-Day</span>
                <span class="tch-legend-item"><span class="tch-legend-dot" style="background:#dc2626;"></span> Absent</span>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3 style="margin:0;"><i class="fa-solid fa-chart-column"></i> 7-Day Attendance Trend</h3></div>
        <div style="padding:18px;">
            <div class="tch-chart-wrap"><canvas id="tchTrendChart"></canvas></div>
            <div class="tch-chart-legend">
                <span class="tch-legend-item"><span class="tch-legend-dot" style="background:#4f46e5;"></span> Students Present</span>
            </div>
        </div>
    </div>
</div>

<div class="filter-bar">
    <% if (user.role !== 'principal') { %>
    <div class="filter-item">
        <label>School</label>
        <select id="filterSchool" onchange="loadTeachers()">
            <option value="">All Schools</option>
            <% schools.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
        </select>
    </div>
    <% } else { %>
    <input type="hidden" id="filterSchool" value="">
    <% } %>
    <div class="filter-item">
        <label>Type</label>
        <select id="filterCategory" onchange="loadTeachers()">
            <option value="">All Teachers</option>
            <option value="teacher">Regular Teacher</option>
            <option value="shs_teacher">SHS Teacher</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Status</label>
        <select id="filterStatus" onchange="loadTeachers()">
            <option value="">Active and Inactive</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Search</label>
        <input type="text" id="teacherSearch" placeholder="Search name, employee ID, contact, or section">
    </div>
    <button class="btn-filter" onclick="loadTeachers()"><i class="fa-solid fa-magnifying-glass"></i> Filter</button>
</div>

<div class="results-header">
    <span class="record-count" id="teacherCount">0 teacher(s) found</span>
    <span style="color:var(--gray-500);font-size:.875rem;">Adviser links update the assigned section automatically.</span>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Teacher</th>
                    <th>Type</th>
                    <th>Employee ID</th>
                    <th>School</th>
                    <th>Assignment</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="teachersBody"></tbody>
        </table>
    </div>
</div>

<div class="modal-overlay" id="teacherModal" style="display:none">
    <div class="modal modal-lg">
        <div class="modal-header">
            <h3 id="teacherModalTitle">Add Teacher</h3>
            <button class="modal-close" onclick="closeTeacherModal()">&times;</button>
        </div>
        <form id="teacherForm" onsubmit="saveTeacher(event)">
            <input type="hidden" id="teacherId">
            <div class="form-row">
                <div class="form-group"><label>Employee ID</label><input type="text" id="teacherEmpId" placeholder="Employee or teacher ID"></div>
                <div class="form-group"><label>Type</label><select id="teacherCategory" onchange="loadTeacherGrades()"><option value="teacher">Regular Teacher</option><option value="shs_teacher">SHS Teacher</option></select></div>
                <div class="form-group"><label>Status</label><select id="teacherStatus"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>First Name *</label><input type="text" id="teacherFirstname" required></div>
                <div class="form-group"><label>Last Name *</label><input type="text" id="teacherLastname" required></div>
                <div class="form-group"><label>Middle Name</label><input type="text" id="teacherMiddlename"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Contact Number</label><input type="text" id="teacherContact" placeholder="Mobile or landline"></div>
                <div class="form-group"><label>Email Address</label><input type="email" id="teacherEmail" placeholder="name@example.com" oninput="document.getElementById('teacherUsernameDisplay').value=this.value"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>School *</label>
                    <select id="teacherSchool" required onchange="loadTeacherGrades()">
                        <option value="">Select School</option>
                        <% schools.forEach(s => { %>
                        <option value="<%= s.id %>"><%= s.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group"><label>Grade Level</label><select id="teacherGrade" onchange="clearTeacherSection()"><option value="">Select Grade</option></select></div>
                <div class="form-group"><label>Advisory Section</label><input type="text" id="teacherSectionName" maxlength="100" placeholder="Type section name (optional)"></div>
            </div>
            <div class="alert alert-info" style="margin-top:.5rem;">
                <i class="fa-solid fa-circle-info"></i> Entering an advisory section will connect this teacher as its class adviser in section details, reports, alerts, and the mobile app.
            </div>

            <hr style="border:none;border-top:1px solid var(--gray-200);margin:1.25rem 0 1rem;">
            <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;">
                <i class="fa-solid fa-lock" style="color:var(--primary);font-size:.95rem;"></i>
                <strong style="font-size:.9rem;color:var(--gray-700);">Adviser Login Account</strong>
                <span id="teacherPasswordStatus" style="margin-left:.5rem;"></span>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Username <small style="color:var(--gray-400);font-weight:400;">(login uses email)</small></label>
                    <input type="text" id="teacherUsernameDisplay" readonly style="background:var(--gray-50);color:var(--gray-500);cursor:default;" placeholder="Set email above to use as username">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>New Password <small style="color:var(--gray-400);font-weight:400;">(leave blank to keep current)</small></label>
                    <div style="position:relative;">
                        <input type="password" id="teacherNewPassword" placeholder="Min. 6 characters" autocomplete="new-password" style="padding-right:2.5rem;">
                        <button type="button" onclick="togglePwdVisibility('teacherNewPassword',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--gray-400);padding:0;font-size:.95rem;" tabindex="-1" aria-label="Show password">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label>Confirm New Password</label>
                    <div style="position:relative;">
                        <input type="password" id="teacherConfirmPassword" placeholder="Re-enter new password" autocomplete="new-password" style="padding-right:2.5rem;">
                        <button type="button" onclick="togglePwdVisibility('teacherConfirmPassword',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--gray-400);padding:0;font-size:.95rem;" tabindex="-1" aria-label="Show password">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div id="teacherMsg" style="margin-top:.75rem;"></div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="closeTeacherModal()">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Teacher</button>
            </div>
        </form>
    </div>
</div>

<script>
var allTeachers = [];
var allGrades = [];

function esc(v) {
    return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function teacherName(t) {
    return [t.firstname, t.middlename ? t.middlename.charAt(0) + '.' : '', t.lastname].filter(Boolean).join(' ');
}

var lookupsLoaded = false;
async function loadLookups() {
    if (lookupsLoaded) return;
    var gradeRes = await fetch('/api/grade-levels');
    allGrades = await gradeRes.json();
    lookupsLoaded = true;
}

async function loadTeachers() {
    var school = document.getElementById('filterSchool').value;
    var category = document.getElementById('filterCategory').value;
    var status = document.getElementById('filterStatus').value;
    var search = document.getElementById('teacherSearch').value;
    var params = new URLSearchParams();
    if (school) params.append('school_id', school);
    if (category) params.append('category', category);
    if (status) params.append('status', status);
    if (search) params.append('search', search);
    var res = await fetch('/api/teachers?' + params);
    allTeachers = await res.json();
    document.getElementById('teacherCount').textContent = allTeachers.length + ' teacher(s) found';
    renderTeachers();
}

function categoryBadge(cat) {
    if (cat === 'shs_teacher') return '<span style="display:inline-block;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;letter-spacing:.2px;background:#e0f2fe;color:#0c4a6e;">SHS Teacher</span>';
    return '<span style="display:inline-block;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;letter-spacing:.2px;background:#f0fdf4;color:#166534;">Regular Teacher</span>';
}

function renderTeachers() {
    document.getElementById('teachersBody').innerHTML = allTeachers.map(function(t) {
        var inactive = t.status === 'inactive';
        var assignment = t.grade_name || t.section_name ? esc(t.grade_name || 'Grade not set') + (t.section_name ? ' / ' + esc(t.section_name) : '') : '<span style="color:var(--warning);"><i class="fa-solid fa-triangle-exclamation"></i> No advisory section</span>';
        var contact = [t.contact, t.email].filter(Boolean).map(esc).join('<br>') || '-';
        return '<tr' + (inactive ? ' class="row-inactive"' : '') + '>' +
            '<td><strong>' + esc(teacherName(t)) + '</strong><br><small style="color:var(--gray-500);">' + (t.category === 'shs_teacher' ? 'Senior High School Teacher' : 'Regular Teacher') + '</small></td>' +
            '<td>' + categoryBadge(t.category) + '</td>' +
            '<td>' + esc(t.employee_id || '-') + '</td>' +
            '<td><span class="school-code">' + esc(t.school_name || '-') + '</span></td>' +
            '<td>' + assignment + '</td>' +
            '<td>' + contact + '</td>' +
            '<td><span class="badge ' + (inactive ? 'badge-inactive' : 'badge-active') + '">' + (inactive ? 'Inactive' : 'Active') + '</span></td>' +
            '<td><div class="action-btns">' +
                '<button class="action-btn edit" onclick="editTeacherById(' + t.id + ')" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>' +
                '<button class="action-btn delete" onclick="deleteTeacher(' + t.id + ')" title="Deactivate"><i class="fa-solid fa-user-slash"></i></button>' +
            '</div></td>' +
        '</tr>';
    }).join('') || '<tr><td colspan="8"><div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-chalkboard-user" style="font-size:2.5rem;color:var(--gray-300);"></i></div><h4>No teachers found</h4><p>Use Add Teacher or Import Teachers to create adviser records.</p></div></td></tr>';
}

function loadTeacherGrades(selectedId) {
    var schoolId = document.getElementById('teacherSchool').value;
    var category = document.getElementById('teacherCategory').value;
    var grades = allGrades.filter(function(g){
        var schoolOk = !schoolId || String(g.school_id || '') === String(schoolId) || !g.school_id;
        var match = String(g.name || '').match(/\d+/);
        var gradeNumber = match ? parseInt(match[0], 10) : NaN;
        var categoryOk = category === 'shs_teacher'
            ? gradeNumber >= 11 && gradeNumber <= 12
            : gradeNumber >= 1 && gradeNumber <= 10;
        return schoolOk && categoryOk;
    });
    document.getElementById('teacherGrade').innerHTML = '<option value="">Select Grade</option>' + grades.map(function(g){ return '<option value="' + g.id + '">' + esc(g.name) + '</option>'; }).join('');
    if (selectedId && grades.some(function(g){ return String(g.id) === String(selectedId); })) {
        document.getElementById('teacherGrade').value = selectedId;
    }
    if (!selectedId) clearTeacherSection();
}

function clearTeacherSection() {
    var input = document.getElementById('teacherSectionName');
    if (input) input.value = '';
}

async function resolveTeacherSection() {
    var name = document.getElementById('teacherSectionName').value.trim();
    if (!name) return null;
    var schoolId = document.getElementById('teacherSchool').value;
    var gradeId = document.getElementById('teacherGrade').value;
    if (!gradeId) throw new Error('Select a grade level before entering an advisory section.');
    var res = await fetch('/api/teacher-sections/resolve', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, school_id: schoolId, grade_level_id: gradeId })
    });
    var data = await res.json();
    if (!res.ok || !data.id) throw new Error(data.error || 'Could not save the advisory section.');
    return String(data.id);
}

async function openTeacherModal() {
    document.getElementById('teacherModalTitle').textContent = 'Add Teacher';
    document.getElementById('teacherForm').reset();
    document.getElementById('teacherId').value = '';
    document.getElementById('teacherCategory').value = 'teacher';
    document.getElementById('teacherStatus').value = 'active';
    document.getElementById('teacherMsg').innerHTML = '';
    document.getElementById('teacherUsernameDisplay').value = '';
    document.getElementById('teacherPasswordStatus').innerHTML = '';
    document.getElementById('teacherNewPassword').value = '';
    document.getElementById('teacherConfirmPassword').value = '';
    await loadLookups();
    loadTeacherGrades();
    document.getElementById('teacherModal').style.display = 'flex';
}

function closeTeacherModal() { document.getElementById('teacherModal').style.display = 'none'; }

function togglePwdVisibility(inputId, btn) {
    var input = document.getElementById(inputId);
    var icon = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
        btn.style.color = 'var(--primary)';
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
        btn.style.color = 'var(--gray-400)';
    }
}

// When a principal changes an existing teacher's section it becomes a request
// the teacher must confirm, rather than an instant change (super_admin stays instant).
var IS_PRINCIPAL = <%= (typeof user !== 'undefined' && user && user.role === 'principal') ? 'true' : 'false' %>;
var teacherOrigSection = '';
var teacherOrigGrade = '';
var teacherOrigCategory = 'teacher';

async function editTeacherById(id) {
    await loadLookups();
    var t = allTeachers.find(function(x) { return x.id === id; });
    if (!t) return;
    teacherOrigSection = t.section_id ? String(t.section_id) : '';
    teacherOrigGrade = t.grade_level_id ? String(t.grade_level_id) : '';
    teacherOrigCategory = t.category || 'teacher';
    document.getElementById('teacherModalTitle').textContent = 'Edit Teacher';
    document.getElementById('teacherId').value = t.id;
    document.getElementById('teacherEmpId').value = t.employee_id || '';
    document.getElementById('teacherFirstname').value = t.firstname || '';
    document.getElementById('teacherLastname').value = t.lastname || '';
    document.getElementById('teacherMiddlename').value = t.middlename || '';
    document.getElementById('teacherContact').value = t.contact || '';
    document.getElementById('teacherEmail').value = t.email || '';
    document.getElementById('teacherSchool').value = t.school_id || '';
    document.getElementById('teacherCategory').value = t.category || 'teacher';
    document.getElementById('teacherStatus').value = t.status || 'active';
    document.getElementById('teacherMsg').innerHTML = '';
    document.getElementById('teacherUsernameDisplay').value = t.email || '';
    document.getElementById('teacherNewPassword').value = '';
    document.getElementById('teacherConfirmPassword').value = '';
    var psBadge = t.has_password
        ? '<span style="display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;background:#dcfce7;color:#166534;"><i class="fa-solid fa-circle-check"></i> Password Set</span>'
        : '<span style="display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;background:#fef3c7;color:#92400e;"><i class="fa-solid fa-circle-exclamation"></i> No Password Yet</span>';
    document.getElementById('teacherPasswordStatus').innerHTML = psBadge;
    loadTeacherGrades(t.grade_level_id || '');
    document.getElementById('teacherSectionName').value = t.section_name || '';
    document.getElementById('teacherModal').style.display = 'flex';
}

async function saveTeacher(e) {
    e.preventDefault();
    var id = document.getElementById('teacherId').value;
    var msg = document.getElementById('teacherMsg');
    var newSection = '';
    try {
        newSection = await resolveTeacherSection() || '';
    } catch (err) {
        msg.innerHTML = '<div class="alert alert-danger">' + esc(err.message) + '</div>';
        return;
    }
    var body = {
        employee_id: document.getElementById('teacherEmpId').value.trim(),
        firstname: document.getElementById('teacherFirstname').value.trim(),
        lastname: document.getElementById('teacherLastname').value.trim(),
        middlename: document.getElementById('teacherMiddlename').value.trim(),
        contact: document.getElementById('teacherContact').value.trim(),
        email: document.getElementById('teacherEmail').value.trim(),
        school_id: document.getElementById('teacherSchool').value,
        grade_level_id: document.getElementById('teacherGrade').value || null,
        section_id: newSection || null,
        category: document.getElementById('teacherCategory').value || 'teacher',
        status: document.getElementById('teacherStatus').value,
        new_password: document.getElementById('teacherNewPassword').value.trim() || undefined,
        confirm_password: document.getElementById('teacherConfirmPassword').value.trim() || undefined
    };
    // Principal reassigning an existing teacher from one section to another:
    // keep the current section on save and send a confirmation request instead.
    var reassign = id && IS_PRINCIPAL && teacherOrigSection && newSection && newSection !== teacherOrigSection;
    if (reassign) {
        body.section_id = teacherOrigSection;
        body.grade_level_id = teacherOrigGrade || null;
        body.category = teacherOrigCategory;
    }

    var url = id ? '/api/teachers/' + id : '/api/teachers';
    var method = id ? 'PUT' : 'POST';
    var res = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    var data = await res.json();
    if (!(data.success || data.id)) {
        document.getElementById('teacherMsg').innerHTML = '<div class="alert alert-danger">' + esc(data.error || 'Failed to save teacher.') + '</div>';
        return;
    }
    if (reassign) {
        var tr = await fetch('/api/transfers/teacher', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ teacher_id: id, section_id: newSection })
        }).then(function(r){ return r.json(); }).catch(function(){ return { error: 'Network error.' }; });
        if (tr.success) { alert('Reassignment request sent — the teacher must accept it before the section changes.'); }
        else { document.getElementById('teacherMsg').innerHTML = '<div class="alert alert-danger">' + esc(tr.error || 'Could not send reassignment request.') + '</div>'; return; }
    }
    lookupsLoaded = false; closeTeacherModal(); loadTeachers();
}

async function deleteTeacher(id) {
    if (!confirm('Deactivate this teacher and remove the adviser link from the assigned section?')) return;
    var res = await fetch('/api/teachers/' + id, { method: 'DELETE' });
    var data = await res.json().catch(function(){ return {}; });
    if (!res.ok || data.error) alert(data.error || 'Failed to deactivate teacher.');
    loadTeachers();
}

loadTeachers();
setInterval(function() {
    if (document.getElementById('teacherModal').style.display !== 'flex') loadTeachers();
}, 10000);
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function() {
    var donutChart = null, trendChart = null, donutSig = '', trendSig = '';
    var todayStr = '<%= todayDate %>';

    function selectedSchool() {
        var el = document.getElementById('filterSchool');
        return el ? el.value : '';
    }

    function ensureDonut() {
        if (donutChart || typeof Chart === 'undefined') return;
        donutChart = new Chart(document.getElementById('tchDonutChart').getContext('2d'), {
            type: 'doughnut',
            data: { labels: ['Present','Late','Half-Day','Absent'],
                datasets: [{ data: [0,0,0,0], backgroundColor: ['#16a34a','#f59e0b','#ea580c','#dc2626'], borderWidth: 0, hoverOffset: 6 }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '68%',
                plugins: { legend: { display: false },
                    tooltip: { callbacks: { label: function(c) {
                        var t = c.dataset.data.reduce(function(a,b){return a+b;},0);
                        var pct = t > 0 ? Math.round((c.parsed/t)*100) : 0;
                        return ' ' + c.label + ': ' + c.parsed + ' (' + pct + '%)';
                    } } } } }
        });
    }
    function ensureTrend() {
        if (trendChart || typeof Chart === 'undefined') return;
        trendChart = new Chart(document.getElementById('tchTrendChart').getContext('2d'), {
            type: 'bar',
            data: { labels: [], datasets: [{ label: 'Present', data: [], backgroundColor: '#4f46e5', borderRadius: 5, barPercentage: 0.6 }] },
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                          y: { beginAtZero: true, ticks: { precision: 0, font: { size: 11 } }, grid: { color: '#f1f5f9' } } } }
        });
    }
    function updateDonut(present, late, halfDay, absent) {
        var s = [present, late, halfDay, absent].join(',');
        if (s === donutSig) return;
        donutSig = s;
        ensureDonut();
        if (!donutChart) return;
        donutChart.data.datasets[0].data = [present, late, halfDay, absent];
        donutChart.update();
        document.getElementById('tchDonutMain').textContent = present;
        document.getElementById('tchDonutSub').textContent = 'of ' + (present + late + halfDay + absent) + ' present';
    }

    async function loadDonut() {
        var params = new URLSearchParams({ date: todayStr });
        var school = selectedSchool();
        if (school) params.append('school_id', school);
        try {
            var res = await fetch('/api/dashboard-data?' + params, { headers: { 'Accept': 'application/json' } });
            var data = await res.json();
            if (data.error) return;
            updateDonut(data.students_present || 0, data.students_late || 0, data.students_half_day || 0, data.students_absent || 0);
        } catch (e) { /* ignore */ }
    }

    async function loadTrend() {
        var end = new Date(todayStr + 'T00:00:00');
        var start = new Date(end); start.setDate(start.getDate() - 6);
        var startStr = start.toISOString().slice(0, 10);
        var params = new URLSearchParams({ start_date: startStr, end_date: todayStr, type: 'student' });
        var school = selectedSchool();
        if (school) params.append('school', school);
        try {
            var res = await fetch('/api/reports?' + params, { headers: { 'Accept': 'application/json' } });
            var data = await res.json();
            buildTrend(data.records || [], startStr, todayStr);
        } catch (e) { /* ignore */ }
    }
    function buildTrend(records, start, end) {
        var days = {};
        var d = new Date(start + 'T00:00:00'), endD = new Date(end + 'T00:00:00');
        while (d <= endD) { days[d.toISOString().slice(0,10)] = 0; d.setDate(d.getDate() + 1); }
        records.forEach(function(r) { if (r.time_in && days[r.date] !== undefined) days[r.date]++; });
        var keys = Object.keys(days);
        var labels = keys.map(function(dt) { return new Date(dt + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric' }); });
        var pData = keys.map(function(dt) { return days[dt]; });
        var s = pData.join(',');
        if (s === trendSig) return;
        trendSig = s;
        ensureTrend();
        if (!trendChart) return;
        trendChart.data.labels = labels;
        trendChart.data.datasets[0].data = pData;
        trendChart.update();
    }

    function refreshCharts() { loadDonut(); loadTrend(); }

    // Re-scope charts when the super-admin school filter changes.
    var sf = document.getElementById('filterSchool');
    if (sf && sf.tagName === 'SELECT') sf.addEventListener('change', function() { donutSig = ''; trendSig = ''; refreshCharts(); });

    refreshCharts();
    setInterval(loadDonut, 30000);
})();
</script>

