<%- include('partials/header') %>
<% const qrFilters = typeof filters !== 'undefined' ? filters : { type: type || 'student', school_id: '', grade_level_id: '', section_id: '', layout: '4' }; %>
<% const isAdviser = typeof adviserScope !== 'undefined' && adviserScope !== null; %>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-qrcode"></i> Print QR Codes</h1>
    </div>
    <div class="page-actions no-print">
        <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> Print All</button>
    </div>
</div>

<div class="filter-bar no-print">
    <% if (!isAdviser) { %>
    <div class="filter-item">
        <label>Type</label>
        <select id="qrType">
            <option value="student" <%= qrFilters.type === 'student' ? 'selected' : '' %>>Students</option>
            <option value="teacher" <%= qrFilters.type === 'teacher' ? 'selected' : '' %>>Teachers</option>
        </select>
    </div>
    <div class="filter-item">
        <label>School</label>
        <select id="qrSchool">
            <option value="">All Schools</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Grade Level</label>
        <select id="qrGrade">
            <option value="">All Grades</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Section</label>
        <select id="qrSection">
            <option value="">All Sections</option>
        </select>
    </div>
    <% } else { %>
    <input type="hidden" id="qrType" value="student">
    <input type="hidden" id="qrSchool" value="<%= qrFilters.school_id %>">
    <input type="hidden" id="qrGrade" value="<%= qrFilters.grade_level_id %>">
    <input type="hidden" id="qrSection" value="<%= qrFilters.section_id %>">
    <% if (typeof teacherQr !== 'undefined' && teacherQr) { %>
    <div class="filter-item">
        <label>Show</label>
        <select id="qrShow" onchange="applyQrShow(this.value)">
            <option value="both">My QR Code &amp; Students</option>
            <option value="mine">My QR Code Only</option>
            <option value="students">Students Only</option>
        </select>
    </div>
    <% } %>
    <% } %>
    <div class="filter-item">
        <label>Search</label>
        <input type="text" id="qrSearch" placeholder="Name or LRN…" oninput="filterQrBySearch(this.value)" autocomplete="off" style="min-width:160px;">
    </div>
    <div class="filter-item">
        <label>Layout</label>
        <select id="qrLayout">
            <option value="3" <%= qrFilters.layout === '3' ? 'selected' : '' %>>3 per row</option>
            <option value="4" <%= qrFilters.layout === '4' ? 'selected' : '' %>>4 per row</option>
            <option value="5" <%= qrFilters.layout === '5' ? 'selected' : '' %>>5 per row</option>
        </select>
    </div>
</div>

<div class="qr-grid" id="qrGrid" style="--qr-columns: <%= qrFilters.layout %>;">
    <% if (isAdviser && typeof teacherQr !== 'undefined' && teacherQr) { %>
    <div class="qr-card" id="teacherQrCard">
        <div class="qr-card-header"><%= teacherQr.school_name || 'School Attendance System' %></div>
        <div class="qr-card-body">
            <img src="<%= teacherQr.qrDataUrl %>" alt="QR" class="qr-image">
            <div class="qr-name"><%= [teacherQr.lastname, teacherQr.firstname].filter(function(n){ return n && n.trim(); }).join(', ') %></div>
            <% if (teacherQr.employee_id) { %><div class="qr-detail">ID: <%= teacherQr.employee_id %></div><% } %>
            <div class="qr-detail qr-grade-section"><%= [teacherQr.grade_name, teacherQr.section_name].filter(Boolean).join(' - ') || '&nbsp;' %></div>
        </div>
        <div class="qr-code-text">TEACHER</div>
    </div>
    <% } %>
    <% if (typeof people !== 'undefined' && people.length) { %>
        <% people.forEach(function(p) { %>
            <% const gradeSectionText = [p.grade_name, p.section_name].filter(Boolean).join(' - '); %>
            <div class="qr-card student-qr-card">
                <div class="qr-card-header"><%= p.school_name || 'School Attendance System' %></div>
                <div class="qr-card-body">
                    <img src="<%= p.qrDataUrl %>" alt="QR" class="qr-image">
                    <div class="qr-name"><%= [p.lastname, p.firstname].filter(function(n){ return n && n.trim(); }).join(', ') %></div>
                    <% if (p.lrn) { %><div class="qr-detail">LRN: <%= p.lrn %></div><% } %>
                    <% if (p.employee_id) { %><div class="qr-detail">ID: <%= p.employee_id %></div><% } %>
                    <div class="qr-detail qr-grade-section"><% if (gradeSectionText) { %><%= gradeSectionText %><% } else { %>&nbsp;<% } %></div>
                </div>
                <div class="qr-code-text"><%= p.lrn ? 'STUDENT' : (p.employee_id ? 'TEACHER' : (p.qr_code && p.qr_code.startsWith('TCH-') ? 'TEACHER' : 'STUDENT')) %></div>
            </div>
        <% }); %>
    <% } else if (!isAdviser || !(typeof teacherQr !== 'undefined' && teacherQr)) { %>
        <div class="empty-state" style="grid-column:1/-1;">
            <div class="empty-icon"><i class="fa-solid fa-qrcode" style="font-size:2.5rem;color:var(--gray-300);"></i></div>
            <h4>No QR codes to display</h4>
            <p>Choose a type, school, grade, or section above to show matching QR codes automatically.</p>
        </div>
    <% } %>
</div>

<style>
.filter-bar {
    align-items: end;
    justify-content: center;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
}
.filter-bar .filter-item {
    flex: 0 0 auto;
}
.filter-bar .filter-item:nth-child(2) {
    min-width: 320px;
}
.qr-grid {
    align-items: start;
    grid-template-columns: repeat(var(--qr-columns, 4), 180px);
    justify-content: start;
    gap: 16px;
    min-height: 322px;
    transition: none !important;
}
.qr-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 180px !important;
    height: 312px !important;
    min-width: 180px !important;
    max-width: 180px !important;
    min-height: 312px !important;
    max-height: 312px !important;
    transition: none !important;
    transform: none !important;
    contain: layout paint;
}
.qr-card .qr-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 54px;
    min-height: 54px;
    max-height: 54px;
    padding: 8px 10px !important;
    overflow: hidden;
    text-align: center;
    line-height: 1.25;
}
.qr-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex: 1 1 auto;
    gap: 4px;
    padding: 12px 10px !important;
    overflow: hidden;
}
.qr-image {
    object-fit: contain;
    width: 120px !important;
    height: 120px !important;
    min-width: 120px !important;
    min-height: 120px !important;
    max-width: 120px !important;
    max-height: 120px !important;
    flex: 0 0 120px;
}
.qr-name {
    width: 100%;
    min-height: 36px;
    max-height: 36px;
    line-height: 1.3;
    text-align: center;
    overflow: hidden;
}
.qr-detail {
    width: 100%;
    min-height: 16px;
    max-height: 16px;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.qr-grade-section {
    color: var(--gray-700);
    font-weight: 600;
}
.qr-code-text {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
    min-height: 28px;
    max-height: 28px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
@media print {
    .no-print, .sidebar, .topbar, .menu-btn, .live-indicator { display: none !important; }
    .content { margin-left: 0 !important; }
    .page-content { padding: 8mm !important; }
    .page-header { margin-bottom: 4mm !important; }
    .qr-grid {
        display: grid;
        grid-template-columns: repeat(var(--qr-columns, 4), 36mm) !important;
        justify-content: start;
        gap: 2.5mm !important;
        min-height: auto !important;
    }
    .qr-card {
        width: 36mm !important;
        height: 72mm !important;
        min-width: 36mm !important;
        max-width: 36mm !important;
        min-height: 72mm !important;
        max-height: 72mm !important;
        break-inside: avoid;
        page-break-inside: avoid;
        box-shadow: none;
        border: 0.3mm solid #ccd4df;
        border-radius: 2.5mm;
        overflow: hidden;
    }
    .qr-card .qr-card-header {
        background: #0f2e2b !important;
        color: #ffffff !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        font-size: 7.2pt !important;
        font-weight: 700 !important;
        letter-spacing: 0.2px;
        line-height: 1.35;
        text-align: center;
        padding: 2.8mm 2mm !important;
        height: 12mm !important;
        min-height: 12mm !important;
        max-height: 12mm !important;
    }
    .qr-card .qr-card-body {
        padding: 2.4mm 2mm !important;
        gap: 1.2mm !important;
        overflow: hidden !important;
    }
    .qr-image {
        width: 21mm !important;
        height: 21mm !important;
        min-width: 21mm !important;
        min-height: 21mm !important;
        max-width: 21mm !important;
        max-height: 21mm !important;
        flex-basis: 21mm !important;
    }
    .qr-name {
        font-size: 8.5pt !important;
        font-weight: 700 !important;
        min-height: 9mm !important;
        max-height: 9mm !important;
    }
    .qr-detail {
        font-size: 7.1pt !important;
        line-height: 1.25 !important;
        min-height: 3.6mm !important;
        max-height: 3.6mm !important;
    }
    .qr-code-text {
        font-size: 6.8pt !important;
        height: 6.5mm !important;
        min-height: 6.5mm !important;
        max-height: 6.5mm !important;
        padding: 1.5mm !important;
        border-top: 0.2mm solid #e2e8f0 !important;
    }
}
@media (max-width: 900px) {
    .qr-grid {
        grid-template-columns: repeat(2, 180px) !important;
    }
}
@media (max-width: 560px) {
    .qr-grid {
        grid-template-columns: 1fr !important;
    }
}
</style>

<script>
var initialQrFilters = <%- JSON.stringify(qrFilters).replace(/</g, '\\u003c') %>;
var isAdviserMode = <%= typeof adviserScope !== 'undefined' && adviserScope !== null ? 'true' : 'false' %>;
var dropdownsReady = false;
var reloadTimer = null;
var allQrGrades = [];
var allQrSections = [];
var activeQrRequest = null;

function setSelectValue(id, value) {
    var el = document.getElementById(id);
    if (!el) return;
    el.value = value == null ? '' : String(value);
}

function appendOption(select, value, label) {
    var opt = document.createElement('option');
    opt.value = value == null ? '' : String(value);
    opt.textContent = label || '';
    select.appendChild(opt);
}

function currentSchoolId() {
    return String(document.getElementById('qrSchool').value || '');
}

function currentGradeId() {
    return String(document.getElementById('qrGrade').value || '');
}

function renderGradeOptions(grades, selectedValue) {
    var gradeSel = document.getElementById('qrGrade');
    var schoolId = currentSchoolId();
    gradeSel.innerHTML = '';
    appendOption(gradeSel, '', 'All Grades');
    grades.filter(function(g) {
        return !schoolId || !g.school_id || String(g.school_id) === schoolId;
    }).forEach(function(g) {
        appendOption(gradeSel, g.id, g.name);
    });
    setSelectValue('qrGrade', selectedValue || '');
}

function renderSectionOptions(sections, selectedValue) {
    var secSel = document.getElementById('qrSection');
    var schoolId = currentSchoolId();
    var gradeId = currentGradeId();
    secSel.innerHTML = '';
    appendOption(secSel, '', 'All Sections');
    sections.filter(function(s) {
        var matchesSchool = !schoolId || String(s.school_id || '') === schoolId;
        var matchesGrade = !gradeId || String(s.grade_level_id || '') === gradeId;
        return matchesSchool && matchesGrade;
    }).forEach(function(s) {
        var label = s.name;
        if (!gradeId && s.grade_name) label += ' - ' + s.grade_name;
        appendOption(secSel, s.id, label);
    });
    setSelectValue('qrSection', selectedValue || '');
}

async function loadDropdowns() {
    if (isAdviserMode) {
        setSelectValue('qrLayout', initialQrFilters.layout || '4');
        var layoutEl = document.getElementById('qrLayout');
        if (layoutEl) layoutEl.addEventListener('change', function() {
            applyLayout(this.value || '4');
            syncQrUrl(buildQrParams());
        });
        dropdownsReady = true;
        return;
    }
    var [schools, grades, sections] = await Promise.all([
        fetch('/api/schools').then(function(r){return r.json();}),
        fetch('/api/grade-levels').then(function(r){return r.json();}),
        fetch('/api/sections').then(function(r){return r.json();})
    ]);
    var sSel = document.getElementById('qrSchool');
    schools.forEach(function(s) {
        appendOption(sSel, s.id, s.name);
    });
    allQrGrades = grades;
    allQrSections = sections;
    setSelectValue('qrSchool', initialQrFilters.school_id);
    renderGradeOptions(allQrGrades, initialQrFilters.grade_level_id);
    renderSectionOptions(allQrSections, initialQrFilters.section_id);
    setSelectValue('qrType', initialQrFilters.type);
    setSelectValue('qrLayout', initialQrFilters.layout || '4');
    bindAutoReload();
    dropdownsReady = true;
}
loadDropdowns();

function buildQrParams() {
    var type = document.getElementById('qrType').value;
    var school = document.getElementById('qrSchool').value;
    var grade = document.getElementById('qrGrade').value;
    var section = document.getElementById('qrSection').value;
    var layout = document.getElementById('qrLayout').value || '4';
    var params = new URLSearchParams();
    params.set('type', type || 'student');
    if (school) params.set('school_id', school);
    if (grade) params.set('grade_level_id', grade);
    if (section) params.set('section_id', section);
    if (layout) params.set('layout', layout);
    return params;
}

function syncQrUrl(params) {
    var nextUrl = '/admin/print-qr?' + params.toString();
    if (window.location.pathname + window.location.search !== nextUrl) {
        window.history.replaceState(null, '', nextUrl);
    }
}

function safeText(value) {
    return value == null ? '' : String(value);
}

function makeDiv(className, value) {
    var el = document.createElement('div');
    if (className) el.className = className;
    el.textContent = safeText(value);
    return el;
}

function makeQrCard(person) {
    var card = makeDiv('qr-card student-qr-card');
    var header = makeDiv('qr-card-header', person.school_name || 'EduTrack');
    var body = makeDiv('qr-card-body');
    var img = document.createElement('img');
    img.src = person.qrDataUrl || '';
    img.alt = 'QR';
    img.className = 'qr-image';
    body.appendChild(img);
    body.appendChild(makeDiv('qr-name', [person.lastname, person.firstname].filter(function(n){ return n && n.trim(); }).join(', ')));
    if (person.lrn) body.appendChild(makeDiv('qr-detail', 'LRN: ' + person.lrn));
    if (person.employee_id) body.appendChild(makeDiv('qr-detail', 'ID: ' + person.employee_id));
    var gradeSectionText = [person.grade_name, person.section_name].filter(Boolean).join(' - ');
    var gradeSection = makeDiv('qr-detail qr-grade-section', gradeSectionText || '\u00a0');
    body.appendChild(gradeSection);
    card.appendChild(header);
    card.appendChild(body);
    var typeLabel = person.lrn ? 'STUDENT' : (person.employee_id ? 'TEACHER' : (person.qr_code && person.qr_code.startsWith('TCH-') ? 'TEACHER' : 'STUDENT'));
    card.appendChild(makeDiv('qr-code-text', typeLabel));
    return card;
}

function renderEmptyQr(message) {
    var empty = makeDiv('empty-state');
    empty.style.gridColumn = '1/-1';
    var iconWrap = makeDiv('empty-icon');
    var icon = document.createElement('i');
    icon.className = 'fa-solid fa-qrcode';
    icon.style.fontSize = '2.5rem';
    icon.style.color = 'var(--gray-300)';
    iconWrap.appendChild(icon);
    var title = document.createElement('h4');
    title.textContent = 'No QR codes to display';
    var text = document.createElement('p');
    text.textContent = message || 'Choose a type, school, grade, or section above to show matching QR codes automatically.';
    empty.appendChild(iconWrap);
    empty.appendChild(title);
    empty.appendChild(text);
    return empty;
}

function renderQrCards(people) {
    var grid = document.getElementById('qrGrid');
    // remove only student cards, keep the teacher card
    grid.querySelectorAll('.student-qr-card, .empty-state').forEach(function(el){ el.remove(); });
    if (!people || !people.length) {
        grid.appendChild(renderEmptyQr());
        return;
    }
    people.forEach(function(person) {
        grid.appendChild(makeQrCard(person));
    });
    // re-apply show + search filters
    var showEl = document.getElementById('qrShow');
    if (showEl) applyQrShow(showEl.value);
    var searchEl = document.getElementById('qrSearch');
    if (searchEl && searchEl.value.trim()) filterQrBySearch(searchEl.value);
}

async function fetchQrCards() {
    if (!dropdownsReady) return;
    var params = buildQrParams();
    syncQrUrl(params);

    if (activeQrRequest) activeQrRequest.abort();
    activeQrRequest = new AbortController();

    try {
        var response = await fetch('/admin/print-qr/data?' + params.toString(), {
            headers: { 'Accept': 'application/json' },
            cache: 'no-store',
            signal: activeQrRequest.signal
        });
        var contentType = response.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) throw new Error('Your session has expired. Please sign in again.');
        if (!response.ok) throw new Error('Failed to load QR codes.');
        var payload = await response.json();
        if (!payload.success) throw new Error(payload.error || 'Failed to load QR codes.');
        renderQrCards(payload.people || []);
    } catch (err) {
        if (err.name === 'AbortError') return;
        var grid = document.getElementById('qrGrid');
        grid.replaceChildren(renderEmptyQr(err.message || 'Unable to load QR codes. Please check the selected filters and try again.'));
    }
}

function applyLayout(cols) {
    document.getElementById('qrGrid').style.setProperty('--qr-columns', cols);
}

function scheduleFetch() {
    if (!dropdownsReady) return;
    var layout = document.getElementById('qrLayout').value || '4';
    applyLayout(layout);
    clearTimeout(reloadTimer);
    reloadTimer = setTimeout(fetchQrCards, 180);
}

function handleFilterChange(event) {
    if (event.target.id === 'qrSchool') {
        renderGradeOptions(allQrGrades, '');
        renderSectionOptions(allQrSections, '');
    }
    if (event.target.id === 'qrGrade') {
        renderSectionOptions(allQrSections, '');
    }
    if (event.target.id === 'qrLayout') {
        applyLayout(event.target.value || '4');
        syncQrUrl(buildQrParams());
        return;
    }
    scheduleFetch();
}

function bindAutoReload() {
    ['qrType', 'qrSchool', 'qrGrade', 'qrSection', 'qrLayout'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('change', handleFilterChange);
    });
}

function applyQrShow(value) {
    var teacherCard = document.getElementById('teacherQrCard');
    var studentCards = document.querySelectorAll('.student-qr-card');
    if (teacherCard) teacherCard.style.display = (value === 'students') ? 'none' : '';
    studentCards.forEach(function(c) { c.style.display = (value === 'mine') ? 'none' : ''; });
    // re-apply search so toggling show doesn't break the search filter
    var searchEl = document.getElementById('qrSearch');
    if (searchEl && searchEl.value.trim()) filterQrBySearch(searchEl.value);
}

function filterQrBySearch(query) {
    var q = query.trim().toLowerCase();
    var showSel = document.getElementById('qrShow');
    var showVal = showSel ? showSel.value : 'both';

    // teacher card
    var teacherCard = document.getElementById('teacherQrCard');
    if (teacherCard && showVal !== 'students') {
        if (!q) {
            teacherCard.style.display = '';
        } else {
            var tText = teacherCard.textContent.toLowerCase();
            teacherCard.style.display = tText.indexOf(q) !== -1 ? '' : 'none';
        }
    }

    // student cards
    document.querySelectorAll('.student-qr-card').forEach(function(card) {
        if (showVal === 'mine') { card.style.display = 'none'; return; }
        if (!q) { card.style.display = ''; return; }
        var text = card.textContent.toLowerCase();
        card.style.display = text.indexOf(q) !== -1 ? '' : 'none';
    });
}
</script>
<%- include('partials/footer') %>
