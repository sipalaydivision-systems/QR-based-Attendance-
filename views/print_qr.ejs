<%- include('partials/header') %>
<% const qrFilters = typeof filters !== 'undefined' ? filters : { type: type || 'student', school_id: '', grade_level_id: '', section_id: '', layout: '4' }; %>

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fa-solid fa-qrcode"></i> Print QR Codes</h1>
    </div>
    <div class="page-actions no-print">
        <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> Print All</button>
    </div>
</div>

<div class="filter-bar no-print">
    <div class="filter-item">
        <label>Type</label>
        <select id="qrType">
            <option value="student" <%= qrFilters.type === 'student' ? 'selected' : '' %>>Students</option>
            <option value="teacher" <%= qrFilters.type === 'teacher' ? 'selected' : '' %>>Teachers</option>
        </select>
    </div>
    <div class="filter-item">
        <label>School</label>
        <select id="qrSchool">
            <option value="">All Schools</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Grade Level</label>
        <select id="qrGrade">
            <option value="">All Grades</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Section</label>
        <select id="qrSection">
            <option value="">All Sections</option>
        </select>
    </div>
    <div class="filter-item">
        <label>Layout</label>
        <select id="qrLayout">
            <option value="3" <%= qrFilters.layout === '3' ? 'selected' : '' %>>3 per row</option>
            <option value="4" <%= qrFilters.layout === '4' ? 'selected' : '' %>>4 per row</option>
            <option value="5" <%= qrFilters.layout === '5' ? 'selected' : '' %>>5 per row</option>
        </select>
    </div>
    <button class="btn-filter" type="button" onclick="reloadQR()" title="Refresh QR list">
        <i class="fa-solid fa-rotate"></i> Refresh
    </button>
    <div class="auto-filter-status" aria-live="polite">
        <i class="fa-solid fa-bolt"></i>
        Auto updates when filters change
    </div>
</div>

<div class="qr-grid" id="qrGrid" style="--qr-columns: <%= qrFilters.layout %>;">
    <% if (typeof people !== 'undefined' && people.length) { %>
        <% people.forEach(function(p) { %>
            <div class="qr-card">
                <div class="qr-card-header"><%= p.school_name || 'School Attendance System' %></div>
                <div class="qr-card-body">
                    <img src="<%= p.qrDataUrl %>" alt="QR" class="qr-image">
                    <div class="qr-name"><%= p.lastname %>, <%= p.firstname %></div>
                    <% if (p.lrn) { %><div class="qr-detail">LRN: <%= p.lrn %></div><% } %>
                    <% if (p.employee_id) { %><div class="qr-detail">ID: <%= p.employee_id %></div><% } %>
                    <% if (p.grade_name) { %><div class="qr-detail"><%= p.grade_name %><% if (p.section_name) { %> - <%= p.section_name %><% } %></div><% } %>
                </div>
                <div class="qr-code-text"><%= p.qr_code %></div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="empty-state" style="grid-column:1/-1;">
            <div class="empty-icon"><i class="fa-solid fa-qrcode" style="font-size:2.5rem;color:var(--gray-300);"></i></div>
            <h4>No QR codes to display</h4>
            <p>Choose a type, school, grade, or section above to show matching QR codes automatically.</p>
        </div>
    <% } %>
</div>

<style>
.filter-bar {
    align-items: end;
}
.auto-filter-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 12px;
    color: #047857;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
}
.auto-filter-status i {
    color: #f59e0b;
}
.qr-grid {
    align-items: start;
    grid-template-columns: repeat(var(--qr-columns, 4), 180px);
    justify-content: start;
    gap: 16px;
    min-height: 288px;
    transition: none !important;
}
.qr-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 180px !important;
    height: 278px !important;
    min-width: 180px !important;
    max-width: 180px !important;
    min-height: 278px !important;
    max-height: 278px !important;
    transition: none !important;
    transform: none !important;
    contain: layout paint;
}
.qr-card .qr-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 54px;
    min-height: 54px;
    max-height: 54px;
    padding: 8px 10px !important;
    overflow: hidden;
    text-align: center;
    line-height: 1.25;
}
.qr-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex: 1 1 auto;
    gap: 4px;
    padding: 12px 10px !important;
    overflow: hidden;
}
.qr-image {
    object-fit: contain;
    width: 126px !important;
    height: 126px !important;
    min-width: 126px !important;
    min-height: 126px !important;
    max-width: 126px !important;
    max-height: 126px !important;
    flex: 0 0 126px;
}
.qr-name {
    width: 100%;
    min-height: 36px;
    max-height: 36px;
    line-height: 1.3;
    text-align: center;
    overflow: hidden;
}
.qr-detail {
    width: 100%;
    min-height: 16px;
    max-height: 16px;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.qr-code-text {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
    min-height: 28px;
    max-height: 28px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
@media print {
    .no-print, .sidebar, .topbar, .menu-btn, .live-indicator { display: none !important; }
    .content { margin-left: 0 !important; }
    .page-content { padding: 8mm !important; }
    .page-header { margin-bottom: 4mm !important; }
    .qr-grid {
        display: grid;
        grid-template-columns: repeat(<%= qrFilters.layout %>, 36mm) !important;
        justify-content: start;
        gap: 2.5mm !important;
        min-height: auto !important;
    }
    .qr-card {
        width: 36mm !important;
        height: 62mm !important;
        min-width: 36mm !important;
        max-width: 36mm !important;
        min-height: 62mm !important;
        max-height: 62mm !important;
        break-inside: avoid;
        page-break-inside: avoid;
        box-shadow: none;
        border: 0.3mm solid #ccd4df;
        border-radius: 2.5mm;
        overflow: hidden;
    }
    .qr-card .qr-card-header {
        background: #0f2e2b !important;
        color: #ffffff !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        font-size: 7.2pt !important;
        font-weight: 700 !important;
        letter-spacing: 0.2px;
        line-height: 1.35;
        text-align: center;
        padding: 2.8mm 2mm !important;
        height: 12mm !important;
        min-height: 12mm !important;
        max-height: 12mm !important;
    }
    .qr-card .qr-card-body {
        padding: 2.4mm 2mm !important;
        gap: 1.2mm !important;
        overflow: hidden !important;
    }
    .qr-image {
        width: 22mm !important;
        height: 22mm !important;
        min-width: 22mm !important;
        min-height: 22mm !important;
        max-width: 22mm !important;
        max-height: 22mm !important;
        flex-basis: 22mm !important;
    }
    .qr-name {
        font-size: 8.5pt !important;
        font-weight: 700 !important;
        min-height: 9mm !important;
        max-height: 9mm !important;
    }
    .qr-detail {
        font-size: 7.1pt !important;
        line-height: 1.25 !important;
        min-height: 3.6mm !important;
        max-height: 3.6mm !important;
    }
    .qr-code-text {
        font-size: 6.8pt !important;
        height: 6.5mm !important;
        min-height: 6.5mm !important;
        max-height: 6.5mm !important;
        padding: 1.5mm !important;
        border-top: 0.2mm solid #e2e8f0 !important;
    }
}
@media (max-width: 900px) {
    .qr-grid {
        grid-template-columns: repeat(2, 180px) !important;
    }
}
@media (max-width: 560px) {
    .qr-grid {
        grid-template-columns: 1fr !important;
    }
}
</style>

<script>
var initialQrFilters = <%- JSON.stringify(qrFilters).replace(/</g, '\\u003c') %>;
var dropdownsReady = false;
var reloadTimer = null;
var allQrGrades = [];
var allQrSections = [];

function setSelectValue(id, value) {
    var el = document.getElementById(id);
    if (!el) return;
    el.value = value == null ? '' : String(value);
}

function appendOption(select, value, label) {
    var opt = document.createElement('option');
    opt.value = value == null ? '' : String(value);
    opt.textContent = label || '';
    select.appendChild(opt);
}

function currentSchoolId() {
    return String(document.getElementById('qrSchool').value || '');
}

function currentGradeId() {
    return String(document.getElementById('qrGrade').value || '');
}

function renderGradeOptions(grades, selectedValue) {
    var gradeSel = document.getElementById('qrGrade');
    var schoolId = currentSchoolId();
    gradeSel.innerHTML = '';
    appendOption(gradeSel, '', 'All Grades');
    grades.filter(function(g) {
        return !schoolId || !g.school_id || String(g.school_id) === schoolId;
    }).forEach(function(g) {
        appendOption(gradeSel, g.id, g.name);
    });
    setSelectValue('qrGrade', selectedValue || '');
}

function renderSectionOptions(sections, selectedValue) {
    var secSel = document.getElementById('qrSection');
    var schoolId = currentSchoolId();
    var gradeId = currentGradeId();
    secSel.innerHTML = '';
    appendOption(secSel, '', 'All Sections');
    sections.filter(function(s) {
        var matchesSchool = !schoolId || String(s.school_id || '') === schoolId;
        var matchesGrade = !gradeId || String(s.grade_level_id || '') === gradeId;
        return matchesSchool && matchesGrade;
    }).forEach(function(s) {
        var label = s.name;
        if (!gradeId && s.grade_name) label += ' - ' + s.grade_name;
        appendOption(secSel, s.id, label);
    });
    setSelectValue('qrSection', selectedValue || '');
}

async function loadDropdowns() {
    var [schools, grades, sections] = await Promise.all([
        fetch('/api/schools').then(function(r){return r.json();}),
        fetch('/api/grade-levels').then(function(r){return r.json();}),
        fetch('/api/sections').then(function(r){return r.json();})
    ]);
    var sSel = document.getElementById('qrSchool');
    schools.forEach(function(s) {
        appendOption(sSel, s.id, s.name);
    });
    allQrGrades = grades;
    allQrSections = sections;
    setSelectValue('qrSchool', initialQrFilters.school_id);
    renderGradeOptions(allQrGrades, initialQrFilters.grade_level_id);
    renderSectionOptions(allQrSections, initialQrFilters.section_id);
    setSelectValue('qrType', initialQrFilters.type);
    setSelectValue('qrLayout', initialQrFilters.layout || '4');
    bindAutoReload();
    dropdownsReady = true;
}
loadDropdowns();

function reloadQR() {
    var type = document.getElementById('qrType').value;
    var school = document.getElementById('qrSchool').value;
    var grade = document.getElementById('qrGrade').value;
    var section = document.getElementById('qrSection').value;
    var layout = document.getElementById('qrLayout').value || '4';
    var params = new URLSearchParams();
    params.set('type', type || 'student');
    if (school) params.set('school_id', school);
    if (grade) params.set('grade_level_id', grade);
    if (section) params.set('section_id', section);
    if (layout) params.set('layout', layout);
    window.location.href = '/admin/print-qr?' + params.toString();
}

function applyLayout(cols) {
    document.getElementById('qrGrid').style.setProperty('--qr-columns', cols);
}

function scheduleReload() {
    if (!dropdownsReady) return;
    var layout = document.getElementById('qrLayout').value || '4';
    applyLayout(layout);
    clearTimeout(reloadTimer);
    reloadTimer = setTimeout(reloadQR, 250);
}

function handleFilterChange(event) {
    if (event.target.id === 'qrSchool') {
        renderGradeOptions(allQrGrades, '');
        renderSectionOptions(allQrSections, '');
    }
    if (event.target.id === 'qrGrade') {
        renderSectionOptions(allQrSections, '');
    }
    scheduleReload();
}

function bindAutoReload() {
    ['qrType', 'qrSchool', 'qrGrade', 'qrSection', 'qrLayout'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('change', handleFilterChange);
    });
}
</script>
<%- include('partials/footer') %>
