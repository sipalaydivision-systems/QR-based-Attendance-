<%- include('partials/header') %>
<style>
/* ── Screen controls ── */
.sf2-controls {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    background: #fff; border: 1px solid var(--gray-200); border-radius: 10px;
    padding: 14px 18px; margin-bottom: 18px; box-shadow: var(--shadow);
}
.sf2-controls h2 { font-size: 1rem; font-weight: 700; margin: 0; flex: 1; color: var(--gray-800); }

/* ── SF2 Paper ── */
.sf2-paper {
    background: #fff;
    font-family: Arial, sans-serif;
    font-size: 7.5pt;
    color: #000;
    padding: 4mm;
    width: 100%;
    box-sizing: border-box;
    overflow-x: auto;
    border: 2px solid #000;
}
.sf2-paper table { border-collapse: collapse; width: 100%; table-layout: fixed; }
.sf2-paper td { padding: 1px 2px; vertical-align: middle; text-align: center; overflow: hidden; word-break: break-word; }

.sf2-title { font-size: 11pt; font-weight: bold; text-align: center; padding: 4px 0 2px 0; }
.sf2-subtitle { font-size: 6.5pt; text-align: center; font-style: italic; font-weight: bold; padding-bottom: 4px; }

/* header info */
.sf2-info td { font-size: 7.5pt; }
.sf2-info .lbl { text-align: right; font-weight: bold; padding-right: 4px; white-space: nowrap; }
.sf2-info .box { border: 1px solid #000; font-weight: bold; text-align: center; font-size: 8.5pt; height: 16px; }

/* main grid */
.sf2-grid td { border: 1px solid #000; font-size: 7pt; }
.sf2-grid .hdr { font-weight: bold; font-size: 6.5pt; }
.sf2-grid .name-cell { text-align: left; padding: 1px 3px; font-size: 7pt; }
.sf2-grid .num-cell { font-size: 7pt; }
.sf2-grid .day-cell { font-size: 6.5pt; padding: 1px 0; }
.sf2-grid .total-row td { font-weight: bold; }
.sf2-grid .remarks-hdr { font-size: 5.5pt; font-weight: bold; text-align: center; }
.sf2-grid .remark-cell { text-align: left; font-size: 6pt; padding: 1px 3px; }

/* bottom section */
.sf2-bottom td { vertical-align: top; font-size: 6.5pt; text-align: left; }
.sf2-bottom .sec-title { font-weight: bold; font-size: 7pt; }
.sf2-box { border: 1px solid #000; padding: 2px 3px; }
.sf2-frac { display: inline-block; text-align: center; vertical-align: middle; }
.sf2-frac .num { display: block; border-bottom: 1px solid #000; padding: 0 4px; }
.sf2-frac .den { display: block; padding: 0 4px; }
.sf2-sum td { border: 1px solid #000; font-size: 6.5pt; padding: 1px 2px; }
.sf2-sum .sl { text-align: left; }
.sf2-sum .sv { text-align: center; font-weight: bold; width: 30px; }
.sf2-sign { text-align: center; font-size: 7pt; }
.sf2-sign .nm { font-weight: bold; border-bottom: 1px solid #000; display: inline-block; min-width: 200px; padding: 0 8px 1px 8px; text-transform: uppercase; }
.sf2-sign .cap { font-size: 6pt; }

/* ── Edit Mode ── */
.sf2-paper .remark-display { display: inline; }
.sf2-paper .remark-input  { display: none; width: 100%; font-size: 6pt; padding: 1px 2px; box-sizing: border-box; border: 1px solid #888; }
.sf2-paper.edit-mode .remark-display { display: none; }
.sf2-paper.edit-mode .remark-input  { display: block; }
.sf2-paper .summary-display { display: inline; }
.sf2-paper .summary-input  { display: none; width: 28px; font-size: 6pt; text-align: center; border: 1px solid #888; }
.sf2-paper.edit-mode .summary-display { display: none; }
.sf2-paper.edit-mode .summary-input  { display: inline; }
/* Attendance cell editing */
.sf2-paper.edit-mode .att-cell { cursor: pointer; transition: background 0.1s; }
.sf2-paper.edit-mode .att-cell:hover { background: #fef9c3 !important; }
.att-cell.ov-absent  { background: #fff1f2; }
.att-cell.ov-present { background: #f0fdf4; }
.sf2-paper.edit-mode .att-cell.pending-change { outline: 2px solid #f59e0b; outline-offset: -1px; }
.edit-hint { font-size: 0.75rem; color: var(--gray-500); }
#sf2SaveBtn, #sf2CancelBtn { display: none; }

/* ── Print ── */
@media print {
    .sf2-controls, .sidebar, .topbar, .menu-btn { display: none !important; }
    .content { margin-left: 0 !important; padding: 0 !important; }
    .page-content { padding: 0 !important; }
    .sf2-paper { padding: 2mm; font-size: 7pt; overflow: visible; }
    .remark-input, .summary-input { display: none !important; }
    .remark-display, .summary-display { display: inline !important; }
    .att-cell { outline: none !important; cursor: default !important; }
    body { background: #fff !important; }
    @page { size: legal landscape; margin: 5mm; }
}
</style>

<div class="sf2-controls no-print">
    <h2><i class="fa-solid fa-file-lines"></i> SF2 — Daily Attendance Report &nbsp;|&nbsp; <%= monthName %> <%= year %></h2>
    <label for="sf2MonthPicker" style="font-size:0.8125rem;font-weight:600;color:var(--gray-600);">Month:</label>
    <input type="month" id="sf2MonthPicker"
           value="<%= year %>-<%= String(month).padStart(2,'0') %>"
           style="padding:8px 12px;border:1.5px solid var(--gray-300);border-radius:8px;font-size:0.8125rem;"
           onchange="if(this.value) window.location.href='/admin/sf2-report?month=' + this.value;">
    <button class="btn btn-secondary" id="sf2EditBtn" onclick="sf2EnterEdit()"><i class="fa-solid fa-pen-to-square"></i> Edit Remarks</button>
    <button class="btn btn-primary" id="sf2SaveBtn" onclick="sf2Save()"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
    <button class="btn btn-secondary" id="sf2CancelBtn" onclick="sf2CancelEdit()"><i class="fa-solid fa-xmark"></i> Cancel</button>
    <span class="edit-hint" id="sf2EditHint"></span>
    <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> Print / Export PDF</button>
    <a href="/admin/adviser-dashboard" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<%
var DAY_ABBR = ['M','T','W','TH','F'];
var pSet = new Set(presentSet);
function isPresent(studentId, dateStr) { return pSet.has(studentId + '-' + dateStr); }

// Absences only count for school days that have already ended (lastCountable from server)
var countableDays = schoolDays.filter(function(d) { return d <= lastCountable; });
var numDays = countableDays.length;

// Normalize gender so M/m/Male/MALE all group correctly
function sexOf(s) {
    var g = String(s.gender || '').trim().toLowerCase();
    if (g === 'm' || g.indexOf('mal') === 0) return 'M';
    if (g === 'f' || g.indexOf('fem') === 0) return 'F';
    return '?';
}
var males       = students.filter(function(s) { return sexOf(s) === 'M'; });
var females     = students.filter(function(s) { return sexOf(s) === 'F'; });
var unspecified = students.filter(function(s) { return sexOf(s) === '?'; });

function isAbsentOn(s, d) {
    return d >= s.enrolled_from && d <= lastCountable && !isPresent(s.id, d);
}

function studentTotals(s) {
    var absent = 0, present = 0;
    countableDays.forEach(function(d) {
        if (d < s.enrolled_from) return;
        if (isPresent(s.id, d)) present++; else absent++;
    });
    return { absent: absent, present: present };
}

function dayAbsent(group, dateStr) {
    if (dateStr > lastCountable) return 0;
    var count = 0;
    group.forEach(function(s) { if (isAbsentOn(s, dateStr)) count++; });
    return count;
}

function hasFiveConsecutiveAbsences(s) {
    var run = 0;
    for (var i = 0; i < countableDays.length; i++) {
        var d = countableDays[i];
        if (d < s.enrolled_from) { run = 0; continue; }
        if (isPresent(s.id, d)) { run = 0; continue; }
        run++;
        if (run >= 5) return true;
    }
    return false;
}

function fmtName(s) {
    var n = s.lastname.toUpperCase() + ',' + s.firstname.toUpperCase();
    if (s.middlename) n += ', ' + s.middlename.toUpperCase();
    return n;
}

function groupStats(group) {
    var absent = 0, present = 0, late = 0, fiveDay = 0;
    group.forEach(function(s) {
        var t = studentTotals(s);
        absent += t.absent; present += t.present;
        if (s.enrolled_from > firstFriday && s.enrolled_from <= endDate) late++;
        if (hasFiveConsecutiveAbsences(s)) fiveDay++;
    });
    return { absent: absent, present: present, late: late, fiveDay: fiveDay };
}

var mStats = groupStats(males);
var fStats = groupStats(females);
var allStats = groupStats(students);

var mEnroll = males.length, fEnroll = females.length, totalEnroll = students.length;
var mAsOf = mEnroll - mStats.late, fAsOf = fEnroll - fStats.late, totalAsOf = totalEnroll - allStats.late;

function fmt1(v) { return (Math.round(v * 10) / 10).toFixed(1); }
function avgDaily(present) { return numDays > 0 ? fmt1(present / numDays) : '0.0'; }
function pctEnrol(registered, asOf) { return asOf > 0 ? Math.round(registered / asOf * 100) + '%' : ''; }
function pctAtt(present, registered) {
    return (registered > 0 && numDays > 0) ? Math.round(present / numDays / registered * 100) + '%' : '';
}

var adviserName = [teacher.firstname, teacher.middlename ? teacher.middlename.charAt(0) + '.' : '', teacher.lastname].filter(Boolean).join(' ');

// Render one attendance cell. Returns full <td> HTML string.
function cellHtml(s, d) {
    if (!d) return '<td class="day-cell"></td>';
    var canEdit = d >= s.enrolled_from && d <= lastCountable;
    var isAbs = isAbsentOn(s, d);
    var state = canEdit ? (isAbs ? 'absent' : 'present') : 'locked';
    var ovKey = s.id + '-' + d;
    var isOv = overridesData.hasOwnProperty(ovKey);
    var ovClass = isOv ? (' ' + (overridesData[ovKey] ? 'ov-present' : 'ov-absent')) : '';
    var attrs = canEdit
        ? ' att-cell' + ovClass + '" data-sid="' + s.id + '" data-date="' + d + '" data-state="' + state + '" data-original="' + state + '"'
        : '"';
    return '<td class="day-cell' + attrs + '><span class="att-text">' + (isAbs ? 'x' : '') + '</span></td>';
}
%>

<div class="sf2-paper" id="sf2Paper">

<!-- ═══ Title ═══ -->
<div class="sf2-title">School Form 2 (SF2) Daily Attendance Report of Learners</div>
<div class="sf2-subtitle">(This replaces Form 1, Form 2 &amp; STS Form 4 - Absenteeism and Dropout Profile)</div>

<!-- ═══ Header Info ═══ -->
<table class="sf2-info">
    <tr>
        <td class="lbl" style="width:12%;">School ID</td>
        <td class="box" style="width:10%;"><%= teacher.school_id_code || '' %></td>
        <td class="lbl" style="width:9%;">School Year</td>
        <td class="box" style="width:10%;"><%= schoolYear %></td>
        <td class="lbl" style="width:16%;">Report for the Month of</td>
        <td class="box" style="width:12%;"><%= monthName.toUpperCase() %> <%= year %></td>
        <td style="width:31%;"></td>
    </tr>
    <tr><td colspan="7" style="height:2px;"></td></tr>
    <tr>
        <td class="lbl">Name of School</td>
        <td class="box" colspan="2"><%= teacher.school_name %></td>
        <td class="lbl">Grade Level</td>
        <td class="box"><%= teacher.grade_name || '' %></td>
        <td class="lbl">Section</td>
        <td class="box"><%= teacher.section_name || '' %></td>
    </tr>
</table>

<!-- ═══ Attendance Grid ═══ -->
<table class="sf2-grid" style="margin-top:3px;">
    <!-- Header row A -->
    <tr>
        <td rowspan="3" class="hdr" style="width:20px;">No.</td>
        <td rowspan="3" class="hdr" style="width:150px;">NAME<br>(Last Name, First Name, Middle Name)</td>
        <td colspan="<%= slots.length %>" class="hdr" style="font-size:6pt;font-weight:normal;">(1st row for date)</td>
        <td colspan="2" class="hdr" style="width:60px;">Total for the Month</td>
        <td rowspan="2" class="remarks-hdr" style="width:130px;">REMARKS (If DROPPED OUT, state reason, please refer to legend number 2. IF TRANSFERRED IN/OUT, write the name of School.)</td>
    </tr>
    <!-- Header row B: dates -->
    <tr>
        <% slots.forEach(function(d) { %>
        <td class="day-cell hdr" style="font-size:6pt;"><%= d ? Number(d.slice(8,10)) : '' %></td>
        <% }); %>
        <td class="hdr" style="font-size:6pt;width:30px;">ABSENT</td>
        <td class="hdr" style="font-size:6pt;width:30px;">PRESENT</td>
    </tr>
    <!-- Header row C: weekday abbreviations -->
    <tr>
        <% slots.forEach(function(d, i) { %>
        <td class="day-cell hdr"><%= DAY_ABBR[i % 5] %></td>
        <% }); %>
        <td></td><td></td>
        <td></td>
    </tr>

    <!-- ═══ MALE ═══ -->
    <% males.forEach(function(s, idx) { var t = studentTotals(s); var autoRemark = (s.enrolled_from > firstFriday && s.enrolled_from <= endDate) ? 'Late enrolled (' + s.enrolled_from + ')' : ''; var savedRemark = remarksMap[s.id] !== undefined ? remarksMap[s.id] : null; var displayRemark = savedRemark !== null ? savedRemark : autoRemark; %>
    <tr>
        <td class="num-cell"><%= idx + 1 %>.</td>
        <td class="name-cell"><%= fmtName(s) %></td>
        <% slots.forEach(function(d) { %><%-cellHtml(s,d)%><% }); %>
        <td class="day-cell" style="font-weight:bold;"><%= t.absent || '' %></td>
        <td class="day-cell"><%= t.present || '' %></td>
        <td class="remark-cell">
            <span class="remark-display"><%= displayRemark %></span>
            <input class="remark-input" type="text" data-student-id="<%= s.id %>" value="<%= displayRemark %>" placeholder="<%= autoRemark %>">
        </td>
    </tr>
    <% }); %>
    <tr class="total-row">
        <td class="num-cell"><%= males.length %>.</td>
        <td class="name-cell" style="text-align:center;">&lt;=== MALE | TOTAL Per Day ===&gt;</td>
        <% slots.forEach(function(d) { var a = d ? dayAbsent(males, d) : 0; %>
        <td class="day-cell"><%= a > 0 ? a : '' %></td>
        <% }); %>
        <td class="day-cell"><%= mStats.absent || '' %></td>
        <td class="day-cell"><%= mStats.present || '' %></td>
        <td></td>
    </tr>

    <!-- ═══ FEMALE ═══ -->
    <% females.forEach(function(s, idx) { var t = studentTotals(s); var autoRemark = (s.enrolled_from > firstFriday && s.enrolled_from <= endDate) ? 'Late enrolled (' + s.enrolled_from + ')' : ''; var savedRemark = remarksMap[s.id] !== undefined ? remarksMap[s.id] : null; var displayRemark = savedRemark !== null ? savedRemark : autoRemark; %>
    <tr>
        <td class="num-cell"><%= idx + 1 %>.</td>
        <td class="name-cell"><%= fmtName(s) %></td>
        <% slots.forEach(function(d) { %><%-cellHtml(s,d)%><% }); %>
        <td class="day-cell" style="font-weight:bold;"><%= t.absent || '' %></td>
        <td class="day-cell"><%= t.present || '' %></td>
        <td class="remark-cell">
            <span class="remark-display"><%= displayRemark %></span>
            <input class="remark-input" type="text" data-student-id="<%= s.id %>" value="<%= displayRemark %>" placeholder="<%= autoRemark %>">
        </td>
    </tr>
    <% }); %>
    <tr class="total-row">
        <td class="num-cell"><%= females.length %>.</td>
        <td class="name-cell" style="text-align:center;">&lt;=== FEMALE | TOTAL Per Day ===&gt;</td>
        <% slots.forEach(function(d) { var a = d ? dayAbsent(females, d) : 0; %>
        <td class="day-cell"><%= a > 0 ? a : '' %></td>
        <% }); %>
        <td class="day-cell"><%= fStats.absent || '' %></td>
        <td class="day-cell"><%= fStats.present || '' %></td>
        <td></td>
    </tr>

    <!-- ═══ SEX NOT SET (data fix needed) ═══ -->
    <% unspecified.forEach(function(s, idx) { var t = studentTotals(s); var autoRemark = 'SEX NOT SET — update student record'; var savedRemark = remarksMap[s.id] !== undefined ? remarksMap[s.id] : null; var displayRemark = savedRemark !== null ? savedRemark : autoRemark; %>
    <tr>
        <td class="num-cell"><%= idx + 1 %>.</td>
        <td class="name-cell"><%= fmtName(s) %></td>
        <% slots.forEach(function(d) { %><%-cellHtml(s,d)%><% }); %>
        <td class="day-cell" style="font-weight:bold;"><%= t.absent || '' %></td>
        <td class="day-cell"><%= t.present || '' %></td>
        <td class="remark-cell">
            <span class="remark-display"><%= displayRemark %></span>
            <input class="remark-input" type="text" data-student-id="<%= s.id %>" value="<%= displayRemark %>" placeholder="<%= autoRemark %>">
        </td>
    </tr>
    <% }); %>
    <% if (unspecified.length) { %>
    <tr class="total-row">
        <td class="num-cell"><%= unspecified.length %>.</td>
        <td class="name-cell" style="text-align:center;">&lt;=== SEX NOT SET | TOTAL Per Day ===&gt;</td>
        <% slots.forEach(function(d) { var a = d ? dayAbsent(unspecified, d) : 0; %>
        <td class="day-cell"><%= a > 0 ? a : '' %></td>
        <% }); %>
        <td class="day-cell"></td>
        <td class="day-cell"></td>
        <td></td>
    </tr>
    <% } %>

    <!-- ═══ COMBINED ═══ -->
    <tr class="total-row">
        <td class="num-cell"><%= totalEnroll %>.</td>
        <td class="name-cell" style="text-align:center;">Combined TOTAL Per Day</td>
        <% slots.forEach(function(d) { var a = d ? dayAbsent(students, d) : 0; %>
        <td class="day-cell"><%= a > 0 ? a : '' %></td>
        <% }); %>
        <td class="day-cell"><%= allStats.absent || '' %></td>
        <td class="day-cell"><%= allStats.present || '' %></td>
        <td></td>
    </tr>
</table>

<!-- ═══ Bottom Section ═══ -->
<table class="sf2-bottom" style="margin-top:4px;">
    <tr>
        <!-- ── Left: GUIDELINES ── -->
        <td style="width:45%;padding-right:6px;">
            <div class="sec-title">GUIDELINES:</div>
            <div>1. The attendance shall be accomplished daily. Refer to the codes for checking learners' attendance.</div>
            <div>2. Dates shall be written in the columns after Learner's Name.</div>
            <div>3. To compute the following:</div>
            <table style="margin:3px 0 3px 10px;width:95%;">
                <tr>
                    <td style="width:38%;font-size:6.5pt;">a. Percentage of Enrolment =</td>
                    <td style="text-align:center;">
                        <span class="sf2-frac">
                            <span class="num">Registered Learners as of end of the month</span>
                            <span class="den">Enrolment as of 1st Friday of the school year</span>
                        </span>
                        <span style="font-weight:bold;"> x 100</span>
                    </td>
                </tr>
                <tr>
                    <td style="font-size:6.5pt;">b. Average Daily Attendance =</td>
                    <td style="text-align:center;">
                        <span class="sf2-frac">
                            <span class="num">Total Daily Attendance</span>
                            <span class="den">Number of School Days in reporting month</span>
                        </span>
                    </td>
                </tr>
                <tr>
                    <td style="font-size:6.5pt;">c. Percentage of Attendance for the month =</td>
                    <td style="text-align:center;">
                        <span class="sf2-frac">
                            <span class="num">Average daily attendance</span>
                            <span class="den">Registered Learners as of end of the month</span>
                        </span>
                        <span style="font-weight:bold;"> x 100</span>
                    </td>
                </tr>
            </table>
            <div>4. Every end of the month, the class adviser will submit this form to the office of the principal for recording of summary table into School Form 4. Once signed by the principal, this form should be returned to the adviser.</div>
            <div>5. The adviser will provide neccessary interventions including but not limited to home visitation to learner/s who were absent for 5 consecutive days and/or those at risk of dropping out.</div>
            <div>6. Attendance performance of learners will be reflected in Form 137 and Form 138 every grading period.</div>
            <div style="margin-top:4px;">*Beginning of School Year cut-off report is every 1st Friday of the School Year</div>
        </td>

        <!-- ── Middle: Codes & Reasons ── -->
        <td style="width:24%;padding-right:6px;">
            <div class="sf2-box">
                <div class="sec-title">1. CODES FOR CHECKING ATTENDANCE</div>
                <div>(blank) - Present; (x) - Absent; Tardy (half shaded= Upper for Late Commer, Lower for Cutting Classes)</div>
            </div>
            <div class="sf2-box" style="margin-top:2px;">
                <div class="sec-title">2. REASONS/CAUSES FOR NLS</div>
                <div style="font-weight:bold;">a. Domestic-Related Factors</div>
                <div>a.1. Had to take care of siblings<br>
                     a.2. Early marriage/pregnancy<br>
                     a.3. Parents' attitude toward schooling<br>
                     a.4. Family problems</div>
                <div style="font-weight:bold;">b. Individual-Related Factors</div>
                <div>b.1. Illness<br>
                     b.2. Overage<br>
                     b.3. Death<br>
                     b.4. Drug Abuse<br>
                     b.5. Poor academic performance<br>
                     b.6. Lack of interest/Distractions<br>
                     b.7. Hunger/Malnutrition</div>
                <div style="font-weight:bold;">c. School-Related Factors</div>
                <div>c.1. Teacher Factor<br>
                     c.2. Physical condition of classroom<br>
                     c.3. Peer influence</div>
                <div style="font-weight:bold;">d. Geographic/Environmental</div>
                <div>d.1. Distance between home and school<br>
                     d.2. Armed conflict (incl. Tribal wars &amp; clanfeuds)<br>
                     d.3. Calamities/Disasters</div>
                <div style="font-weight:bold;">e. Financial-Related</div>
                <div>e.1. Child labor, work</div>
                <div style="font-weight:bold;">f. Others (Specify)</div>
            </div>
            <div style="text-align:center;margin-top:3px;font-size:6pt;">Generated thru LIS</div>
        </td>

        <!-- ── Right: Summary + Signatures ── -->
        <td style="width:31%;">
            <table class="sf2-sum">
                <tr>
                    <td class="sl" style="border:none;font-weight:bold;">Month : <%= monthName %></td>
                    <td class="sl" colspan="2" style="border:none;font-weight:bold;">No. of Days of Classes: <%= numDays %></td>
                    <td style="border:none;"></td>
                </tr>
                <tr>
                    <td class="sl" style="border:none;"></td>
                    <td class="sv" style="border:none;font-weight:bold;">M</td>
                    <td class="sv" style="border:none;font-weight:bold;">F</td>
                    <td class="sv" style="border:none;font-weight:bold;">TOTAL</td>
                </tr>
                <tr>
                    <td class="sl">* Enrolment as of (1st Friday of <%= monthName %>)</td>
                    <td class="sv"><%= mAsOf %></td>
                    <td class="sv"><%= fAsOf %></td>
                    <td class="sv"><%= totalAsOf %></td>
                </tr>
                <tr>
                    <td class="sl">Late enrolment during the month (beyond cut-off)</td>
                    <td class="sv"><%= mStats.late %></td>
                    <td class="sv"><%= fStats.late %></td>
                    <td class="sv"><%= allStats.late %></td>
                </tr>
                <tr>
                    <td class="sl">Registered Learners as of end of month</td>
                    <td class="sv"><%= mEnroll %></td>
                    <td class="sv"><%= fEnroll %></td>
                    <td class="sv"><%= totalEnroll %></td>
                </tr>
                <tr>
                    <td class="sl">Percentage of Enrolment as of end of month</td>
                    <td class="sv"><%= pctEnrol(mEnroll, mAsOf) %></td>
                    <td class="sv"><%= pctEnrol(fEnroll, fAsOf) %></td>
                    <td class="sv"><%= pctEnrol(totalEnroll, totalAsOf) %></td>
                </tr>
                <tr>
                    <td class="sl">Average Daily Attendance</td>
                    <td class="sv"><%= avgDaily(mStats.present) %></td>
                    <td class="sv"><%= avgDaily(fStats.present) %></td>
                    <td class="sv"><%= avgDaily(allStats.present) %></td>
                </tr>
                <tr>
                    <td class="sl">Percentage of Attendance for the month</td>
                    <td class="sv"><%= pctAtt(mStats.present, mEnroll) %></td>
                    <td class="sv"><%= pctAtt(fStats.present, fEnroll) %></td>
                    <td class="sv"><%= pctAtt(allStats.present, totalEnroll) %></td>
                </tr>
                <tr>
                    <td class="sl">Number of students absent for 5 consecutive days</td>
                    <td class="sv"><%= mStats.fiveDay || '' %></td>
                    <td class="sv"><%= fStats.fiveDay || '' %></td>
                    <td class="sv"><%= allStats.fiveDay || '' %></td>
                </tr>
                <tr>
                    <td class="sl">Dropped out</td>
                    <td class="sv">
                        <span class="summary-display"><%= summaryMap.dropped_out_m || '' %></span>
                        <input class="summary-input" type="number" min="0" data-key="dropped_out_m" value="<%= summaryMap.dropped_out_m || '' %>">
                    </td>
                    <td class="sv">
                        <span class="summary-display"><%= summaryMap.dropped_out_f || '' %></span>
                        <input class="summary-input" type="number" min="0" data-key="dropped_out_f" value="<%= summaryMap.dropped_out_f || '' %>">
                    </td>
                    <td class="sv" id="dropped_total">
                        <%= ((parseInt(summaryMap.dropped_out_m)||0) + (parseInt(summaryMap.dropped_out_f)||0)) || '' %>
                    </td>
                </tr>
                <tr>
                    <td class="sl">Transferred out</td>
                    <td class="sv">
                        <span class="summary-display"><%= summaryMap.transferred_out_m || '' %></span>
                        <input class="summary-input" type="number" min="0" data-key="transferred_out_m" value="<%= summaryMap.transferred_out_m || '' %>">
                    </td>
                    <td class="sv">
                        <span class="summary-display"><%= summaryMap.transferred_out_f || '' %></span>
                        <input class="summary-input" type="number" min="0" data-key="transferred_out_f" value="<%= summaryMap.transferred_out_f || '' %>">
                    </td>
                    <td class="sv" id="xout_total">
                        <%= ((parseInt(summaryMap.transferred_out_m)||0) + (parseInt(summaryMap.transferred_out_f)||0)) || '' %>
                    </td>
                </tr>
                <tr>
                    <td class="sl">Transferred in</td>
                    <td class="sv">
                        <span class="summary-display"><%= summaryMap.transferred_in_m || '' %></span>
                        <input class="summary-input" type="number" min="0" data-key="transferred_in_m" value="<%= summaryMap.transferred_in_m || '' %>">
                    </td>
                    <td class="sv">
                        <span class="summary-display"><%= summaryMap.transferred_in_f || '' %></span>
                        <input class="summary-input" type="number" min="0" data-key="transferred_in_f" value="<%= summaryMap.transferred_in_f || '' %>">
                    </td>
                    <td class="sv" id="xin_total">
                        <%= ((parseInt(summaryMap.transferred_in_m)||0) + (parseInt(summaryMap.transferred_in_f)||0)) || '' %>
                    </td>
                </tr>
            </table>

            <div style="margin-top:8px;font-style:italic;font-size:7pt;">I certify that this is a true and correct report.</div>

            <div class="sf2-sign" style="margin-top:18px;">
                <span class="nm"><%= adviserName %></span>
                <div class="cap">(Signature of Adviser over Printed Name)</div>
            </div>
            <div style="margin-top:8px;font-size:7pt;">Attested by:</div>
            <div class="sf2-sign" style="margin-top:16px;">
                <span class="nm"><%= principal || '' %></span>
                <div class="cap">(Signature of School Head over Printed Name)</div>
            </div>
        </td>
    </tr>
</table>
</div>

<script>
var sf2Month = '<%= monthParam %>';

function sf2EnterEdit() {
    document.getElementById('sf2Paper').classList.add('edit-mode');
    document.getElementById('sf2EditBtn').style.display = 'none';
    document.getElementById('sf2SaveBtn').style.display = '';
    document.getElementById('sf2CancelBtn').style.display = '';
    document.getElementById('sf2EditHint').textContent = 'Click any cell to toggle absent/present. Edit remarks below each name.';
}

function sf2CancelEdit() {
    // Revert any pending cell changes
    document.querySelectorAll('.att-cell.pending-change').forEach(function(cell) {
        var orig = cell.getAttribute('data-original');
        cell.setAttribute('data-state', orig);
        var txt = cell.querySelector('.att-text');
        if (txt) txt.textContent = orig === 'absent' ? 'x' : '';
        cell.classList.remove('pending-change');
    });
    document.getElementById('sf2Paper').classList.remove('edit-mode');
    document.getElementById('sf2EditBtn').style.display = '';
    document.getElementById('sf2SaveBtn').style.display = 'none';
    document.getElementById('sf2CancelBtn').style.display = 'none';
    document.getElementById('sf2EditHint').textContent = '';
}

// Cell click — toggle absent ↔ present
document.addEventListener('click', function(e) {
    if (!document.getElementById('sf2Paper').classList.contains('edit-mode')) return;
    var cell = e.target.closest('.att-cell');
    if (!cell) return;
    var curr = cell.getAttribute('data-state');
    if (curr === 'locked') return;
    var next = curr === 'absent' ? 'present' : 'absent';
    cell.setAttribute('data-state', next);
    var txt = cell.querySelector('.att-text');
    if (txt) txt.textContent = next === 'absent' ? 'x' : '';
    var orig = cell.getAttribute('data-original');
    cell.classList.toggle('pending-change', next !== orig);
});

function sf2Save() {
    var remarks = {};
    document.querySelectorAll('.remark-input[data-student-id]').forEach(function(inp) {
        remarks[inp.getAttribute('data-student-id')] = inp.value;
    });

    var summary = {};
    document.querySelectorAll('.summary-input[data-key]').forEach(function(inp) {
        summary[inp.getAttribute('data-key')] = inp.value;
    });

    // Collect attendance overrides (only changed cells)
    var overrides = [];
    document.querySelectorAll('.att-cell[data-original]').forEach(function(cell) {
        var orig = cell.getAttribute('data-original');
        var curr = cell.getAttribute('data-state');
        if (curr !== orig) {
            overrides.push({
                student_id: parseInt(cell.getAttribute('data-sid')),
                date: cell.getAttribute('data-date'),
                is_present: curr === 'present' ? 1 : 0
            });
        }
    });

    var btn = document.getElementById('sf2SaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';

    fetch('/admin/sf2-save-remarks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ month: sf2Month, remarks: remarks, summary: summary, overrides: overrides })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            // Reload to get updated totals (overrides affect absent/present counts)
            if (overrides.length > 0) {
                window.location.reload();
                return;
            }
            // No attendance changes — just update display spans in-place
            document.querySelectorAll('.remark-input[data-student-id]').forEach(function(inp) {
                var span = inp.previousElementSibling;
                if (span) span.textContent = inp.value;
            });
            document.querySelectorAll('.summary-input[data-key]').forEach(function(inp) {
                var span = inp.previousElementSibling;
                if (span) span.textContent = inp.value;
            });
            function sumTwo(km, kf, elId) {
                var m = parseInt(document.querySelector('.summary-input[data-key="' + km + '"]').value) || 0;
                var f = parseInt(document.querySelector('.summary-input[data-key="' + kf + '"]').value) || 0;
                var el = document.getElementById(elId);
                if (el) el.textContent = (m + f) || '';
            }
            sumTwo('dropped_out_m', 'dropped_out_f', 'dropped_total');
            sumTwo('transferred_out_m', 'transferred_out_f', 'xout_total');
            sumTwo('transferred_in_m', 'transferred_in_f', 'xin_total');
            sf2CancelEdit();
            document.getElementById('sf2EditHint').textContent = 'Saved.';
            setTimeout(function() { document.getElementById('sf2EditHint').textContent = ''; }, 3000);
        } else {
            alert('Save failed: ' + (data.error || 'unknown error'));
        }
    })
    .catch(function() { alert('Network error — changes not saved.'); })
    .finally(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
    });
}
</script>

<%- include('partials/footer') %>
