<!-- Sipalay City coordinate picker for the school modal. Same bounds as the
     super_admin dashboard's school map, so a school picked here always lands
     inside the area the dashboard map can display. -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
var SIPALAY_CENTER = [9.75, 122.40];
var SIPALAY_BOUNDS = [[9.60, 122.28], [9.90, 122.55]];
var schoolMiniMapInstance = null, schoolMiniMarker = null;

function initSchoolMiniMap() {
    if (schoolMiniMapInstance) { setTimeout(function() { schoolMiniMapInstance.invalidateSize(); }, 50); return; }
    if (typeof L === 'undefined') return;
    schoolMiniMapInstance = L.map('schoolMiniMap', {
        center: SIPALAY_CENTER, zoom: 12, minZoom: 11, maxZoom: 18,
        maxBounds: SIPALAY_BOUNDS, maxBoundsViscosity: 1.0
    });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19
    }).addTo(schoolMiniMapInstance);
    schoolMiniMapInstance.on('click', function(e) {
        setMiniMapMarker(e.latlng.lat, e.latlng.lng);
        document.getElementById('schoolLat').value = e.latlng.lat.toFixed(8);
        document.getElementById('schoolLng').value = e.latlng.lng.toFixed(8);
    });
    setTimeout(function() { schoolMiniMapInstance.invalidateSize(); }, 50);
}

function setMiniMapMarker(lat, lng) {
    if (!schoolMiniMapInstance) return;
    if (schoolMiniMarker) { schoolMiniMapInstance.removeLayer(schoolMiniMarker); schoolMiniMarker = null; }
    if (lat == null || lng == null || lat === '' || lng === '' || isNaN(lat) || isNaN(lng)) return;
    schoolMiniMarker = L.marker([Number(lat), Number(lng)]).addTo(schoolMiniMapInstance);
    schoolMiniMapInstance.setView([Number(lat), Number(lng)], 15);
}
</script>

