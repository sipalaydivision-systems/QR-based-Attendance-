<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#064f3d">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="EduTrack Guardian">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="format-detection" content="telephone=no">
    <meta name="description" content="EduTrack Guardian — install the official Schools Division of Sipalay City Guardian app for real-time child attendance alerts.">
    <title>EduTrack Guardian App</title>
    <link rel="manifest" href="/parent-manifest.webmanifest">
    <link rel="icon" type="image/png" href="/uploads/logos/system-logo.png">
    <link rel="apple-touch-icon" href="/uploads/logos/system-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --green: #16a34a;
            --green-bright: #35d27f;
            --green-deep: #064f3d;
            --orange: #ff6b18;
            --ink: #071711;
            --muted: #d7fbed;
            --line: rgba(255,255,255,0.18);
            --glass: rgba(255,255,255,0.12);
            --safe-top: env(safe-area-inset-top, 0);
            --safe-bottom: env(safe-area-inset-bottom, 0);
            --safe-left: env(safe-area-inset-left, 0);
            --safe-right: env(safe-area-inset-right, 0);
            --sticky-h: 88px;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100svh;
            font-family: Inter, "Segoe UI", Tahoma, sans-serif;
            color: #fff;
            background:
                radial-gradient(circle at 12% 10%, rgba(69,255,180,.20), transparent 320px),
                radial-gradient(circle at 92% 6%, rgba(255,126,36,.22), transparent 320px),
                linear-gradient(160deg, #05261d 0%, #076548 55%, #06a36f 100%);
            background-attachment: fixed;
            -webkit-text-size-adjust: 100%;
            text-rendering: optimizeLegibility;
            overflow-x: hidden;
            /* Leave room for the sticky CTA on small screens */
            padding-bottom: calc(var(--sticky-h) + var(--safe-bottom) + 12px);
        }
        a { color: inherit; }

        /* ---------- Layout ---------- */
        .wrap {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1120px;
            margin: 0 auto;
            padding-left: max(16px, var(--safe-left));
            padding-right: max(16px, var(--safe-right));
        }

        /* ---------- Brand bar ---------- */
        .brand-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-top: calc(14px + var(--safe-top));
            padding-bottom: 14px;
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            text-decoration: none;
            min-width: 0;
        }
        .brand img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: contain;
            background: #fff;
            padding: 2px;
            box-shadow: 0 8px 20px rgba(0,0,0,.2);
            flex: 0 0 auto;
        }
        .brand strong { display: block; font-size: 15px; line-height: 1.1; font-weight: 900; }
        .brand-sub { display: block; margin-top: 2px; font-size: 11px; color: rgba(255,255,255,.78); }
        .top-link {
            display: none; /* hidden on mobile; shown on desktop */
            align-items: center;
            gap: 8px;
            color: #eafff7;
            text-decoration: none;
            font-weight: 800;
            font-size: 13px;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.16);
        }

        /* ---------- Hero ---------- */
        .hero {
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding: 8px 0 32px;
        }
        .hero-copy { width: 100%; }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            border-radius: 999px;
            background: var(--glass);
            border: 1px solid var(--line);
            font-weight: 800;
            font-size: 12px;
            letter-spacing: .02em;
            margin-bottom: 16px;
        }
        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ff4d4d;
            box-shadow: 0 0 0 5px rgba(255,77,77,.18);
            flex: 0 0 auto;
        }
        h1 {
            font-size: clamp(30px, 8.5vw, 44px);
            line-height: 1.05;
            letter-spacing: -.03em;
            margin: 0 0 14px;
            font-weight: 900;
        }
        .lead {
            display: grid;
            gap: 10px;
            font-size: 15px;
            line-height: 1.55;
            color: rgba(255,255,255,.92);
            margin: 0 0 22px;
        }

        /* ---------- Download CTA (inline) ---------- */
        .download-row {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 0;
        }
        .store-button {
            min-height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 0 22px;
            border-radius: 16px;
            background: #0c1512;
            color: #fff;
            text-decoration: none;
            font-weight: 900;
            font-size: 15px;
            box-shadow: 0 14px 30px rgba(6, 79, 61, .22);
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
            width: 100%;
            text-align: center;
        }
        .store-button.secondary { background: #fff; color: var(--green-deep); }
        .store-button.disabled { pointer-events: none; background: #80968e; color: #eef7f3; box-shadow: none; }
        .store-button:active { transform: translateY(1px); }
        .platform-mark { width: 24px; height: 24px; display: inline-flex; }
        .platform-mark svg { width: 100%; height: 100%; fill: currentColor; display: block; }

        /* ---------- Install panel ---------- */
        .install-panel {
            margin-top: 18px;
            padding: 16px;
            border-radius: 22px;
            border: 1px solid rgba(255,255,255,.16);
            background: linear-gradient(135deg, rgba(2, 48, 35, .78), rgba(8, 116, 80, .56));
            box-shadow: 0 18px 40px rgba(0,0,0,.16);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }
        .feature-row {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
            margin: 0 0 12px;
            padding: 0;
            list-style: none;
        }
        .feature-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 14px;
            background: rgba(255,255,255,.09);
            border: 1px solid rgba(255,255,255,.14);
            font-size: 13px;
            font-weight: 700;
            color: #eafff7;
        }
        .feature-pill i { color: #9dffd2; width: 18px; text-align: center; }
        .status {
            color: <%= parentApkAvailable ? "#dbfff0" : "#ffe1e1" %>;
            font-size: 13px;
            line-height: 1.5;
            font-weight: 600;
            margin: 0;
        }
        .version-note {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px dashed rgba(255,255,255,.18);
            color: #dffaf0;
            font-size: 12px;
            line-height: 1.5;
            font-weight: 600;
        }
        .version-note strong { font-weight: 900; color: #fff; }

        /* ---------- Phone mockup (hidden on mobile, shown on desktop) ---------- */
        .phone-shell { display: none; }

        /* ---------- Sticky bottom CTA (mobile only) ---------- */
        .sticky-cta {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 10px max(16px, var(--safe-left)) calc(10px + var(--safe-bottom)) max(16px, var(--safe-right));
            background: linear-gradient(180deg, rgba(5,32,24,0) 0%, rgba(5,32,24,.92) 32%, rgba(5,32,24,.98) 100%);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            z-index: 10;
            border-top: 1px solid rgba(255,255,255,.08);
        }
        .sticky-cta .store-button { box-shadow: 0 10px 24px rgba(0,0,0,.32); }

        /* ---------- PWA install hint ---------- */
        .pwa-hint {
            display: none;
            margin-top: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            background: rgba(255,255,255,.1);
            border: 1px dashed rgba(255,255,255,.22);
            font-size: 12px;
            line-height: 1.5;
            color: #eafff7;
        }
        .pwa-hint.show { display: block; }
        .pwa-hint button {
            margin-top: 8px;
            background: #fff;
            color: var(--green-deep);
            border: 0;
            padding: 9px 14px;
            border-radius: 10px;
            font-weight: 900;
            font-size: 12px;
            cursor: pointer;
        }

        /* ============================================================
           DESKTOP / TABLET ENHANCEMENTS
           ============================================================ */
        @media (min-width: 720px) {
            body { padding-bottom: max(40px, var(--safe-bottom)); }
            .top-link { display: inline-flex; }
            .sticky-cta { display: none; }
            .hero { padding: 24px 0 56px; gap: 36px; }
            .download-row { flex-direction: row; flex-wrap: wrap; }
            .store-button { width: auto; min-width: 240px; border-radius: 999px; }
            .feature-row { grid-template-columns: 1fr 1fr; }
            h1 { font-size: clamp(36px, 5.5vw, 52px); }
            .lead { font-size: 16px; }
        }

        @media (min-width: 1024px) {
            .hero {
                display: grid;
                grid-template-columns: minmax(0, 1.05fr) minmax(280px, .9fr);
                gap: clamp(36px, 5vw, 72px);
                align-items: center;
                padding: 32px 0 80px;
            }
            .hero-copy { padding-top: 8px; }
            h1 { font-size: clamp(44px, 4.6vw, 60px); letter-spacing: -.04em; }
            .feature-row { grid-template-columns: repeat(3, 1fr); }

            /* Phone mockup */
            .phone-shell {
                display: block;
                width: min(320px, 100%);
                margin: 0 auto;
                padding: 9px;
                border-radius: 42px;
                background: linear-gradient(145deg, var(--orange), #e85d0e 42%, #3b1708);
                box-shadow: 0 38px 90px rgba(0,0,0,.32), inset 0 0 0 5px rgba(14,11,8,.88);
                position: relative;
            }
            .phone-shell::before {
                content: "";
                position: absolute;
                top: 16px; left: 50%;
                width: 88px; height: 22px;
                border-radius: 999px;
                background: #0c1512;
                transform: translateX(-50%);
                z-index: 4;
            }
            .phone-screen {
                min-height: 568px;
                border: 2px solid #17110c;
                border-radius: 33px;
                overflow: hidden;
                background: #f3faf7;
                color: var(--ink);
            }
            .phone-header { padding: 42px 14px 13px; background: #fff; border-bottom: 1px solid #e1eee8; }
            .phone-brand { display: flex; align-items: center; gap: 10px; }
            .phone-brand img { width: 36px; height: 36px; border-radius: 50%; background: #fff; padding: 2px; }
            .phone-title { font-size: 14px; font-weight: 900; }
            .phone-subtitle { font-size: 10px; color: #667a72; margin-top: 1px; }
            .phone-chip-row { display: flex; gap: 7px; margin-top: 12px; flex-wrap: wrap; }
            .phone-chip {
                display: inline-flex; align-items: center; gap: 5px;
                padding: 5px 9px; border-radius: 999px;
                font-size: 9px; font-weight: 900;
                background: #ecfdf5; color: #047857;
            }
            .phone-body { padding: 12px; display: grid; gap: 10px; }
            .greeting-card,
            .analytics-card,
            .notification-card {
                border-radius: 20px;
                background: #fff;
                border: 1px solid #dcebe4;
                box-shadow: 0 12px 26px rgba(16,35,28,.10);
                padding: 13px;
            }
            .greeting-card small { color: #62756d; font-weight: 800; font-size: 10px; }
            .greeting-card h3 { margin: 4px 0 6px; font-size: 22px; line-height: 1; }
            .student-row {
                display: grid; grid-template-columns: 40px 1fr auto;
                align-items: center; gap: 10px; margin-top: 12px;
                border: 1px solid #dcebe4; border-radius: 15px;
                padding: 9px; background: #f8fcfa;
            }
            .avatar {
                width: 40px; height: 40px; border-radius: 50%;
                display: grid; place-items: center;
                background: #dcfce7; color: #047857; font-weight: 900;
            }
            .student-row strong { display: block; font-size: 12px; }
            .student-row span { display: block; font-size: 9px; color: #62756d; margin-top: 2px; }
            .pill { border-radius: 999px; padding: 5px 8px; font-size: 9px; font-weight: 900; background: #dcfce7; color: #047857; }
            .analytics-card { display: grid; grid-template-columns: 78px 1fr; gap: 12px; align-items: center; }
            .ring {
                width: 74px; height: 74px; border-radius: 50%;
                display: grid; place-items: center;
                background: conic-gradient(var(--green) 0 86%, #eaf3ef 86% 100%);
            }
            .ring span {
                width: 52px; height: 52px; border-radius: 50%;
                background: #fff; display: grid; place-items: center;
                font-size: 15px; font-weight: 900; color: #064f3d;
            }
            .analytics-copy strong { display: block; font-size: 13px; }
            .analytics-copy span { display: block; margin-top: 4px; font-size: 10px; color: #63756e; font-weight: 700; }
            .notification-card { display: grid; grid-template-columns: 42px 1fr auto; gap: 10px; align-items: center; }
            .notif-icon {
                width: 42px; height: 42px; border-radius: 50%;
                display: grid; place-items: center;
                background: #fff3e9; color: #ff5b12; font-size: 18px;
            }
            .notification-card strong { display: block; font-size: 12px; }
            .notification-card span { display: block; font-size: 9px; color: #63756e; margin-top: 2px; font-weight: 700; }
            .notification-card small { color: #8a9b94; font-size: 9px; font-weight: 800; }
            .phone-nav {
                display: grid; grid-template-columns: repeat(5, 1fr);
                gap: 3px; padding: 10px 11px;
                background: #fff; border-top: 1px solid #e2ece7;
            }
            .phone-nav div { text-align: center; font-size: 8px; color: #62756d; font-weight: 800; }
            .phone-nav i { display: block; font-size: 15px; margin-bottom: 3px; color: #06996b; }
        }

        /* PWA standalone: no header link */
        @media (display-mode: standalone) {
            .top-link { display: none; }
            body { padding-bottom: max(20px, var(--safe-bottom)); }
            .sticky-cta { display: none; }
        }

        /* Reduce motion */
        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; }
        }
    </style>
</head>
<body>
    <% const platformSvg = '<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M7.5 7.7 6 5.1a.75.75 0 0 1 1.3-.75L8.9 7a8.1 8.1 0 0 1 6.2 0l1.6-2.65a.75.75 0 1 1 1.3.75l-1.5 2.6A6.9 6.9 0 0 1 19 13v.6H5V13c0-2.2.95-4.1 2.5-5.3ZM8.4 11a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm7.2 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8ZM5 15h14v4.1c0 .7-.55 1.25-1.25 1.25H6.25C5.55 20.35 5 19.8 5 19.1V15Z"/></svg>'; %>
    <div class="wrap">
        <header class="brand-bar">
            <a class="brand" href="/Download-app">
                <img src="<%= branding.system_logo || '/uploads/logos/system-logo.png' %>" alt="EduTrack logo">
                <span>
                    <strong><%= branding.system_name || 'EduTrack' %> Guardian</strong>
                    <span class="brand-sub"><%= branding.division_name || 'Schools Division of Sipalay City' %></span>
                </span>
            </a>
            <a class="top-link" href="/mobile-app"><i class="fa-solid fa-table-cells-large"></i> View EduTrack apps</a>
        </header>

        <section class="hero">
            <div class="hero-copy">
                <div class="eyebrow"><span class="live-dot"></span> EduTrack Guardian App</div>
                <h1>Real-time attendance alerts for your child</h1>
                <div class="lead">
                    <span>Get instant Guardian alerts for time in, late arrival, lunch out, PM time in, early out, completed attendance, absences, holidays, and announcements.</span>
                    <span>Guardians only see children linked to their registered contact number — using the same secure EduTrack system.</span>
                </div>

                <div class="download-row">
                    <a class="store-button <%= parentApkAvailable ? '' : 'disabled' %>" href="/download/parent-app" download>
                        <span class="platform-mark" aria-hidden="true"><%- platformSvg %></span>
                        Download Guardian APK<% if (typeof latestVersion !== 'undefined' && latestVersion) { %> · v<%= latestVersion %><% } %>
                    </a>
                    <a class="store-button secondary" href="/parent/app">
                        <i class="fa-solid fa-mobile-screen"></i>
                        Open Guardian Portal
                    </a>
                </div>

                <div id="pwa-hint" class="pwa-hint">
                    <strong>Install as an app:</strong> add EduTrack Guardian to your home screen for instant, full-screen access.
                    <br><button id="pwa-install-btn" type="button"><i class="fa-solid fa-download"></i> Add to Home Screen</button>
                </div>

                <div class="install-panel">
                    <ul class="feature-row" aria-label="Guardian app features">
                        <li class="feature-pill"><i class="fa-solid fa-bell"></i> Real-time push alerts</li>
                        <li class="feature-pill"><i class="fa-solid fa-child"></i> Linked child records</li>
                        <li class="feature-pill"><i class="fa-solid fa-phone"></i> Adviser contacts</li>
                    </ul>

                    <p class="status">
                        <% if (missing || !parentApkAvailable) { %>
                            The Guardian APK is being prepared. You can open the Guardian Portal now and install the APK once available.
                        <% } else { %>
                            The Android Guardian installer is ready for secure, real-time attendance notifications.
                        <% } %>
                    </p>

                    <% if (typeof latestVersion !== 'undefined' && latestVersion) { %>
                    <p class="version-note">
                        Latest version: <strong>v<%= latestVersion %></strong> (build <%= latestVersionCode %>).
                        For a clean update, uninstall the old EduTrack Guardian app first, then install this download.
                        After installing, open <strong>Profile</strong> — it should show v<%= latestVersion %>.
                    </p>
                    <% } %>
                </div>
            </div>

            <div class="phone-shell" aria-hidden="true">
                <div class="phone-screen">
                    <div class="phone-header">
                        <div class="phone-brand">
                            <img src="<%= branding.system_logo || '/uploads/logos/system-logo.png' %>" alt="">
                            <div>
                                <div class="phone-title">EduTrack Guardian</div>
                                <div class="phone-subtitle">Real-time child attendance alerts</div>
                            </div>
                        </div>
                        <div class="phone-chip-row">
                            <span class="phone-chip"><i class="live-dot"></i> LIVE</span>
                            <span class="phone-chip">Guardian secure</span>
                        </div>
                    </div>

                    <div class="phone-body">
                        <div class="greeting-card">
                            <small>Good afternoon</small>
                            <h3>Guardian</h3>
                            <small>Monitor your children live</small>
                            <div class="student-row">
                                <div class="avatar">JD</div>
                                <div><strong>Juan Dela Cruz</strong><span>Grade 5 - Banana</span></div>
                                <div class="pill">Inside</div>
                            </div>
                        </div>

                        <div class="analytics-card">
                            <div class="ring"><span>96%</span></div>
                            <div class="analytics-copy">
                                <strong>Attendance Overview</strong>
                                <span>Instant updates from scan records</span>
                                <span>Late, PM time in, completed, and absence alerts</span>
                            </div>
                        </div>

                        <div class="notification-card">
                            <div class="notif-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                            <div>
                                <strong>Student Late</strong>
                                <span>Your child arrived late at 8:05 AM.</span>
                            </div>
                            <small>now</small>
                        </div>

                        <div class="phone-nav">
                            <div><i class="fa-solid fa-house"></i>Home</div>
                            <div><i class="fa-solid fa-clipboard-check"></i>Attendance</div>
                            <div><i class="fa-solid fa-bell"></i>Alerts</div>
                            <div><i class="fa-solid fa-phone"></i>Adviser</div>
                            <div><i class="fa-solid fa-user"></i>Profile</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Sticky mobile CTA so the Download button is always reachable -->
    <div class="sticky-cta" role="region" aria-label="Download Guardian APK">
        <a class="store-button <%= parentApkAvailable ? '' : 'disabled' %>" href="/download/parent-app" download>
            <span class="platform-mark" aria-hidden="true"><%- platformSvg %></span>
            Download Guardian APK<% if (typeof latestVersion !== 'undefined' && latestVersion) { %> · v<%= latestVersion %><% } %>
        </a>
    </div>

    <script>
        (function () {
            // Mark PWA mode for CSS targeting
            var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
            if (standalone) document.documentElement.classList.add('is-pwa');

            // Register service worker
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/sw.js').catch(function () {});
                });
            }

            // beforeinstallprompt — show "Add to Home Screen" button when the
            // browser says install is available (Chrome/Edge on Android).
            var deferredPrompt = null;
            var hint = document.getElementById('pwa-hint');
            var btn = document.getElementById('pwa-install-btn');
            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();
                deferredPrompt = e;
                if (hint && !standalone) hint.classList.add('show');
            });
            if (btn) {
                btn.addEventListener('click', function () {
                    if (!deferredPrompt) return;
                    deferredPrompt.prompt();
                    deferredPrompt.userChoice.finally(function () {
                        deferredPrompt = null;
                        if (hint) hint.classList.remove('show');
                    });
                });
            }
            window.addEventListener('appinstalled', function () {
                if (hint) hint.classList.remove('show');
            });
        })();
    </script>
</body>
</html>
