<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#064f3d">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="EduTrack Guardian">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="format-detection" content="telephone=no">
    <title>EduTrack Guardian App</title>
    <link rel="manifest" href="/parent-manifest.webmanifest">
    <link rel="icon" type="image/png" href="/uploads/logos/system-logo.png">
    <link rel="apple-touch-icon" href="/uploads/logos/system-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --green: #16a34a;
            --green-bright: #35d27f;
            --green-deep: #064f3d;
            --orange: #ff6b18;
            --ink: #071711;
            --muted: #d7fbed;
            --line: rgba(255,255,255,0.18);
            --glass: rgba(255,255,255,0.12);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100svh;
            font-family: Inter, "Segoe UI", Tahoma, sans-serif;
            color: #fff;
            background:
                radial-gradient(circle at 8% 16%, rgba(69,255,180,.22), transparent 280px),
                radial-gradient(circle at 94% 8%, rgba(255,126,36,.28), transparent 310px),
                linear-gradient(135deg, #05261d 0%, #076548 50%, #06a36f 100%);
            overflow-x: clip;
            padding-bottom: env(safe-area-inset-bottom, 0);
            -webkit-text-size-adjust: 100%;
            text-rendering: optimizeLegibility;
        }
        body::before,
        body::after {
            content: "";
            position: fixed;
            pointer-events: none;
            z-index: 0;
        }
        body::before {
            width: 520px;
            height: 520px;
            border-radius: 50%;
            right: -180px;
            top: -160px;
            background: radial-gradient(circle, rgba(255,255,255,.22), rgba(255,255,255,0) 64%);
        }
        body::after {
            display: none;
        }
        .wrap {
            position: relative;
            z-index: 2;
            width: min(1120px, calc(100% - 40px));
            margin: 0 auto;
        }
        .brand-bar {
            min-height: 84px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding-top: env(safe-area-inset-top, 0);
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: #fff;
            text-decoration: none;
        }
        .brand img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: contain;
            background: #fff;
            padding: 3px;
            box-shadow: 0 14px 34px rgba(0,0,0,.2);
        }
        .brand strong { display: block; font-size: 18px; line-height: 1.05; }
        .brand span span { display: block; margin-top: 4px; font-size: 12px; color: rgba(255,255,255,.78); }
        .top-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #eafff7;
            text-decoration: none;
            font-weight: 800;
            font-size: 13px;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.16);
        }
        .hero {
            display: grid;
            grid-template-columns: minmax(280px, .88fr) minmax(0, 1.12fr);
            gap: clamp(32px, 5vw, 74px);
            align-items: start;
            padding: 8px 0 max(44px, calc(28px + env(safe-area-inset-bottom, 0)));
        }
        .phone-shell {
            width: min(318px, 92vw);
            margin: 0 auto;
            padding: 9px;
            border-radius: 42px;
            background: linear-gradient(145deg, var(--orange), #e85d0e 42%, #3b1708);
            box-shadow: 0 38px 98px rgba(0,0,0,.34), inset 0 0 0 5px rgba(14,11,8,.88);
            position: relative;
        }
        .phone-shell::before {
            content: "";
            position: absolute;
            top: 16px;
            left: 50%;
            width: 88px;
            height: 22px;
            border-radius: 999px;
            background: #0c1512;
            transform: translateX(-50%);
            z-index: 4;
        }
        .phone-screen {
            min-height: 578px;
            border: 2px solid #17110c;
            border-radius: 33px;
            overflow: hidden;
            background: #f3faf7;
            color: var(--ink);
        }
        .phone-header {
            padding: 42px 14px 13px;
            background: rgba(255,255,255,.97);
            border-bottom: 1px solid #e1eee8;
        }
        .phone-brand { display: flex; align-items: center; gap: 10px; }
        .phone-brand img { width: 36px; height: 36px; border-radius: 50%; background: #fff; padding: 2px; }
        .phone-title { font-size: 14px; font-weight: 900; }
        .phone-subtitle { font-size: 9px; color: #667a72; margin-top: 1px; }
        .phone-chip-row { display: flex; gap: 7px; margin-top: 13px; flex-wrap: wrap; }
        .phone-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 9px;
            font-weight: 900;
            background: #ecfdf5;
            color: #047857;
        }
        .live-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #ff4d4d;
            box-shadow: 0 0 0 7px rgba(255,77,77,.12);
        }
        .phone-body { padding: 12px; display: grid; gap: 10px; }
        .greeting-card,
        .analytics-card,
        .notification-card {
            border-radius: 23px;
            background: #fff;
            border: 1px solid #dcebe4;
            box-shadow: 0 14px 30px rgba(16,35,28,.12);
            padding: 13px;
        }
        .greeting-card small { color: #62756d; font-weight: 800; }
        .greeting-card h3 { margin: 5px 0 6px; font-size: 24px; line-height: 1; }
        .student-row {
            display: grid;
            grid-template-columns: 40px 1fr auto;
            align-items: center;
            gap: 10px;
            margin-top: 14px;
            border: 1px solid #dcebe4;
            border-radius: 17px;
            padding: 10px;
            background: #f8fcfa;
        }
        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #dcfce7;
            color: #047857;
            font-weight: 900;
        }
        .student-row strong { display: block; font-size: 12px; }
        .student-row span { display: block; font-size: 9px; color: #62756d; margin-top: 2px; }
        .pill { border-radius: 999px; padding: 5px 8px; font-size: 9px; font-weight: 900; background: #dcfce7; color: #047857; }
        .analytics-card {
            display: grid;
            grid-template-columns: 82px 1fr;
            gap: 13px;
            align-items: center;
        }
        .ring {
            width: 78px;
            height: 78px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: conic-gradient(var(--green) 0 86%, #eaf3ef 86% 100%);
        }
        .ring span {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #fff;
            display: grid;
            place-items: center;
            font-size: 16px;
            font-weight: 900;
            color: #064f3d;
        }
        .analytics-copy strong { display: block; font-size: 13px; }
        .analytics-copy span { display: block; margin-top: 5px; font-size: 10px; color: #63756e; font-weight: 700; }
        .notification-card {
            display: grid;
            grid-template-columns: 42px 1fr auto;
            gap: 10px;
            align-items: center;
        }
        .notif-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #fff3e9;
            color: #ff5b12;
            font-size: 18px;
        }
        .notification-card strong { display: block; font-size: 12px; }
        .notification-card span { display: block; font-size: 9px; color: #63756e; margin-top: 3px; font-weight: 700; }
        .notification-card small { color: #8a9b94; font-size: 9px; font-weight: 800; }
        .phone-nav {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 3px;
            padding: 10px 11px;
            background: #fff;
            border-top: 1px solid #e2ece7;
        }
        .phone-nav div { text-align: center; font-size: 8px; color: #62756d; font-weight: 800; }
        .phone-nav i { display: block; font-size: 15px; margin-bottom: 3px; color: #06996b; }
        .hero-copy { max-width: 650px; padding-top: 18px; }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 9px 14px;
            border-radius: 999px;
            background: var(--glass);
            border: 1px solid var(--line);
            font-weight: 900;
            margin-bottom: 20px;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.05);
        }
        h1 {
            font-size: clamp(42px, 5.4vw, 64px);
            line-height: .96;
            letter-spacing: -.055em;
            margin: 0 0 18px;
        }
        .lead {
            display: grid;
            gap: 8px;
            font-size: 16px;
            line-height: 1.52;
            color: rgba(255,255,255,.9);
            margin: 0;
        }
        .download-row {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 24px;
        }
        .store-button {
            min-height: 58px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 0 26px;
            border-radius: 999px;
            background: #0c1512;
            color: #fff;
            text-decoration: none;
            font-weight: 900;
            box-shadow: 0 18px 38px rgba(6, 79, 61, .26);
            transition: transform .18s ease, box-shadow .18s ease;
        }
        .store-button.secondary { background: #fff; color: var(--green-deep); }
        .store-button.disabled { pointer-events: none; background: #80968e; color: #eef7f3; }
        .store-button:hover { transform: translateY(-2px); box-shadow: 0 24px 48px rgba(6, 79, 61, .32); }
        .platform-mark { width: 28px; height: 28px; color: currentColor; display: inline-flex; }
        .platform-mark svg { width: 100%; height: 100%; fill: currentColor; display: block; }
        .install-panel {
            margin-top: 18px;
            max-width: 620px;
            padding: 14px;
            border-radius: 26px;
            border: 1px solid rgba(255,255,255,.18);
            background:
                linear-gradient(135deg, rgba(2, 48, 35, .78), rgba(8, 116, 80, .66));
            box-shadow: 0 22px 50px rgba(0,0,0,.18), inset 0 0 0 1px rgba(255,255,255,.06);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .status {
            margin-top: 12px;
            max-width: 620px;
            color: <%= parentApkAvailable ? "#dbfff0" : "#ffe1e1" %>;
            font-size: 13px;
            line-height: 1.42;
            font-weight: 800;
            text-shadow: 0 1px 16px rgba(3, 88, 63, .42);
        }
        .version-note {
            margin-top: 12px;
            color: #dffaf0;
            font-size: 13px;
            line-height: 1.45;
            font-weight: 700;
        }
        .feature-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 0;
        }
        .feature-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,.11);
            border: 1px solid rgba(255,255,255,.16);
            font-size: 12px;
            font-weight: 900;
            color: #e9fff7;
        }
        @media (max-width: 880px) {
            .brand-bar { min-height: 82px; }
            .top-link { display: none; }
            .hero {
                grid-template-columns: 1fr;
                align-items: start;
                gap: 32px;
                padding: 12px 0 max(52px, calc(28px + env(safe-area-inset-bottom, 0)));
            }
            .hero-copy { text-align: center; margin: 0 auto; }
            .download-row, .feature-row { justify-content: center; }
            .install-panel { margin-left: auto; margin-right: auto; }
            .phone-shell { order: 2; }
        }
        @media (min-width: 881px) and (max-height: 820px) {
            .brand-bar { min-height: 76px; }
            .hero {
                gap: clamp(28px, 4vw, 60px);
                padding-top: 4px;
                padding-bottom: max(28px, calc(18px + env(safe-area-inset-bottom, 0)));
            }
            .phone-shell { width: min(292px, 92vw); }
            .phone-screen { min-height: 528px; }
            .phone-header { padding: 36px 12px 11px; }
            .phone-body { padding: 10px; gap: 8px; }
            .greeting-card,
            .analytics-card,
            .notification-card { padding: 11px; border-radius: 19px; }
            .greeting-card h3 { font-size: 21px; }
            .student-row { margin-top: 10px; padding: 8px; }
            .analytics-card { grid-template-columns: 70px 1fr; }
            .ring { width: 68px; height: 68px; }
            .ring span { width: 48px; height: 48px; font-size: 14px; }
            .phone-nav { padding: 8px 10px; }
            .hero-copy { padding-top: 10px; }
            .eyebrow { margin-bottom: 16px; padding: 8px 12px; }
            h1 { font-size: clamp(40px, 4.7vw, 58px); margin-bottom: 14px; }
            .lead { font-size: 15px; line-height: 1.42; gap: 7px; }
            .store-button { min-height: 54px; padding: 0 24px; }
            .download-row { margin-top: 20px; }
            .install-panel { margin-top: 14px; padding: 12px; border-radius: 22px; }
            .feature-row { gap: 8px; }
            .feature-pill { padding: 8px 10px; font-size: 11px; }
            .status, .version-note { margin-top: 10px; font-size: 12px; line-height: 1.38; }
        }
        @media (max-width: 520px) {
            .wrap { width: min(100% - 24px, 1120px); }
            .brand-bar { min-height: 76px; }
            .brand img { width: 42px; height: 42px; }
            .brand strong { font-size: 16px; }
            .brand span span { font-size: 11px; }
            .eyebrow { margin-bottom: 18px; }
            h1 { font-size: clamp(34px, 11vw, 40px); letter-spacing: -.045em; margin-bottom: 18px; }
            .lead { font-size: 15px; line-height: 1.55; }
            .download-row { margin-top: 24px; flex-direction: column; }
            .store-button {
                width: 100%;
                min-height: 56px;
                border-radius: 20px;
                padding: 0 18px;
                font-size: 14px;
                text-align: center;
            }
            .install-panel {
                border-radius: 22px;
                padding: 14px;
                text-align: left;
            }
            .feature-row { display: grid; grid-template-columns: 1fr; }
            .feature-pill { justify-content: flex-start; width: 100%; }
            .status, .version-note { font-size: 12px; text-align: left; }
            .phone-shell { width: min(318px, 100%); border-radius: 38px; }
            .phone-screen { min-height: 570px; border-radius: 30px; }
            .greeting-card h3 { font-size: 22px; }
            .analytics-card { grid-template-columns: 74px 1fr; }
            .ring { width: 70px; height: 70px; }
            .ring span { width: 50px; height: 50px; font-size: 14px; }
        }
        @media (display-mode: standalone) {
            .top-link { display: none; }
        }
    </style>
</head>
<body>
    <% const platformSvg = '<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M7.5 7.7 6 5.1a.75.75 0 0 1 1.3-.75L8.9 7a8.1 8.1 0 0 1 6.2 0l1.6-2.65a.75.75 0 1 1 1.3.75l-1.5 2.6A6.9 6.9 0 0 1 19 13v.6H5V13c0-2.2.95-4.1 2.5-5.3ZM8.4 11a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm7.2 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8ZM5 15h14v4.1c0 .7-.55 1.25-1.25 1.25H6.25C5.55 20.35 5 19.8 5 19.1V15Z"/></svg>'; %>
    <div class="wrap">
        <header class="brand-bar">
            <a class="brand" href="/Download-app">
                <img src="<%= branding.system_logo || '/uploads/logos/system-logo.png' %>" alt="EduTrack logo">
                <span>
                    <strong><%= branding.system_name || 'EduTrack' %> Guardian</strong>
                    <span><%= branding.division_name || 'Schools Division of Sipalay City' %></span>
                </span>
            </a>
            <a class="top-link" href="/mobile-app"><i class="fa-solid fa-table-cells-large"></i> View EduTrack apps</a>
        </header>

        <section class="hero">
            <div class="phone-shell" aria-label="EduTrack Guardian app preview">
                <div class="phone-screen">
                    <div class="phone-header">
                        <div class="phone-brand">
                            <img src="<%= branding.system_logo || '/uploads/logos/system-logo.png' %>" alt="">
                            <div>
                                <div class="phone-title">EduTrack Guardian</div>
                                <div class="phone-subtitle">Real-time child attendance alerts</div>
                            </div>
                        </div>
                        <div class="phone-chip-row">
                            <span class="phone-chip"><i class="live-dot"></i> LIVE</span>
                            <span class="phone-chip">Guardian secure</span>
                        </div>
                    </div>

                    <div class="phone-body">
                        <div class="greeting-card">
                            <small>Good afternoon</small>
                            <h3>Guardian</h3>
                            <small>Monitor your children live</small>
                            <div class="student-row">
                                <div class="avatar">JD</div>
                                <div><strong>Juan Dela Cruz</strong><span>Grade 5 - Banana</span></div>
                                <div class="pill">Inside</div>
                            </div>
                        </div>

                        <div class="analytics-card">
                            <div class="ring"><span>96%</span></div>
                            <div class="analytics-copy">
                                <strong>Attendance Overview</strong>
                                <span>Instant updates from scan records</span>
                                <span>Late, PM time in, completed, and absence alerts</span>
                            </div>
                        </div>

                        <div class="notification-card">
                            <div class="notif-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                            <div>
                                <strong>Student Late</strong>
                                <span>Your child arrived late at 8:05 AM.</span>
                            </div>
                            <small>now</small>
                        </div>

                        <div class="phone-nav">
                            <div><i class="fa-solid fa-house"></i>Home</div>
                            <div><i class="fa-solid fa-clipboard-check"></i>Attendance</div>
                            <div><i class="fa-solid fa-bell"></i>Alerts</div>
                            <div><i class="fa-solid fa-phone"></i>Adviser</div>
                            <div><i class="fa-solid fa-user"></i>Profile</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="hero-copy">
                <div class="eyebrow"><span class="live-dot"></span> EduTrack Guardian App</div>
                <h1>Monitor Your Child&apos;s Attendance in Real Time</h1>
                <p class="lead">
                    <span>Get instant Guardian alerts for time in, late arrival, lunch out, PM time in, early out, completed attendance, absences, holidays, and announcements.</span>
                    <span>Guardians can only view children linked to their registered guardian contact number, using the same secure EduTrack system.</span>
                </p>

                <div class="download-row">
                    <a class="store-button <%= parentApkAvailable ? '' : 'disabled' %>" href="/download/parent-app" download>
                        <span class="platform-mark" aria-hidden="true"><%- platformSvg %></span>
                        Download Guardian APK<% if (typeof latestVersion !== 'undefined' && latestVersion) { %> · v<%= latestVersion %><% } %>
                    </a>
                    <a class="store-button secondary" href="/parent/app">
                        <i class="fa-solid fa-mobile-screen"></i>
                        Open Guardian Portal
                    </a>
                </div>

                <div class="install-panel">
                    <div class="feature-row" aria-label="Guardian app features">
                        <span class="feature-pill"><i class="fa-solid fa-bell"></i> Real-time push alerts</span>
                        <span class="feature-pill"><i class="fa-solid fa-child"></i> Linked child records</span>
                        <span class="feature-pill"><i class="fa-solid fa-phone"></i> Adviser contacts</span>
                    </div>

                    <div class="status">
                        <% if (missing || !parentApkAvailable) { %>
                            The Guardian APK is being prepared. You can open the Guardian Portal now and install the APK once available.
                        <% } else { %>
                            The Android Guardian installer is ready for secure, real-time attendance notifications.
                        <% } %>
                    </div>

                    <% if (typeof latestVersion !== 'undefined' && latestVersion) { %>
                    <p class="version-note">
                        Latest version: <strong>v<%= latestVersion %></strong> (build <%= latestVersionCode %>).
                        For a clean update, uninstall the old EduTrack Guardian app first, then install this download.
                        After installing, open <strong>Profile</strong> — it should show v<%= latestVersion %>.
                    </p>
                    <% } %>
                </div>
            </div>
        </section>
    </div>
    <script>
        (function () {
            var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
            if (standalone) document.documentElement.classList.add('is-pwa');
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/sw.js').catch(function () {});
                });
            }
        })();
    </script>
</body>
</html>
