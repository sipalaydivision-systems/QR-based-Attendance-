<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0B7A55">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="EduTrack Guardian">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="format-detection" content="telephone=no">
    <meta name="description" content="EduTrack Guardian — install the official Schools Division of Sipalay City Guardian app for real-time child attendance alerts.">
    <title>EduTrack Guardian App</title>
    <link rel="manifest" href="/parent-manifest.webmanifest">
    <link rel="icon" type="image/png" href="/uploads/logos/system-logo.png">
    <link rel="apple-touch-icon" href="/uploads/logos/system-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --green: #0B7A55;
            --green-dark: #073B2B;
            --green-soft: #E7F5EF;
            --green-line: #C6E5D8;
            --bg: #F6F9F7;
            --card: #FFFFFF;
            --ink: #0F211B;
            --muted: #5B6B64;
            --line: #E3ECE7;
            --danger: #B4231F;
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --safe-left: env(safe-area-inset-left, 0px);
            --safe-right: env(safe-area-inset-right, 0px);
            --sticky-h: 84px;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100svh;
            font-family: Inter, "Segoe UI", Tahoma, sans-serif;
            background: var(--bg);
            color: var(--ink);
            -webkit-text-size-adjust: 100%;
            text-rendering: optimizeLegibility;
            overflow-x: hidden;
            padding-bottom: calc(var(--sticky-h) + var(--safe-bottom));
        }
        a { color: inherit; }
        .wrap {
            width: 100%;
            max-width: 560px;
            margin: 0 auto;
            padding-left: max(16px, var(--safe-left));
            padding-right: max(16px, var(--safe-right));
        }

        /* ---------- Green header band ---------- */
        .hero-band {
            background: linear-gradient(150deg, #073B2B 0%, #0B7A55 62%, #12A16F 100%);
            color: #fff;
            padding-top: calc(14px + var(--safe-top));
            padding-bottom: 68px;
            border-radius: 0 0 28px 28px;
        }
        .brand-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 20px;
        }
        .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; }
        .brand img {
            width: 36px; height: 36px; border-radius: 50%;
            object-fit: contain; background: #fff; padding: 2px;
            flex: 0 0 auto;
        }
        .brand strong { display: block; font-size: 14px; line-height: 1.15; font-weight: 900; }
        .brand-sub { display: block; margin-top: 1px; font-size: 10.5px; color: rgba(255,255,255,.75); }
        .top-link {
            flex: 0 0 auto;
            display: inline-flex; align-items: center; gap: 7px;
            color: #fff; text-decoration: none;
            font-weight: 800; font-size: 12px;
            padding: 9px 13px; border-radius: 999px;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.22);
            white-space: nowrap;
        }
        .hero-title { max-width: 420px; }
        .live-pill {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 12px; border-radius: 999px;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.24);
            font-weight: 800; font-size: 11.5px; letter-spacing: .02em;
            margin-bottom: 12px;
        }
        .live-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: #FF6B6B; box-shadow: 0 0 0 4px rgba(255,107,107,.25);
            flex: 0 0 auto;
        }
        h1 {
            margin: 0;
            font-size: clamp(24px, 6.6vw, 32px);
            line-height: 1.12;
            letter-spacing: -.02em;
            font-weight: 900;
        }
        .hero-sub {
            margin: 10px 0 0;
            font-size: 13.5px;
            line-height: 1.55;
            color: rgba(255,255,255,.86);
        }

        /* ---------- Store listing card (overlaps the band) ---------- */
        .store-card {
            margin-top: -52px;
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 22px;
            padding: 18px 16px;
            box-shadow: 0 18px 40px rgba(7, 59, 43, .10);
        }
        .listing { display: flex; align-items: center; gap: 14px; min-width: 0; }
        .app-icon {
            width: 68px; height: 68px; border-radius: 18px;
            background: var(--green-soft);
            border: 1px solid var(--green-line);
            display: grid; place-items: center;
            flex: 0 0 auto;
            overflow: hidden;
        }
        .app-icon img { width: 54px; height: 54px; object-fit: contain; }
        .listing-copy { min-width: 0; }
        .listing-copy h2 { margin: 0; font-size: 17px; font-weight: 900; letter-spacing: -.01em; }
        .listing-copy .dev { margin: 3px 0 0; font-size: 12px; color: var(--green); font-weight: 700; }
        .listing-copy .note { margin: 2px 0 0; font-size: 11px; color: var(--muted); }
        .meta-row {
            display: flex; align-items: stretch;
            margin: 16px 0 0;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            padding: 10px 0;
        }
        .meta-cell {
            flex: 1; text-align: center;
            display: grid; gap: 2px;
            border-right: 1px solid var(--line);
            padding: 2px 6px;
            min-width: 0;
        }
        .meta-cell:last-child { border-right: 0; }
        .meta-cell strong { font-size: 13px; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .meta-cell span { font-size: 10px; color: var(--muted); font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }

        .btn {
            min-height: 52px;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            padding: 0 20px; border-radius: 14px;
            text-decoration: none; font-weight: 900; font-size: 15px;
            width: 100%;
            transition: transform .12s ease, box-shadow .12s ease;
        }
        .btn:active { transform: translateY(1px); }
        .btn-install {
            background: var(--green); color: #fff;
            box-shadow: 0 12px 26px rgba(11, 122, 85, .30);
            margin-top: 16px;
        }
        .btn-install.disabled { pointer-events: none; background: #9DB3AA; box-shadow: none; }
        .btn-portal {
            margin-top: 10px;
            background: var(--card); color: var(--green-dark);
            border: 1.5px solid var(--green-line);
        }
        .btn i, .btn .mark { flex: 0 0 auto; }
        .mark { width: 22px; height: 22px; display: inline-flex; }
        .mark svg { width: 100%; height: 100%; fill: currentColor; display: block; }

        .status {
            margin: 12px 0 0;
            font-size: 12px; line-height: 1.55; font-weight: 600;
            color: <%= parentApkAvailable ? 'var(--muted)' : 'var(--danger)' %>;
            text-align: center;
        }

        /* ---------- PWA hint ---------- */
        .pwa-hint {
            display: none;
            margin-top: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            background: var(--green-soft);
            border: 1px dashed var(--green-line);
            font-size: 12px; line-height: 1.55; color: var(--green-dark);
        }
        .pwa-hint.show { display: block; }
        .pwa-hint button {
            margin-top: 9px;
            background: var(--green); color: #fff;
            border: 0; padding: 10px 16px; border-radius: 10px;
            font-weight: 900; font-size: 12px; cursor: pointer;
            font-family: inherit;
        }

        /* ---------- Sections ---------- */
        .section { margin-top: 22px; }
        .section h3 {
            margin: 0 0 10px;
            font-size: 15px; font-weight: 900; letter-spacing: -.01em;
        }
        .section .sub { margin: -6px 0 12px; font-size: 12px; color: var(--muted); line-height: 1.5; }

        .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .feature-card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 13px 12px;
            display: grid; gap: 8px;
            align-content: start;
        }
        .feature-card .fi {
            width: 36px; height: 36px; border-radius: 12px;
            display: grid; place-items: center;
            font-size: 15px;
        }
        .fi-green { background: var(--green-soft); color: var(--green); }
        .fi-blue { background: #E8F0FE; color: #1D4ED8; }
        .fi-amber { background: #FEF3E2; color: #B45309; }
        .fi-rose { background: #FDECEC; color: #B4231F; }
        .feature-card strong { font-size: 12.5px; font-weight: 800; line-height: 1.3; }
        .feature-card span { font-size: 11px; color: var(--muted); line-height: 1.45; }

        .steps { display: grid; gap: 8px; }
        .step {
            display: flex; gap: 12px; align-items: flex-start;
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 12px 13px;
        }
        .step-n {
            width: 26px; height: 26px; border-radius: 50%;
            background: var(--green); color: #fff;
            display: grid; place-items: center;
            font-size: 12px; font-weight: 900;
            flex: 0 0 auto; margin-top: 1px;
        }
        .step strong { display: block; font-size: 12.5px; font-weight: 800; }
        .step span { display: block; margin-top: 2px; font-size: 11.5px; color: var(--muted); line-height: 1.5; }

        .version-card {
            background: var(--green-soft);
            border: 1px solid var(--green-line);
            border-radius: 14px;
            padding: 12px 14px;
            font-size: 12px; line-height: 1.6; color: var(--green-dark);
        }
        .version-card strong { font-weight: 900; }

        footer {
            margin: 26px 0 12px;
            text-align: center;
            font-size: 11px; color: var(--muted);
            line-height: 1.6;
        }

        /* ---------- Sticky bottom CTA (mobile) ---------- */
        .sticky-cta {
            position: fixed;
            left: 0; right: 0; bottom: 0;
            padding: 10px max(16px, var(--safe-left)) calc(10px + var(--safe-bottom)) max(16px, var(--safe-right));
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-top: 1px solid var(--line);
            z-index: 10;
        }
        .sticky-cta .btn-install { margin-top: 0; min-height: 50px; }

        /* ---------- Wider screens ---------- */
        @media (min-width: 720px) {
            body { padding-bottom: 40px; }
            .sticky-cta { display: none; }
            .wrap { max-width: 640px; }
            .hero-band { border-radius: 0 0 36px 36px; padding-bottom: 84px; }
            h1 { font-size: 36px; }
            .store-card { padding: 24px 22px; margin-top: -60px; }
            .feature-grid { grid-template-columns: repeat(4, 1fr); }
        }

        /* Tiny phones: single-column features so nothing squeezes */
        @media (max-width: 330px) {
            .feature-grid { grid-template-columns: 1fr; }
            .top-link span { display: none; }
        }

        /* PWA standalone */
        @media (display-mode: standalone) {
            body { padding-bottom: max(20px, var(--safe-bottom)); }
            .sticky-cta, .top-link { display: none; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; }
            html { scroll-behavior: auto; }
        }
    </style>
</head>
<body>
    <% const platformSvg = '<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M7.5 7.7 6 5.1a.75.75 0 0 1 1.3-.75L8.9 7a8.1 8.1 0 0 1 6.2 0l1.6-2.65a.75.75 0 1 1 1.3.75l-1.5 2.6A6.9 6.9 0 0 1 19 13v.6H5V13c0-2.2.95-4.1 2.5-5.3ZM8.4 11a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm7.2 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8ZM5 15h14v4.1c0 .7-.55 1.25-1.25 1.25H6.25C5.55 20.35 5 19.8 5 19.1V15Z"/></svg>'; %>

    <div class="hero-band">
        <div class="wrap">
            <header class="brand-bar">
                <a class="brand" href="/Download-app">
                    <img src="<%= branding.system_logo || '/uploads/logos/system-logo.png' %>" alt="EduTrack logo">
                    <span>
                        <strong><%= branding.system_name || 'EduTrack' %> Guardian</strong>
                        <span class="brand-sub"><%= branding.division_name || 'Schools Division of Sipalay City' %></span>
                    </span>
                </a>
                <a class="top-link" href="/mobile-app"><i class="fa-solid fa-table-cells-large"></i> <span>All apps</span></a>
            </header>
            <div class="hero-title">
                <div class="live-pill"><span class="live-dot"></span> OFFICIAL GUARDIAN APP</div>
                <h1>Know your child arrived — the moment they scan.</h1>
                <p class="hero-sub">Real-time attendance alerts for parents and guardians, straight from your child's school scanner.</p>
            </div>
        </div>
    </div>

    <div class="wrap">
        <!-- Store-style listing card -->
        <section class="store-card" aria-label="EduTrack Guardian download">
            <div class="listing">
                <div class="app-icon">
                    <img src="<%= branding.system_logo || '/uploads/logos/system-logo.png' %>" alt="">
                </div>
                <div class="listing-copy">
                    <h2>EduTrack Guardian</h2>
                    <p class="dev"><%= branding.division_name || 'Schools Division of Sipalay City' %></p>
                    <p class="note">Attendance alerts for your linked children</p>
                </div>
            </div>

            <div class="meta-row" aria-label="App details">
                <div class="meta-cell">
                    <strong><%= (typeof latestVersion !== 'undefined' && latestVersion) ? 'v' + latestVersion : '—' %></strong>
                    <span>Version</span>
                </div>
                <div class="meta-cell">
                    <strong>Android</strong>
                    <span>Platform</span>
                </div>
                <div class="meta-cell">
                    <strong>Free</strong>
                    <span>Price</span>
                </div>
            </div>

            <a class="btn btn-install <%= parentApkAvailable ? '' : 'disabled' %>" href="/download/parent-app" download>
                <span class="mark" aria-hidden="true"><%- platformSvg %></span>
                Install Guardian APK
            </a>
            <a class="btn btn-portal" href="/parent/app">
                <i class="fa-solid fa-mobile-screen"></i>
                Open Guardian Portal
            </a>

            <p class="status">
                <% if (missing || !parentApkAvailable) { %>
                    The Guardian APK is being prepared. Use the Guardian Portal now and install the APK once it's ready.
                <% } else { %>
                    Official installer • Guardians only see children linked to their registered contact number.
                <% } %>
            </p>

            <div id="pwa-hint" class="pwa-hint">
                <strong>Prefer no download?</strong> Add EduTrack Guardian to your home screen for instant, full-screen access.
                <br><button id="pwa-install-btn" type="button"><i class="fa-solid fa-download"></i> Add to Home Screen</button>
            </div>
        </section>

        <!-- Features -->
        <section class="section" aria-label="Guardian app features">
            <h3>What you get</h3>
            <div class="feature-grid">
                <div class="feature-card">
                    <div class="fi fi-green"><i class="fa-solid fa-bell"></i></div>
                    <strong>Real-time alerts</strong>
                    <span>Time in, late, lunch out, PM time in, early out & completed.</span>
                </div>
                <div class="feature-card">
                    <div class="fi fi-blue"><i class="fa-solid fa-children"></i></div>
                    <strong>Linked children</strong>
                    <span>Every child under your registered contact number.</span>
                </div>
                <div class="feature-card">
                    <div class="fi fi-amber"><i class="fa-solid fa-phone"></i></div>
                    <strong>Adviser contact</strong>
                    <span>Call, text, or email your child's adviser in one tap.</span>
                </div>
                <div class="feature-card">
                    <div class="fi fi-rose"><i class="fa-solid fa-shield-halved"></i></div>
                    <strong>Absence warnings</strong>
                    <span>Get flagged early when absences become consecutive.</span>
                </div>
            </div>
        </section>

        <!-- Install steps -->
        <section class="section" aria-label="How to install">
            <h3>How to install</h3>
            <p class="sub">Takes about a minute on any Android phone.</p>
            <div class="steps">
                <div class="step">
                    <div class="step-n">1</div>
                    <div>
                        <strong>Tap “Install Guardian APK”</strong>
                        <span>The installer downloads straight to your phone.</span>
                    </div>
                </div>
                <div class="step">
                    <div class="step-n">2</div>
                    <div>
                        <strong>Allow the install when asked</strong>
                        <span>If prompted, allow “Install unknown apps” for your browser — this is Android's standard step for apps outside the Play Store.</span>
                    </div>
                </div>
                <div class="step">
                    <div class="step-n">3</div>
                    <div>
                        <strong>Open the app & sign in</strong>
                        <span>Log in with the contact number registered at your child's school.</span>
                    </div>
                </div>
            </div>
        </section>

        <% if (typeof latestVersion !== 'undefined' && latestVersion) { %>
        <section class="section" aria-label="Version information">
            <div class="version-card">
                Latest release: <strong>v<%= latestVersion %></strong> (build <%= latestVersionCode %>).
                Updating from an old version? Uninstall the previous EduTrack Guardian app first, then install this download.
                After installing, open <strong>Profile</strong> — it should show v<%= latestVersion %>.
            </div>
        </section>
        <% } %>

        <footer>
            <%= branding.system_name || 'EduTrack' %> Guardian • <%= branding.division_name || 'Schools Division of Sipalay City' %><br>
            Official school-issued app. No ads, no tracking — attendance only.
        </footer>
    </div>

    <!-- Sticky mobile CTA so the install button is always reachable -->
    <div class="sticky-cta" role="region" aria-label="Install Guardian APK">
        <a class="btn btn-install <%= parentApkAvailable ? '' : 'disabled' %>" href="/download/parent-app" download>
            <span class="mark" aria-hidden="true"><%- platformSvg %></span>
            Install Guardian APK<% if (typeof latestVersion !== 'undefined' && latestVersion) { %> · v<%= latestVersion %><% } %>
        </a>
    </div>

    <script>
        (function () {
            // Mark PWA mode for CSS targeting
            var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
            if (standalone) document.documentElement.classList.add('is-pwa');

            // Register service worker
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/sw.js').catch(function () {});
                });
            }

            // beforeinstallprompt — show "Add to Home Screen" when the browser
            // says install is available (Chrome/Edge on Android).
            var deferredPrompt = null;
            var hint = document.getElementById('pwa-hint');
            var btn = document.getElementById('pwa-install-btn');
            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();
                deferredPrompt = e;
                if (hint && !standalone) hint.classList.add('show');
            });
            if (btn) {
                btn.addEventListener('click', function () {
                    if (!deferredPrompt) return;
                    deferredPrompt.prompt();
                    deferredPrompt.userChoice.finally(function () {
                        deferredPrompt = null;
                        if (hint) hint.classList.remove('show');
                    });
                });
            }
            window.addEventListener('appinstalled', function () {
                if (hint) hint.classList.remove('show');
            });
        })();
    </script>
</body>
</html>
