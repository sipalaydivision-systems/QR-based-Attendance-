<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#16a34a">
    <title>Adviser Login - <%= (typeof settings !== 'undefined' && settings && settings.system_name) || 'EduTrack' %></title>
    <link rel="icon" type="image/png" href="/uploads/logos/system-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/style.css">
    <style>
    .adv-login-page {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #f0f9ff 100%);
        padding: 20px;
    }
    .adv-login-card {
        background: #fff; border-radius: 20px; box-shadow: 0 8px 40px rgba(0,0,0,0.08);
        width: 100%; max-width: 420px; padding: 40px 32px; text-align: center;
    }
    .adv-login-icon {
        width: 80px; height: 80px;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 16px; color: #16a34a; font-size: 2.5rem;
    }
    .adv-login-icon img { width: 80px; height: 80px; object-fit: contain; }
    .adv-login-card h1 { font-size: 1.375rem; font-weight: 800; color: var(--gray-900); margin: 0 0 4px; }
    .adv-login-card .subtitle { font-size: 0.8125rem; color: var(--gray-500); margin: 0 0 24px; }

    .adv-alert {
        border-radius: 10px; padding: 10px 14px; font-size: 0.8125rem;
        margin-bottom: 16px; display: flex; align-items: center; gap: 8px; text-align: left;
    }
    .adv-alert.error { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; }
    .adv-alert.success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; }

    .adv-form-group { margin-bottom: 16px; text-align: left; }
    .adv-form-group label {
        display: block; font-size: 0.75rem; font-weight: 700;
        color: var(--gray-600); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.04em;
    }
    .adv-form-group label i { margin-right: 4px; }
    .adv-form-group input {
        width: 100%; padding: 11px 14px; border: 1.5px solid var(--gray-300);
        border-radius: 10px; font-size: 0.875rem; font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;
    }
    .adv-form-group input::-ms-reveal,
    .adv-form-group input::-webkit-credentials-auto-fill-button { display: none; }
    .adv-form-group input:focus { outline: none; border-color: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,0.12); }
    .adv-form-group input:disabled { background: var(--gray-50); color: var(--gray-500); }
    .adv-pwd-wrap { position: relative; }
    .adv-pwd-wrap input { padding-right: 42px; }
    .adv-pwd-toggle {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        background: none; border: none; cursor: pointer; color: var(--gray-400); font-size: 0.875rem;
    }

    .adv-btn {
        width: 100%; padding: 12px; border: none; border-radius: 10px;
        font-size: 0.9375rem; font-weight: 700; cursor: pointer;
        font-family: inherit; display: flex; align-items: center;
        justify-content: center; gap: 8px; transition: all 0.2s; margin-top: 4px;
    }
    .adv-btn-primary { background: linear-gradient(135deg, #16a34a, #15803d); color: #fff; box-shadow: 0 2px 8px rgba(22,163,74,0.25); }
    .adv-btn-primary:hover { box-shadow: 0 4px 16px rgba(22,163,74,0.35); transform: translateY(-1px); }
    .adv-btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .adv-email-status {
        display: flex; align-items: center; gap: 6px; font-size: 0.75rem;
        margin-top: 5px; min-height: 18px;
    }
    .adv-email-status.checking { color: var(--gray-400); }
    .adv-email-status.found { color: #16a34a; }
    .adv-email-status.not-found { color: #dc2626; }

    #adv-password-section { display: none; }
    #adv-password-section.visible { display: block; animation: slideDown 0.2s ease; }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }

    .adv-footer { margin-top: 20px; font-size: 0.75rem; color: var(--gray-400); }
    .adv-footer a { color: var(--primary); text-decoration: none; font-weight: 600; }
    </style>
</head>
<body class="adv-login-page">
    <div class="adv-login-card">
        <div class="adv-login-icon">
            <% if (typeof settings !== 'undefined' && settings && settings.system_logo) { %>
            <img src="<%= settings.system_logo %>" alt="Logo" onerror="this.parentElement.innerHTML='<i class=\'fa-solid fa-chalkboard-user\'></i>'">
            <% } else { %>
            <i class="fa-solid fa-chalkboard-user"></i>
            <% } %>
        </div>
        <h1><%= (typeof settings !== 'undefined' && settings && settings.system_name) || 'EduTrack' %></h1>
        <p class="subtitle"><i class="fa-solid fa-chalkboard-user"></i> Adviser Portal</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="adv-alert error"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
        <% } %>

        <form method="POST" action="/adviser-login" id="advForm">
            <div class="adv-form-group">
                <label for="advEmail"><i class="fa-solid fa-envelope"></i> Email Address</label>
                <input type="email" id="advEmail" name="email" required autofocus
                       autocomplete="email" placeholder="Enter your registered email"
                       value="<%= typeof email !== 'undefined' ? email : '' %>">
                <div class="adv-email-status" id="advEmailStatus"></div>
            </div>

            <div id="adv-password-section">
                <div class="adv-form-group">
                    <label for="advPassword"><i class="fa-solid fa-lock"></i> Password</label>
                    <div class="adv-pwd-wrap">
                        <input type="password" id="advPassword" name="password"
                               autocomplete="current-password" placeholder="Enter your password">
                        <button type="button" class="adv-pwd-toggle" onclick="toggleAdvPwd()">
                            <i class="fa-regular fa-eye" id="advPwdIcon"></i>
                        </button>
                    </div>
                </div>
            </div>

            <button type="submit" class="adv-btn adv-btn-primary" id="advSubmitBtn">
                <i class="fa-solid fa-arrow-right" id="advBtnIcon"></i>
                <span id="advBtnText">Continue</span>
            </button>
        </form>

        <div class="adv-footer">
            <p><i class="fa-solid fa-shield-halved"></i> For registered teachers/advisers only</p>
        </div>
    </div>

    <script>
    var emailCheckTimer = null;
    var currentEmailState = 'empty'; // empty | checking | found | not-found

    function toggleAdvPwd() {
        var inp = document.getElementById('advPassword');
        var ico = document.getElementById('advPwdIcon');
        if (inp.type === 'password') { inp.type = 'text'; ico.className = 'fa-regular fa-eye-slash'; }
        else { inp.type = 'password'; ico.className = 'fa-regular fa-eye'; }
    }

    function setPasswordSection(visible) {
        var section = document.getElementById('adv-password-section');
        var pwdInput = document.getElementById('advPassword');
        if (visible) {
            section.classList.add('visible');
            pwdInput.required = true;
            document.getElementById('advBtnIcon').className = 'fa-solid fa-right-to-bracket';
            document.getElementById('advBtnText').textContent = 'Sign In';
        } else {
            section.classList.remove('visible');
            pwdInput.required = false;
            pwdInput.value = '';
            document.getElementById('advBtnIcon').className = 'fa-solid fa-arrow-right';
            document.getElementById('advBtnText').textContent = 'Continue';
        }
    }

    function setEmailStatus(state, message) {
        var el = document.getElementById('advEmailStatus');
        el.className = 'adv-email-status ' + state;
        el.innerHTML = message;
        currentEmailState = state;
    }

    async function checkEmail(email) {
        if (!email || !email.includes('@')) {
            setEmailStatus('empty', '');
            setPasswordSection(false);
            return;
        }
        setEmailStatus('checking', '<i class="fa-solid fa-spinner fa-spin"></i> Checking...');
        try {
            var res = await fetch('/adviser-check-email?email=' + encodeURIComponent(email));
            var data = await res.json();
            if (!data.exists) {
                setEmailStatus('not-found', '<i class="fa-solid fa-circle-xmark"></i> Email not found in teacher records');
                setPasswordSection(false);
            } else if (!data.hasPassword) {
                setEmailStatus('found', '<i class="fa-solid fa-circle-check"></i> Email found — you will set your password next');
                setPasswordSection(false);
            } else {
                setEmailStatus('found', '<i class="fa-solid fa-circle-check"></i> Email found — enter your password');
                setPasswordSection(true);
                setTimeout(function() { document.getElementById('advPassword').focus(); }, 50);
            }
            // store hasPassword for submit guard
            window._advHasPassword = data.hasPassword;
        } catch (e) {
            setEmailStatus('empty', '');
        }
    }

    document.getElementById('advEmail').addEventListener('input', function() {
        clearTimeout(emailCheckTimer);
        var val = this.value.trim();
        if (!val) { setEmailStatus('empty', ''); setPasswordSection(false); return; }
        emailCheckTimer = setTimeout(function() { checkEmail(val); }, 500);
    });

    document.getElementById('advForm').addEventListener('submit', function(e) {
        if (currentEmailState === 'not-found') { e.preventDefault(); return; }
    });

    // On page load, if email is pre-filled (after error), check it immediately
    (function() {
        var email = document.getElementById('advEmail').value.trim();
        if (email) checkEmail(email);
    })();
    </script>
</body>
</html>
