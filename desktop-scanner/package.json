{
  "name": "edutrack-desktop-scanner",
  "version": "1.0.0",
  "description": "Edutrack Scanner desktop attendance application",
  "main": "src/main.js",
  "author": "Schools Division of Sipalay City",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis",
    "copy:installer": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$src=(Get-ChildItem -Path dist -Filter 'Edutrack-Scanner-Setup-*.exe' | Sort-Object LastWriteTime -Descending | Select-Object -First 1); if (!$src) { throw 'Installer not found' }; New-Item -ItemType Directory -Force -Path ..\\public\\downloads | Out-Null; Copy-Item $src.FullName ..\\public\\downloads\\Edutrack-Scanner-Setup.exe -Force\""
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ph.gov.sipalay.edutrack.scanner",
    "productName": "Edutrack Scanner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/html5-qrcode/**/*",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/edutrack-scanner.ico",
      "artifactName": "Edutrack-Scanner-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Edutrack Scanner",
      "installerIcon": "src/assets/edutrack-scanner.ico",
      "uninstallerIcon": "src/assets/edutrack-scanner.ico",
      "installerHeaderIcon": "src/assets/edutrack-scanner.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "include": "build/installer.nsh"
    }
  }
}
