# Server
PORT=3000
NODE_ENV=development

# Database
# Local MySQL variables. On Railway, the app also supports MYSQLHOST,
# MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD, and MYSQLPORT directly.
DB_HOST=localhost
DB_NAME=qr_attendance
DB_USER=root
DB_PASS=
DB_PORT=3306

# Session
SESSION_SECRET=change-this-to-a-random-secret-key

# Base URL (used for QR codes and links)
BASE_URL=http://localhost:3000
